<Application x:Class="DiagnosticFlashTool.Product.EcuX.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Light"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Pin the Fluent accent palette to the EcuX product color. -->
        <Color x:Key="{x:Static SystemColors.AccentColorKey}">#1D5D8F</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorDark1Key}">#16496F</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorDark2Key}">#123C5B</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorLight1Key}">#4B7FA7</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorLight2Key}">#A9C2D5</Color>
        <Color x:Key="{x:Static SystemColors.AccentColorLight3Key}">#EAF1F6</Color>

        <SolidColorBrush x:Key="WindowBrush" Color="#F4F6F8" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE6" />
        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}" />
        <SolidColorBrush x:Key="PrimaryHoverBrush"
                         Color="{DynamicResource {x:Static SystemColors.AccentColorDark1Key}}" />
        <SolidColorBrush x:Key="TextBrush" Color="#263442" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#657487" />
        <SolidColorBrush x:Key="WarningBrush" Color="#A65B00" />
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF4DC" />
        <SolidColorBrush x:Key="LogBrush" Color="#14212B" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Margin" Value="4,3,0,3" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </Application.Resources>
</Application>
