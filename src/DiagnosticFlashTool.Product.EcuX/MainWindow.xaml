<Window x:Class="DiagnosticFlashTool.Product.EcuX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ECU-X 专用烧写工具"
        Width="1120"
        Height="760"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Closing="Window_Closing">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding ProductDisplayName}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="专用 ECU BOOT 刷写工具" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ProfileSummary}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="重新加载产品配置" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="通信设备" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding DeviceTypes}" SelectedItem="{Binding SelectedDeviceType, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConnectionSettings}" />
                <TextBlock Grid.Column="2" Text="设备索引" Style="{StaticResource FieldLabel}" Margin="16,0,8,0" />
                <TextBox Grid.Column="3" Text="{Binding DeviceIndexText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConnectionSettings}" />
                <TextBlock Grid.Column="4" Text="CAN 通道" Style="{StaticResource FieldLabel}" Margin="16,0,8,0" />
                <TextBox Grid.Column="5" Text="{Binding ChannelText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConnectionSettings}" />
                <TextBlock Grid.Column="6" Text="波特率" Style="{StaticResource FieldLabel}" Margin="16,0,8,0" />
                <TextBox Grid.Column="7" Text="{Binding BaudRateText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConnectionSettings}" />
                <TextBlock Grid.Column="8" Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="16,0,10,0" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="9" Content="连接" Command="{Binding ConnectCommand}" />
                <Button Grid.Column="10" Content="断开" Command="{Binding DisconnectCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="目标 ECU 通信参数">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="物理请求 ID" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PhysicalRequestId, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="功能请求 ID" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding FunctionalRequestId, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="响应 ID" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ResponseId, Mode=OneWay}" IsReadOnly="True" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="帧格式" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding FrameModeText, Mode=OneWay}" IsReadOnly="True" />
                            <Border Grid.Row="2" Grid.ColumnSpan="4" Background="{StaticResource WarningSoftBrush}" Padding="8,5" Margin="0,7,0,0">
                                <TextBlock Text="{Binding IntegrationNote}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" FontSize="12" />
                            </Border>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="刷写文件" IsEnabled="{Binding CanEditFlashSettings}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="120" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Driver 文件" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding DriverFilePath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="浏览" Command="{Binding BrowseDriverCommand}" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Application 文件" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Column="1" Text="可按顺序选择多个镜像" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="添加" Command="{Binding BrowseApplicationCommand}" />
                                <Button Grid.Column="3" Content="移除" Command="{Binding RemoveApplicationCommand}" />
                            </Grid>
                            <ListBox Grid.Row="2" ItemsSource="{Binding ApplicationFiles}" SelectedItem="{Binding SelectedApplicationPath, Mode=TwoWay}" Margin="0,6,0,4" />
                            <TextBlock Grid.Row="3" Text="文件路径只保存在用户设置，不会改写产品默认配置。" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="UDS 时间参数（毫秒）" IsEnabled="{Binding CanEditFlashSettings}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="P2 客户端" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding P2ClientMsText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="P2* 客户端" Style="{StaticResource FieldLabel}" Margin="16,0,10,0" />
                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding P2StarClientMsText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="S3 客户端" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding S3ClientMsText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Pending 总超时" Style="{StaticResource FieldLabel}" Margin="16,0,10,0" />
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding PendingOverallTimeoutMsText, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Seed&amp;Key 加密算法 DLL" IsEnabled="{Binding CanEditFlashSettings}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DLL 文件" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding SecurityDllPath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="浏览" Command="{Binding BrowseSecurityDllCommand}" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="算法名称" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding AlgorithmName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="导出函数" Style="{StaticResource FieldLabel}" Margin="16,0,10,0" />
                                <TextBox Grid.Column="3" Text="{Binding EntryPoint, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="调用约定" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding CallingConventions}" SelectedItem="{Binding CallingConvention}" />
                                <TextBlock Grid.Column="2" Text="安全等级" Style="{StaticResource FieldLabel}" Margin="16,0,10,0" />
                                <TextBox Grid.Column="3" Text="{Binding SecurityLevelText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Variant" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Variant, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Options" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding OptionsText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="180" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="刷写控制" FontWeight="SemiBold" FontSize="16" />
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" Height="9" Margin="0,14,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding CurrentStep}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0}%}" FontWeight="SemiBold" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="保存配置" Command="{Binding SaveSettingsCommand}" />
                            <Button Content="开始刷写" Command="{Binding StartFlashCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="取消" Command="{Binding CancelFlashCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="1" Text="执行步骤" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding FlashSteps}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="{StaticResource BorderBrush}"
                          Margin="0,0,0,14">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Id, Mode=OneWay}" Width="60" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Status, Mode=OneWay}" Width="80" />
                        <DataGridTextColumn Header="步骤" Binding="{Binding Name, Mode=OneWay}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="3" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="运行日志" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="导出" Command="{Binding ExportLogCommand}" />
                    <Button Grid.Column="2" Content="清空" Command="{Binding ClearLogCommand}" />
                </Grid>
                <ListBox x:Name="LogList" Grid.Row="4" ItemsSource="{Binding LogEntries}" Background="{StaticResource LogBrush}" Foreground="#D5E0E8" BorderThickness="0" Padding="10" />
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3" Text="产品默认配置由发布包管理；用户路径和时间参数保存在本机用户目录。" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,12,0,0" />
    </Grid>
</Window>
