<UserControl x:Class="DiagnosticFlashTool.App.Views.FlowConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="110" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="BOOT config" Margin="0,0,8,0" />
                    <ComboBox Width="180" ItemsSource="{Binding BootConfigFiles}" SelectedItem="{Binding SelectedBootConfig}" />
                    <Button Content="Load" Command="{Binding LoadFlowCommand}" Width="80" />
                    <Button Content="Validate" Command="{Binding ValidateFlowCommand}" Width="90" />
                    <Button Content="Save" Command="{Binding SaveFlowCommand}" Width="90" Style="{StaticResource PrimaryFilledButtonStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Add Step" Command="{Binding AddFlowStepCommand}" Width="100" />
                    <Button Content="Delete" Command="{Binding DeleteFlowStepCommand}" Width="86" />
                    <Button Content="Up" Command="{Binding MoveFlowStepUpCommand}" Width="70" />
                    <Button Content="Down" Command="{Binding MoveFlowStepDownCommand}" Width="70" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14">
            <DataGrid ItemsSource="{Binding FlowRows}" SelectedItem="{Binding SelectedFlowStep}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                    <DataGridTextColumn Header="Step Type" Binding="{Binding StepType, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                    <DataGridTextColumn Header="Service" Binding="{Binding Service, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                    <DataGridTextColumn Header="Sub" Binding="{Binding SubService, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    <DataGridTextColumn Header="Extend" Binding="{Binding ExtendText, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                    <DataGridTextColumn Header="Addressing" Binding="{Binding AddressingMode, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                    <DataGridTextColumn Header="Security" Binding="{Binding SecurityAlgorithm, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                    <DataGridTextColumn Header="CRC" Binding="{Binding CrcAlgorithm, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                    <DataGridTextColumn Header="Timeout" Binding="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                    <DataGridTextColumn Header="Pending" Binding="{Binding PendingTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                    <DataGridTextColumn Header="Algorithm Params" Binding="{Binding AlgorithmParamsText, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14" Margin="0,16,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Validation" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBox Text="{Binding FlowValidationText}" Style="{StaticResource LogTextBoxStyle}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
