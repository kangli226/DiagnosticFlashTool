<UserControl x:Class="DiagnosticFlashTool.App.Views.FlowConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <UserControl.Resources>
        <Style x:Key="FlowConfigToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource Button.ToolBar}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="FlowConfigPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        </Style>

        <Style x:Key="FlowConfigDataGridStyle"
               TargetType="DataGrid"
               BasedOn="{StaticResource DataGrid.Base}">
            <Setter Property="RowHeight" Value="46" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
        </Style>

        <Style x:Key="FlowConfigDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlowConfigCellTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource SoftTextBoxStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        </Style>

        <Style x:Key="FlowConfigReadOnlyCellTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FlowConfigCellComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource StandardComboBoxStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        </Style>

    </UserControl.Resources>

    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource PageHeaderRowStyle}" />
            <RowDefinition Style="{StaticResource PageHeaderGapRowStyle}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Style="{StaticResource PageHeader.Standard}" Breadcrumb="配置管理" Title="流程配置">
            <controls:PageHeader.Actions>
                <controls:PageHelpDocumentButton Style="{StaticResource PageHelpDocumentButton.Standard}" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <Grid MinWidth="780" Margin="{StaticResource CardHorizontalContentPadding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="配置名称："
                                   Margin="0,0,10,0"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Projects}"
                                  SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                  DisplayMemberPath="ProjectName"
                                  ToolTip="{Binding FlowConfigFilePath}"
                                  Style="{StaticResource StandardComboBoxStyle}" />

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding LoadFlowCommand}"
                                    ToolTip="重新加载当前流程配置"
                                    Style="{StaticResource FlowConfigToolbarButtonStyle}">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <controls:FluentIcon Kind="Refresh"
                                                             Style="{StaticResource Button.Glyph.Current}" />
                                    <TextBlock Text="重新加载" Style="{StaticResource Button.IconLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ValidateFlowCommand}"
                                    ToolTip="校验当前流程配置"
                                    Style="{StaticResource FlowConfigToolbarButtonStyle}">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <controls:FluentIcon Kind="CheckCircleOutline"
                                                             Style="{StaticResource Button.Glyph.Current}" />
                                    <TextBlock Text="校验" Style="{StaticResource Button.IconLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NewFlowCommand}"
                                    ToolTip="新建流程配置"
                                    Style="{StaticResource FlowConfigToolbarButtonStyle}">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <controls:FluentIcon Kind="Plus"
                                                             Style="{StaticResource Button.Glyph.Current}" />
                                    <TextBlock Text="新建配置" Style="{StaticResource Button.IconLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SaveFlowCommand}"
                                    ToolTip="保存流程配置"
                                    Style="{StaticResource FlowConfigPrimaryButtonStyle}">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <controls:FluentIcon Kind="ContentSaveOutline"
                                                             Style="{StaticResource Button.Glyph.Current}" />
                                    <TextBlock Text="保存" Style="{StaticResource Button.IconLabel}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <controls:HeaderedCard Grid.Row="4"
                               Header="流程节点"
                               Style="{StaticResource HeaderedCard.Data.Actions}">
            <controls:HeaderedCard.Actions>
                <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding AddFlowStepCommand}"
                                ToolTip="从模板添加节点"
                                Style="{StaticResource FlowConfigToolbarButtonStyle}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="Plus"
                                                         Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="添加节点" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ReplaceFlowStepTemplateCommand}"
                                ToolTip="更换选中节点的模板并清除不兼容配置"
                                Style="{StaticResource FlowConfigToolbarButtonStyle}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="Refresh"
                                                         Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="更换模板" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteFlowStepCommand}"
                                ToolTip="删除选中节点"
                                Style="{StaticResource FlowConfigToolbarButtonStyle}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="DeleteOutline"
                                                         Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="删除节点" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding MoveFlowStepUpCommand}"
                                ToolTip="上移选中节点"
                                Style="{StaticResource FlowConfigToolbarButtonStyle}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="HandPointingUp"
                                                         Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="上移" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding MoveFlowStepDownCommand}"
                                ToolTip="下移选中节点"
                                Style="{StaticResource FlowConfigToolbarButtonStyle}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="HandPointingDown"
                                                         Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="下移" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>
                </StackPanel>
            </controls:HeaderedCard.Actions>
            <DataGrid x:Name="FlowDataGrid"
                          ItemsSource="{Binding FlowRows}"
                          SelectedItem="{Binding SelectedFlowStep, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          AllowDrop="True"
                          PreviewMouseLeftButtonDown="FlowDataGrid_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="FlowDataGrid_PreviewMouseLeftButtonUp"
                          PreviewMouseMove="FlowDataGrid_PreviewMouseMove"
                          DragOver="FlowDataGrid_DragOver"
                          DragLeave="FlowDataGrid_DragLeave"
                          Drop="FlowDataGrid_Drop"
                          CellStyle="{StaticResource FlowConfigDataGridCellStyle}"
                          Style="{StaticResource FlowConfigDataGridStyle}"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ID" Width="76" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="⋮⋮"
                                                   Tag="FlowDragHandle"
                                                   Cursor="SizeNS"
                                                   ToolTip="拖动调整顺序"
                                                   Foreground="{StaticResource IconMutedBrush}"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Id}"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource LabelTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="名称" Width="180" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               ToolTip="名称由节点模板决定"
                                               Style="{StaticResource FlowConfigReadOnlyCellTextStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="服务" Width="68" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Service}"
                                               ToolTip="服务 ID 由节点模板决定"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource FlowConfigReadOnlyCellTextStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="子服务" Width="68" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SubService}"
                                               ToolTip="子服务 ID 由节点模板决定"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource FlowConfigReadOnlyCellTextStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="扩展数据" Width="220" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ExtendText}"
                                               ToolTip="扩展数据由节点模板固定"
                                               Style="{StaticResource FlowConfigReadOnlyCellTextStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="算法" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <ComboBox ItemsSource="{Binding DataContext.FlowSecurityAlgorithmOptions, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                  SelectedItem="{Binding SecurityAlgorithm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="仅发送 Key 节点可配置安全算法">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource FlowConfigCellComboBoxStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanEditSecurityAlgorithm}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                        <TextBlock Text="{Binding AlgorithmDisplayText}"
                                                   ToolTip="{Binding AlgorithmDisplayText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource FlowConfigReadOnlyCellTextStyle}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanEditSecurityAlgorithm}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="算法参数" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBox Text="{Binding AlgorithmParamsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="仅发送 Key 节点可配置，多个参数可用逗号分隔"
                                                 IsEnabled="{Binding CanEditSecurityAlgorithm}"
                                                 Style="{StaticResource FlowConfigCellTextBoxStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
            </DataGrid>
        </controls:HeaderedCard>

        <Border Grid.Row="6" Style="{StaticResource CardStyle}">
            <Grid Margin="{StaticResource CardHorizontalContentPadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:FluentIcon Grid.Column="0"
                                         Kind="CheckCircleOutline"
                                         Style="{StaticResource Button.Glyph.Accent}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding FlowValidationText}"
                           Foreground="{StaticResource BodyTextBrush}"
                           FontSize="{StaticResource FontSize.Body}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding FlowValidationText}" />
            </Grid>
        </Border>

    </Grid>
</UserControl>
