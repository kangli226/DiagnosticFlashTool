<UserControl x:Class="DiagnosticFlashTool.App.Views.ProjectFlashFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <Grid Style="{StaticResource PageRootGridStyle}">
        <controls:HeaderedCard Header="流程节点" Style="{StaticResource HeaderedCard.Data}">
            <controls:HeaderedCard.Actions>
                <TextBlock Text="{Binding FlowConfigFileDisplay}"
                           ToolTip="{Binding FlowConfigFilePath}"
                           MaxWidth="320"
                           Style="{StaticResource MonoAssistTextStyle}" />
            </controls:HeaderedCard.Actions>

            <Grid>
                <DataGrid ItemsSource="{Binding ProjectFlowSteps}"
                          AutomationProperties.Name="刷写流程"
                          IsReadOnly="True"
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="服务名称" Width="2*" MinWidth="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ServiceName, Mode=OneWay}"
                                               ToolTip="{Binding ServiceName}"
                                               Style="{StaticResource DataGrid.CellText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="子服务"
                                            Binding="{Binding SubService, Mode=OneWay}"
                                            Width="96"
                                            ElementStyle="{StaticResource DataGrid.MonoCellText}" />
                        <DataGridTemplateColumn Header="服务介绍" Width="3*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description, Mode=OneWay}"
                                               ToolTip="{Binding Description}"
                                               Style="{StaticResource DataGrid.CellText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding ProjectFlowNotice}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           IsHitTestVisible="False"
                           Style="{StaticResource SettingAssistTextStyle}" />
            </Grid>
        </controls:HeaderedCard>
    </Grid>
</UserControl>
