<UserControl x:Class="DiagnosticFlashTool.App.Views.DeveloperOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Border Style="{StaticResource Card.Standard}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="开发者选项"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="{StaticResource PageContentBottomGap}" />
                <TextBox Text="{Binding FlowValidationText}"
                         Style="{StaticResource LogTextBoxStyle}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
