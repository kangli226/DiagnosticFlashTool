<UserControl x:Class="DiagnosticFlashTool.App.Views.DeveloperOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Border Style="{StaticResource CardStyle}" Padding="18">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="开发者选项"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,12" />
                <TextBox Text="{Binding FlowValidationText}"
                         Style="{StaticResource LogTextBoxStyle}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
