<UserControl x:Class="DiagnosticFlashTool.App.Views.DeveloperOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls"
             xmlns:views="clr-namespace:DiagnosticFlashTool.App.Views"
             xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Style="{StaticResource PageSectionGapRowStyle}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Style="{StaticResource PageSectionGapRowStyle}" />
            <RowDefinition Height="3*" />
            <RowDefinition Style="{StaticResource PageSectionGapRowStyle}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Style="{StaticResource PageSectionGapRowStyle}" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- 项目选择在三个诊断页面间共享，刷写参数随项目联动。 -->
        <Border Grid.Row="0" Style="{StaticResource Card.Compact}">
            <Grid Style="{StaticResource Card.ContentRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <controls:WorkspaceProjectSelector Grid.Column="0" />

                <Button Grid.Column="1"
                        Command="{Binding StartFlashCommand}"
                        Margin="10,0,0,0"
                        Style="{StaticResource Button.Normal}"
                        ToolTip="连接 CAN 设备并选择 BOOT 配置后开始刷写"
                        ToolTipService.ShowOnDisabled="True">
                    <StackPanel Style="{StaticResource Button.InlineContent}">
                        <controls:FluentIcon Kind="CloudDownloadOutline"
                                             Style="{StaticResource Button.Glyph.Current}" />
                        <TextBlock Text="开始刷写" Style="{StaticResource Button.IconLabel}" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding CancelFlashCommand}"
                        Margin="0"
                        Style="{StaticResource Button.Danger}"
                        ToolTip="中止正在进行的刷写，并让 ECU 退出编程会话"
                        ToolTipService.ShowOnDisabled="True">
                    <StackPanel Style="{StaticResource Button.InlineContent}">
                        <controls:FluentIcon Kind="CloseCircleOutline"
                                             Style="{StaticResource Button.Glyph.Current}" />
                        <TextBlock Text="取消" Style="{StaticResource Button.IconLabel}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border x:Name="ManualFrameToolbar" Grid.Row="2" Style="{StaticResource Card.Toolbar}">
            <Border.Resources>
                <system:Double x:Key="ManualFrameControlHeight">30</system:Double>
                <GridLength x:Key="ManualFrameFieldGap">20</GridLength>

                <Style x:Key="ManualFrameLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
                    <Setter Property="Margin" Value="0,0,10,0" />
                </Style>

                <Style x:Key="ManualFrameFieldStyle" TargetType="Border" BasedOn="{StaticResource InputGroupBorderStyle}">
                    <Setter Property="Height" Value="{StaticResource ManualFrameControlHeight}" />
                </Style>
            </Border.Resources>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="134" />
                    <ColumnDefinition Width="{StaticResource ManualFrameFieldGap}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{StaticResource ManualFrameFieldGap}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource ManualFrameFieldGap}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ManualFrameIdLabel" Grid.Column="0"
                           Text="帧 ID"
                           Style="{StaticResource ManualFrameLabelStyle}" />
                <Border Grid.Column="1" Style="{StaticResource ManualFrameFieldStyle}">
                    <DockPanel>
                        <ContentPresenter DockPanel.Dock="Left" Margin="9,0,0,0"
                                          Content="0x"
                                          ContentTemplate="{StaticResource InputGroupAnnotationTemplate}" />
                        <TextBox AutomationProperties.LabeledBy="{Binding ElementName=ManualFrameIdLabel}"
                                 Text="{Binding ManualFrameId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如 7E0 或 0x7E0"
                                 Style="{StaticResource InputGroupMonoTextBoxStyle}" />
                    </DockPanel>
                </Border>

                <!-- 分别生成选中项和弹出项的文本，避免弹出列表的宽度反向撑大工具条。 -->
                <ComboBox Grid.Column="3" Width="Auto" MinWidth="116" MaxWidth="144"
                          Height="{StaticResource CardContentRowHeight}"
                          Padding="10,0,0,0"
                          AutomationProperties.Name="帧格式"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding IsManualFrameExtended, Mode=TwoWay}"
                          Style="{StaticResource StandardComboBoxStyle}">
                    <ComboBoxItem Content="{Binding}" AutomationProperties.Name="标准帧">
                        <ComboBoxItem.Tag>
                            <system:Boolean>False</system:Boolean>
                        </ComboBoxItem.Tag>
                        <ComboBoxItem.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ActiveProtocolText, StringFormat='标准帧 ({0})'}" />
                            </DataTemplate>
                        </ComboBoxItem.ContentTemplate>
                    </ComboBoxItem>
                    <ComboBoxItem Content="{Binding}" AutomationProperties.Name="扩展帧">
                        <ComboBoxItem.Tag>
                            <system:Boolean>True</system:Boolean>
                        </ComboBoxItem.Tag>
                        <ComboBoxItem.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ActiveProtocolText, StringFormat='扩展帧 ({0})'}" />
                            </DataTemplate>
                        </ComboBoxItem.ContentTemplate>
                    </ComboBoxItem>
                </ComboBox>

                <TextBlock x:Name="ManualFrameDataLabel" Grid.Column="5"
                           Text="发送数据"
                           Style="{StaticResource ManualFrameLabelStyle}" />
                <Border Grid.Column="6" Style="{StaticResource ManualFrameFieldStyle}">
                    <DockPanel>
                        <ContentPresenter DockPanel.Dock="Right" Margin="0,0,9,0"
                                          Content="{Binding ManualFrameByteCountText}"
                                          ContentTemplate="{StaticResource InputGroupAnnotationTemplate}" />
                        <TextBox AutomationProperties.LabeledBy="{Binding ElementName=ManualFrameDataLabel}"
                                 Text="{Binding ManualFrameData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如 02 10 03"
                                 Style="{StaticResource InputGroupMonoTextBoxStyle}" />
                    </DockPanel>
                </Border>

                <!-- 此工具条按参考图为普通按钮补充浅色背景和轮廓。 -->
                <Button Grid.Column="8" Width="78"
                        Height="{StaticResource ManualFrameControlHeight}"
                        Command="{Binding SendManualFrameCommand}"
                        Margin="0"
                        Background="{StaticResource PrimarySoftBrush}"
                        BorderBrush="{StaticResource PrimarySoftBorderBrush}"
                        BorderThickness="1"
                        Style="{StaticResource Button.Normal}"
                        ToolTip="连接 CAN 设备后发送报文"
                        ToolTipService.ShowOnDisabled="True">
                    <StackPanel Style="{StaticResource Button.InlineContent}">
                        <controls:FluentIcon Kind="SendOutline"
                                             Style="{StaticResource Button.Glyph.Current}"
                                             RenderTransformOrigin="0.5,0.5">
                            <controls:FluentIcon.RenderTransform>
                                <RotateTransform Angle="-75" />
                            </controls:FluentIcon.RenderTransform>
                        </controls:FluentIcon>
                        <TextBlock Text="发送" Style="{StaticResource Button.IconLabel}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Style="{StaticResource PageColumnGapStyle}" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>
            <controls:HeaderedCard Grid.Column="0" Header="下载信息"
                                   Style="{StaticResource HeaderedCard.Panel}">
                <controls:HeaderedCard.Actions>
                    <Button Command="{Binding ClearLogCommand}"
                            IsEnabled="{Binding HasLogEntries}" Margin="0"
                            Style="{StaticResource Button.Danger}"
                            ToolTip="清空当前工作区的显示日志"
                            ToolTipService.ShowOnDisabled="True">
                        <TextBlock Text="清空" Margin="0" Style="{StaticResource Button.IconLabel}" />
                    </Button>
                </controls:HeaderedCard.Actions>
                <controls:LogEntryList ItemsSource="{Binding DownloadInfoEntries}"
                                       IsCompact="True"
                                       ShowProjectSource="{Binding ShowDownloadInfoSources}"
                                       AutomationProperties.Name="下载信息"
                                       EmptyText="暂无下载信息" />
            </controls:HeaderedCard>

            <!-- 实时报文沿用全局表格样式，并保留滚轮及键盘滚动。 -->
            <controls:HeaderedCard Grid.Column="2"
                                   Header="实时报文"
                                   Style="{StaticResource HeaderedCard.Data.Actions}">
                <controls:HeaderedCard.Actions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ToggleFrameCaptureCommand}"
                                Style="{StaticResource Button.Normal}"
                                ToolTip="暂停或继续接收报文显示">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="Pause"
                                                     Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="{Binding FrameCaptureActionText}"
                                           Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ToggleFrameFilterCommand}"
                                Style="{StaticResource Button.Normal}"
                                ToolTip="按当前配置的物理请求、功能请求和响应地址切换报文过滤">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="FilterOutline"
                                                     Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="{Binding FrameFilterActionText}"
                                           Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ExportFramesCommand}"
                                Style="{StaticResource Button.Normal}"
                                ToolTip="导出当前报文历史">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="ExportVariant"
                                                     Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="导出" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ClearFramesCommand}"
                                Margin="0"
                                Style="{StaticResource Button.Danger}"
                                ToolTip="清空当前显示的报文历史"
                                ToolTipService.ShowOnDisabled="True">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="DeleteSweepOutline"
                                                     Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="清空报文" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:HeaderedCard.Actions>

                <Grid>
                    <DataGrid ItemsSource="{Binding Frames}"
                              IsReadOnly="True"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              Style="{StaticResource DataGrid.Base}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="70"
                                                ElementStyle="{StaticResource DataGrid.CellText}" />
                            <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="104"
                                                ElementStyle="{StaticResource DataGrid.MonoCellText}" />
                            <DataGridTextColumn Header="格式" Binding="{Binding FormatText}" Width="64"
                                                ElementStyle="{StaticResource DataGrid.CellText}" />
                            <DataGridTextColumn Header="协议" Binding="{Binding ProtocolText}" Width="64"
                                                ElementStyle="{StaticResource DataGrid.CellText}" />
                            <DataGridTextColumn Header="BRS" Binding="{Binding BrsText}" Width="44"
                                                ElementStyle="{StaticResource DataGrid.CellText}" />
                            <DataGridTextColumn Header="ESI" Binding="{Binding EsiText}" Width="44"
                                                ElementStyle="{StaticResource DataGrid.CellText}" />
                            <DataGridTextColumn Header="长度" Binding="{Binding Dlc}" Width="48"
                                                ElementStyle="{StaticResource DataGrid.MonoCellText}" />
                            <DataGridTextColumn Header="数据" Binding="{Binding DataText}" Width="*" MinWidth="180"
                                                ElementStyle="{StaticResource DataGrid.MonoCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="暂无报文，连接设备并开始捕获后显示。"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Frames.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </controls:HeaderedCard>
        </Grid>

        <Border Grid.Row="6" Style="{StaticResource Card.Compact}">
            <Grid Style="{StaticResource Card.ContentRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Style="{StaticResource PageColumnGapStyle}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" MinWidth="72" />
                    <ColumnDefinition Style="{StaticResource PageColumnGapStyle}" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" MinWidth="72" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FlashProgressLabel"
                           Text="刷写进度"
                           Style="{StaticResource FieldLabelStyle}" />
                <ProgressBar Grid.Column="1"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding Progress}"
                             AutomationProperties.LabeledBy="{Binding ElementName=FlashProgressLabel}"
                             VerticalAlignment="Center"
                             Style="{StaticResource SoftProgressBarStyle}" />
                <TextBlock Grid.Column="2"
                           Width="52"
                           Text="{Binding ProgressText}"
                           TextAlignment="Center"
                           Style="{StaticResource ProgressValueTextStyle}" />
                <TextBlock Grid.Column="4" Text="开始时间" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Grid.Column="5" Text="{Binding FlashStartTimeText}" Style="{StaticResource ConfigValueTextStyle}" />
                <TextBlock Grid.Column="7" Text="持续时间" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Grid.Column="8" Text="{Binding FlashDurationText}" Style="{StaticResource ConfigValueTextStyle}" />
            </Grid>
        </Border>

        <views:RuntimeLogView Grid.Row="8" />
    </Grid>
</UserControl>
