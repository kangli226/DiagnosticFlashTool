<Window x:Class="DiagnosticFlashTool.App.Views.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="未保存的修改"
        Width="520"
        MinHeight="280"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Margin="16"
            Padding="28"
            Style="{StaticResource DialogPanelStyle}"
            Effect="{StaticResource CardElevatedShadowEffect}">
        <Grid KeyboardNavigation.TabNavigation="Cycle">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Grid.Column="0"
                                         Kind="{x:Static materialDesign:PackIconKind.AlertOutline}"
                                         Width="24"
                                         Height="24"
                                         Foreground="{StaticResource StatusWarningBrush}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="未保存的修改"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource CardTitleTextBrush}"
                           VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource SettingGroupPanelStyle}">
                <StackPanel>
                    <TextBlock x:Name="PromptTextBlock"
                               FontSize="14"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,10,0,0"
                               Text="选择“保存”保留修改，选择“不保存”放弃修改，或选择“取消”继续编辑。"
                               Style="{StaticResource HintTextStyle}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="96"
                        Height="32"
                        Margin="0,0,12,0"
                        Style="{StaticResource Button.Danger}"
                        Click="Discard_Click">
                    <TextBlock Text="不保存"
                               Style="{StaticResource Button.IconLabel}"
                               Margin="0" />
                </Button>
                <Button Width="88"
                        Margin="0,0,12,0"
                        IsCancel="True"
                        Style="{StaticResource Button.DialogSecondary}">
                    <TextBlock Text="取消"
                               Style="{StaticResource Button.IconLabel}"
                               Margin="0" />
                </Button>
                <Button x:Name="SaveButton"
                        Width="88"
                        IsDefault="True"
                        Style="{StaticResource Button.DialogPrimary}"
                        Click="Save_Click">
                    <TextBlock Text="保存"
                               Style="{StaticResource Button.IconLabel.Inverse}"
                               Margin="0" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
