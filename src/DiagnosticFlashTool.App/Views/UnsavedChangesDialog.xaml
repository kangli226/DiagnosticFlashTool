<Window x:Class="DiagnosticFlashTool.App.Views.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls"
        Title="未保存的修改"
        Width="440"
        MinHeight="180"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.UI}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Margin="12"
            Style="{StaticResource DialogPanelStyle}">
        <Grid KeyboardNavigation.TabNavigation="Cycle">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:FluentIcon Grid.Column="0"
                                    Kind="WarningOutline"
                                    Width="20"
                                    Height="20"
                                    FontSize="18"
                                    Margin="0,0,8,0"
                                    Foreground="{StaticResource StatusWarningBrush}"
                                    VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="未保存的修改"
                           Style="{StaticResource DialogTitleTextStyle}" />
                <Button Grid.Column="2"
                        Width="26"
                        Height="26"
                        Padding="0"
                        Margin="0"
                        Style="{StaticResource Button.Normal}"
                        ToolTip="关闭（取消）"
                        Click="Close_Click">
                    <controls:FluentIcon Kind="Close"
                                         Style="{StaticResource Button.Glyph.Current}" />
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,10,0,0"
                    Style="{StaticResource SettingGroupPanelStyle}">
                <StackPanel>
                    <TextBlock x:Name="PromptTextBlock"
                               FontSize="{StaticResource FontSize.Body}"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Text="选择“保存”保留修改，选择“不保存”放弃修改，或选择“取消”继续编辑。"
                               Style="{StaticResource HintTextStyle}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Width="88"
                        Style="{StaticResource Button.Danger}"
                        Click="Discard_Click">
                    <TextBlock Text="不保存"
                               Style="{StaticResource Button.IconLabel}"
                               Margin="0" />
                </Button>
                <Button Width="80"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Style="{StaticResource Button.Normal}">
                    <TextBlock Text="取消"
                               Style="{StaticResource Button.IconLabel}"
                               Margin="0" />
                </Button>
                <Button x:Name="SaveButton"
                        Width="80"
                        IsDefault="True"
                        Margin="0"
                        Style="{StaticResource Button.Normal}"
                        Click="Save_Click">
                    <TextBlock Text="保存"
                               Style="{StaticResource Button.IconLabel}"
                               Margin="0" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
