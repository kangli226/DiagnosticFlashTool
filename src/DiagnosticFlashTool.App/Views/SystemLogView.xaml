<UserControl x:Class="DiagnosticFlashTool.App.Views.SystemLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource PageHeaderRowStyle}" />
            <RowDefinition Style="{StaticResource PageHeaderGapRowStyle}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             Title="日志"
                             Subtitle="查看运行日志与本地日志文件">
            <controls:PageHeader.Actions>
                <controls:PageHelpDocumentButton />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Border Grid.Row="2"
                Style="{StaticResource PageLeadStandardCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="运行日志"
                               Style="{StaticResource CardHeaderTextStyle}" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                MinWidth="148"
                                Tag="{Binding LogFileStatusKind}"
                                Style="{StaticResource PathDisplayBorderStyle}">
                            <TextBlock Text="{Binding LogFileStatusText}"
                                       Style="{StaticResource StatusBadgeTextStyle}" />
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource PathDisplayBorderStyle}"
                                ToolTip="{Binding LogFileStatusPathText}">
                            <TextBlock Text="{Binding LogFileStatusPathText}"
                                       Style="{StaticResource PathDisplayTextStyle}" />
                        </Border>

                        <TextBlock Grid.Column="4"
                                   Text="{Binding LogFilterSummaryText}"
                                   Style="{StaticResource SettingAssistTextStyle}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Grid>

                <DockPanel Grid.Row="2"
                           LastChildFill="True">
                    <WrapPanel VerticalAlignment="Center">
                        <Button Command="{Binding RefreshLogCommand}"
                                Style="{StaticResource Button.ToolBar}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.Refresh}"
                                                         Style="{StaticResource Button.PackIcon.Current}" />
                                <TextBlock Text="刷新" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ClearLogCommand}"
                                Style="{StaticResource Button.ToolBar}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.DeleteSweepOutline}"
                                                         Style="{StaticResource Button.PackIcon.Current}" />
                                <TextBlock Text="清空" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenLogFileCommand}"
                                Style="{StaticResource Button.ToolBar}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.TextBoxOutline}"
                                                         Style="{StaticResource Button.PackIcon.Current}" />
                                <TextBlock Text="日志" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenLogDirectoryCommand}"
                                Style="{StaticResource Button.ToolBar}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderOpenOutline}"
                                                         Style="{StaticResource Button.PackIcon.Current}" />
                                <TextBlock Text="目录" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ExportLogCommand}"
                                Style="{StaticResource Button.ToolBar}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.ExportVariant}"
                                                         Style="{StaticResource Button.PackIcon.Current}" />
                                <TextBlock Text="导出" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal"
                                    Margin="8,0,12,0">
                            <TextBlock Text="级别"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Width="34" />
                            <ComboBox Width="86"
                                      ItemsSource="{Binding LogLevelFilters}"
                                      SelectedItem="{Binding SelectedLogLevelFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource StandardComboBoxStyle}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,12,0">
                            <TextBlock Text="关键词"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Width="46" />
                            <TextBox Width="168"
                                     Height="32"
                                     Text="{Binding LogSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SoftTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,12,0">
                            <TextBlock Text="时间范围"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Width="58" />
                            <ComboBox Width="104"
                                      ItemsSource="{Binding LogTimeRangeFilters}"
                                      SelectedItem="{Binding SelectedLogTimeRangeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource StandardComboBoxStyle}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,8,0">
                            <ToggleButton IsChecked="{Binding LogAutoScrollEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource SoftSwitchStyle}" />
                            <TextBlock Text="自动滚动"
                                       Margin="8,0,0,0"
                                       Style="{StaticResource SettingAssistTextStyle}" />
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>

                <ListBox Grid.Row="4"
                         ItemsSource="{Binding FilteredLogEntries}"
                         controls:ListBoxAutoScrollBehavior.IsEnabled="{Binding LogAutoScrollEnabled}"
                         Style="{StaticResource LogListBoxStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding LevelText}"
                                           Tag="{Binding Kind}"
                                           Style="{StaticResource StatusValueTextStyle}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Text}"
                                           Foreground="{StaticResource LogTextBrush}"
                                           FontFamily="Consolas"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
