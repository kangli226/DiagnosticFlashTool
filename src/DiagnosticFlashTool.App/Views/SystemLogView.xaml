<UserControl x:Class="DiagnosticFlashTool.App.Views.SystemLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Border Style="{StaticResource Card.Compact}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <TextBlock Text="级别" Width="34" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Width="88" Margin="0"
                                  AutomationProperties.Name="日志级别"
                                  ItemsSource="{Binding LogLevelFilters}"
                                  SelectedItem="{Binding SelectedLogLevelFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource StandardComboBoxStyle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <TextBlock Text="关键词" Width="46" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Width="144" Margin="0"
                                 AutomationProperties.Name="日志关键词"
                                 Text="{Binding LogSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <TextBlock Text="时间范围" Width="58" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Width="116" Margin="0"
                                  AutomationProperties.Name="日志时间范围"
                                  ItemsSource="{Binding LogTimeRangeFilters}"
                                  SelectedItem="{Binding SelectedLogTimeRangeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource StandardComboBoxStyle}" />
                    </StackPanel>

                    <Button Command="{Binding OpenLogFileCommand}"
                            Style="{StaticResource Button.Normal}"
                            ToolTip="用系统默认程序打开磁盘上的日志文件；文件日志未开启时不可用"
                            ToolTipService.ShowOnDisabled="True">
                        <StackPanel Style="{StaticResource Button.InlineContent}">
                            <controls:FluentIcon Kind="TextBoxOutline" Style="{StaticResource Button.Glyph.Current}" />
                            <TextBlock Text="打开文件" Style="{StaticResource Button.IconLabel}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportLogCommand}" Style="{StaticResource Button.Normal}">
                        <StackPanel Style="{StaticResource Button.InlineContent}">
                            <controls:FluentIcon Kind="ExportVariant" Style="{StaticResource Button.Glyph.Current}" />
                            <TextBlock Text="导出" Style="{StaticResource Button.IconLabel}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ClearLogCommand}"
                            Style="{StaticResource Button.Danger}" Margin="0"
                            ToolTip="仅清空本次运行的显示日志，不删除磁盘日志文件">
                        <StackPanel Style="{StaticResource Button.InlineContent}">
                            <controls:FluentIcon Kind="DeleteSweepOutline" Style="{StaticResource Button.Glyph.Current}" />
                            <TextBlock Text="清空显示" Style="{StaticResource Button.IconLabel}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <Grid Grid.Row="1" Margin="0,4,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Tag="{Binding LogFileStatusKind}"
                            VerticalAlignment="Center" Margin="0,0,10,0"
                            ToolTip="文件日志关闭时仅保留本次运行记录，可在日志设置中开启"
                            Style="{StaticResource StatusBadgeBorderStyle}">
                        <TextBlock Text="{Binding LogFileStatusText}" Style="{StaticResource StatusBadgeTextStyle}" />
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding LogFileStatusPathText}"
                               ToolTip="{Binding LogFilePathFullPath}"
                               Style="{StaticResource MonoAssistTextStyle}" />

                    <Button Grid.Column="2" Command="{Binding NavigateToLogSettingsCommand}"
                            Style="{StaticResource Button.Normal}" Margin="8,0,12,0" Content="日志设置" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton IsChecked="{Binding LogAutoScrollEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="日志自动滚动"
                                      Style="{StaticResource SoftSwitchStyle}"
                                      ToolTip="开启后自动滚动到最新日志" />
                        <TextBlock Text="自动滚动" Margin="8,0,12,0" Style="{StaticResource SettingAssistTextStyle}" />
                    </StackPanel>

                    <TextBlock Grid.Column="4" Text="{Binding LogFilterSummaryText}"
                               Style="{StaticResource SettingAssistTextStyle}" VerticalAlignment="Center" />
                </Grid>

                <!-- 保留滚动条，便于在完整日志中拖动定位；底部显示区沿用隐藏滚动条。 -->
                <controls:LogEntryList Grid.Row="2"
                                       ItemsSource="{Binding FilteredLogEntries}"
                                       AutomationProperties.Name="操作日志列表"
                                       AutoScrollEnabled="{Binding LogAutoScrollEnabled}"
                                       VerticalScrollBarVisibility="Auto"
                                       EmptyText="{Binding LogEmptyStateText}"
                                       EmptyHintText="{Binding LogEmptyStateHintText}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
