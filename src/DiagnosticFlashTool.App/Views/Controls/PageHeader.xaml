<UserControl x:Class="DiagnosticFlashTool.App.Views.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Margin="{Binding Padding, ElementName=Root}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding Title, ElementName=Root}"
                   Style="{StaticResource PageHeaderTitleTextStyle}"
                   TextTrimming="CharacterEllipsis" />
        <ContentControl Grid.Column="1"
                        Content="{Binding Actions, ElementName=Root}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
    </Grid>
</UserControl>
