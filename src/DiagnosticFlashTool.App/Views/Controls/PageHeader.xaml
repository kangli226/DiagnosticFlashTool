<UserControl x:Class="DiagnosticFlashTool.App.Views.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource PageHeaderCardStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <ContentControl Grid.Column="1"
                            Content="{Binding Actions, ElementName=Root}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
