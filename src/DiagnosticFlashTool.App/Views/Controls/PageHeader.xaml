<UserControl x:Class="DiagnosticFlashTool.App.Views.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root">
    <Grid Margin="{Binding Padding, ElementName=Root}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Breadcrumb, ElementName=Root}"
                       Style="{StaticResource PageHeaderBreadcrumbTextStyle}"
                       TextTrimming="CharacterEllipsis" />
            <materialDesign:PackIcon Grid.Column="1"
                                     Kind="{x:Static materialDesign:PackIconKind.ChevronRight}"
                                     Style="{StaticResource PageHeaderSeparatorIconStyle}" />
            <TextBlock Grid.Column="2"
                       Text="{Binding Title, ElementName=Root}"
                       Style="{StaticResource PageHeaderTitleTextStyle}"
                       TextTrimming="CharacterEllipsis" />
            <Border Margin="10,0,0,0"
                    Padding="8,3"
                    Grid.Column="3">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PageHeaderBadgeStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BadgeText, ElementName=Root}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding BadgeText, ElementName=Root}"
                           Style="{StaticResource PageHeaderBadgeTextStyle}" />
            </Border>
        </Grid>
        <ContentControl Grid.Column="1"
                        Content="{Binding Actions, ElementName=Root}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
    </Grid>
</UserControl>
