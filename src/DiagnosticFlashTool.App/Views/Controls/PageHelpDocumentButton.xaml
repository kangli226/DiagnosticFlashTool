<UserControl x:Class="DiagnosticFlashTool.App.Views.Controls.PageHelpDocumentButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             HorizontalAlignment="Right"
             VerticalAlignment="Center">
    <Button Style="{StaticResource Button.HelpDocument}"
            Command="{Binding Command, ElementName=Root}"
            CommandParameter="{Binding CommandParameter, ElementName=Root}"
            ToolTip="{Binding ToolTip, ElementName=Root}">
        <StackPanel Style="{StaticResource Button.InlineContent}">
            <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.HelpRhombusOutline}"
                                     Style="{StaticResource Button.PackIcon.Current}" />
            <TextBlock Text="{Binding Text, ElementName=Root}"
                       Style="{StaticResource Button.IconLabel}" />
        </StackPanel>
    </Button>
</UserControl>
