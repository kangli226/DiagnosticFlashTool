<UserControl x:Class="DiagnosticFlashTool.App.Views.Controls.PageHelpDocumentButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Button Width="88"
            Height="28"
            Padding="0"
            Margin="0"
            FontSize="{StaticResource FontSize.Assist}"
            Style="{StaticResource Button.Normal}"
            ToolTip="{Binding ToolTip, ElementName=Root}">
        <TextBlock Text="{Binding Text, ElementName=Root}"
                   Margin="0"
                   FontSize="{StaticResource FontSize.Assist}"
                   Style="{StaticResource Button.IconLabel}" />
    </Button>
</UserControl>
