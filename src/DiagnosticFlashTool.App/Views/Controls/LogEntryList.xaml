<UserControl x:Class="DiagnosticFlashTool.App.Views.Controls.LogEntryList"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <Grid>
        <ListBox x:Name="Entries"
                 ItemsSource="{Binding ItemsSource, ElementName=Root}"
                 AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}"
                 controls:ListBoxAutoScrollBehavior.IsEnabled="{Binding AutoScrollEnabled, ElementName=Root}"
                 ScrollViewer.VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility, ElementName=Root}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Style="{StaticResource LogListBoxStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LevelText}" Tag="{Binding Kind}"
                                   FontSize="{StaticResource FontSize.Assist}"
                                   LineHeight="{StaticResource LineHeight.Assist}"
                                   LineStackingStrategy="BlockLineHeight"
                                   Style="{StaticResource StatusValueTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" ToolTip="{Binding Text}"
                                   Foreground="{StaticResource LogTextBrush}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="{StaticResource FontSize.Assist}"
                                   LineHeight="{StaticResource LineHeight.Assist}"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel VerticalAlignment="Center" Margin="{StaticResource CardContentPadding}"
                    IsHitTestVisible="False">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=Entries}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="{Binding EmptyText, ElementName=Root}" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Style="{StaticResource SectionHeaderTextStyle}" />
            <TextBlock Text="{Binding EmptyHintText, ElementName=Root}" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Style="{StaticResource SettingAssistTextStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
