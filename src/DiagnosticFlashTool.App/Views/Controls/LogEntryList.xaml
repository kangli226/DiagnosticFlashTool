<UserControl x:Class="DiagnosticFlashTool.App.Views.Controls.LogEntryList"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls"
             xmlns:vm="clr-namespace:DiagnosticFlashTool.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="LogEntryTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding LevelText}" Tag="{Binding Kind}"
                           FontSize="{StaticResource FontSize.Assist}"
                           LineHeight="{StaticResource LineHeight.Assist}"
                           LineStackingStrategy="BlockLineHeight"
                           Style="{StaticResource StatusValueTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" ToolTip="{Binding Text}"
                           Foreground="{StaticResource LogTextBrush}"
                           FontFamily="{StaticResource Font.Mono}"
                           FontSize="{StaticResource FontSize.Assist}"
                           LineHeight="{StaticResource LineHeight.Assist}"
                           LineStackingStrategy="BlockLineHeight"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CompactLogEntryTemplate">
            <Grid Background="Transparent">
                <Grid.ToolTip>
                    <ToolTip>
                        <TextBlock Text="{Binding PlacementTarget.DataContext.Text, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                   MaxWidth="480" TextWrapping="Wrap" />
                    </ToolTip>
                </Grid.ToolTip>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                           FontSize="{StaticResource FontSize.Caption}"
                           VerticalAlignment="Top"
                           LineHeight="{StaticResource LineHeight.Body}"
                           Style="{StaticResource MonoAssistTextStyle}" />
                <StackPanel Grid.Column="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Severity" Text="{Binding LevelText}" Tag="{Binding Kind}"
                                   Visibility="Collapsed" Margin="0,0,8,0"
                                   FontSize="{StaticResource FontSize.Assist}"
                                   LineHeight="{StaticResource LineHeight.Assist}"
                                   LineStackingStrategy="BlockLineHeight"
                                   Style="{StaticResource StatusValueTextStyle}" />
                        <TextBlock x:Name="ProjectSource" Grid.Column="1" Text="{Binding SourceText}"
                                   Visibility="Collapsed" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource HintTextStyle}" />
                    </Grid>
                    <TextBlock Text="{Binding DisplayMessage}" TextWrapping="Wrap"
                               FontFamily="{StaticResource Font.UI}"
                               LineHeight="{StaticResource LineHeight.Body}"
                               LineStackingStrategy="BlockLineHeight" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:DiagnosticStatusKind.Warning}">
                    <Setter TargetName="Severity" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:DiagnosticStatusKind.Error}">
                    <Setter TargetName="Severity" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowProjectSource, RelativeSource={RelativeSource AncestorType=controls:LogEntryList}}"
                             Value="True">
                    <Setter TargetName="ProjectSource" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ListBox x:Name="Entries"
                 ItemsSource="{Binding ItemsSource, ElementName=Root}"
                 AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}"
                 controls:ListBoxAutoScrollBehavior.IsEnabled="{Binding AutoScrollEnabled, ElementName=Root}"
                 ScrollViewer.VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility, ElementName=Root}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Style>
                <Style TargetType="ListBox" BasedOn="{StaticResource LogListBoxStyle}">
                    <Setter Property="ItemTemplate" Value="{StaticResource LogEntryTemplate}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                            <Setter Property="ItemTemplate" Value="{StaticResource CompactLogEntryTemplate}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="SelectionMode" Value="Extended" />
                            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="复制完整记录" Command="ApplicationCommands.Copy"
                                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
            <ListBox.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Copy"
                                CanExecute="CopyEntries_CanExecute"
                                Executed="CopyEntries_Executed" />
            </ListBox.CommandBindings>
        </ListBox>

        <StackPanel VerticalAlignment="Center" Margin="{StaticResource CardContentPadding}"
                    IsHitTestVisible="False">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=Entries}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="{Binding EmptyText, ElementName=Root}" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Style="{StaticResource SectionHeaderTextStyle}" />
            <TextBlock Text="{Binding EmptyHintText, ElementName=Root}" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource SubtleTextBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SettingAssistTextStyle}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
