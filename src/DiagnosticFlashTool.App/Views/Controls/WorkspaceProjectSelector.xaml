<UserControl x:Class="DiagnosticFlashTool.App.Views.Controls.WorkspaceProjectSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid IsEnabled="{Binding CanChangeWorkspace}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="项目" Margin="0,0,8,0" Style="{StaticResource FieldLabelStyle}" />
        <ComboBox Grid.Column="1" Width="Auto" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Projects}"
                  SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                  ToolTip="{Binding FlowConfigFilePath}"
                  AutomationProperties.Name="当前项目"
                  Style="{StaticResource StandardComboBoxStyle}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock ToolTip="{Binding ProjectName}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} / {1}">
                                <Binding Path="ProjectName" />
                                <Binding Path="BootConfigFile" Converter="{StaticResource FileNameConverter}" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Grid>
</UserControl>
