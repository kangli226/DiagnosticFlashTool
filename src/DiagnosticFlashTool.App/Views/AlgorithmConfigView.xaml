<UserControl x:Class="DiagnosticFlashTool.App.Views.AlgorithmConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource PageHeaderRowStyle}" />
            <RowDefinition Style="{StaticResource PageHeaderGapRowStyle}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding AlgorithmCatalogText}"
                               Style="{StaticResource PageHeaderMetaTextStyle}" />
                    <TextBlock Text="{Binding ScriptRootText}"
                               ToolTip="{Binding ScriptRootText}"
                               Margin="12,0,0,0"
                               MaxWidth="280"
                               FontSize="12"
                               Foreground="{StaticResource SubtleTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <controls:PageHelpDocumentButton Margin="8,0,0,0" />
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Border Grid.Row="2" Style="{StaticResource Card.Compact}">
            <DataGrid ItemsSource="{Binding AlgorithmRows}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
