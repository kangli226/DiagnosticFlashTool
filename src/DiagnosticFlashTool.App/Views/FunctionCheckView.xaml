<UserControl x:Class="DiagnosticFlashTool.App.Views.FunctionCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="20" />
            <RowDefinition Height="120" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="22,0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="功能检测"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="加载配方并运行检测，结果如下表所示"
                               FontSize="14"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Height="36"
                            Padding="10,0"
                            Margin="0,0,22,0"
                            Background="Transparent"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="主题"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Content="&#xE921;"
                            ToolTip="最小化"
                            Style="{StaticResource ChromeButtonStyle}"
                            Click="Minimize_Click" />
                    <Button Content="&#xE922;"
                            ToolTip="最大化"
                            Style="{StaticResource ChromeButtonStyle}"
                            Click="Maximize_Click" />
                    <Button Content="&#xE8BB;"
                            ToolTip="关闭"
                            Style="{StaticResource CloseChromeButtonStyle}"
                            Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <TextBlock Text="配方选择" Style="{StaticResource CardHeaderTextStyle}" />
                </Border>

                <Grid Grid.Row="1" Margin="16,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="配方："
                               Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Grid.Column="1"
                              Width="270"
                              Height="36"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding FunctionCheckConfigs}"
                              SelectedItem="{Binding SelectedFunctionCheckConfig}"
                              FontSize="15" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <TextBlock Text="功能检测" Style="{StaticResource CardHeaderTextStyle}" />
                </Border>

                <Grid Grid.Row="1" Margin="16,10,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="44" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding FunctionalChecks}"
                              Style="{StaticResource FunctionCheckDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="100" ElementStyle="{StaticResource FunctionCheckCellTextStyle}" />
                            <DataGridTextColumn Header="检测项" Binding="{Binding Name}" Width="300" ElementStyle="{StaticResource FunctionCheckCellTextStyle}" />
                            <DataGridTextColumn Header="期望值" Binding="{Binding ExpectedValue}" Width="130" ElementStyle="{StaticResource FunctionCheckCellTextStyle}" />
                            <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="130" ElementStyle="{StaticResource FunctionCheckCellTextStyle}" />
                            <DataGridTextColumn Header="检测日期" Binding="{Binding DetectionDate}" Width="200" ElementStyle="{StaticResource FunctionCheckCellTextStyle}" />
                            <DataGridTextColumn Header="检测结果" Binding="{Binding Result}" Width="*" ElementStyle="{StaticResource FunctionCheckCellTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2"
                            Width="130"
                            Height="36"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Command="{Binding StartFunctionCheckCommand}"
                            Style="{StaticResource PrimaryFilledButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Margin="0,0,8,0"
                                       Foreground="White"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="开始检测"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
