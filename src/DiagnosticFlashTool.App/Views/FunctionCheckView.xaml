<UserControl x:Class="DiagnosticFlashTool.App.Views.FunctionCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource PageHeaderRowStyle}" />
            <RowDefinition Style="{StaticResource PageHeaderGapRowStyle}" />
            <RowDefinition Height="120" />
            <RowDefinition Style="{StaticResource PageSectionGapRowStyle}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PageHeaderCardStyle}"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="功能检测"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="加载配方并运行检测，结果如下表所示"
                               FontSize="13"
                               Foreground="{StaticResource SubtleTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Height="36"
                            Margin="0,0,12,0"
                            Style="{StaticResource Button.ToolBar}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.ThemeLightDark}"
                                                     Style="{StaticResource Button.PackIcon}" />
                            <TextBlock Text="主题"
                                       Style="{StaticResource Button.IconLabel}" />
                        </StackPanel>
                    </Button>
                    <Button ToolTip="最小化"
                            Style="{StaticResource ChromeButtonStyle}"
                            Click="Minimize_Click">
                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.WindowMinimize}"
                                                 Style="{StaticResource Button.PackIcon}"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button ToolTip="最大化"
                            Style="{StaticResource ChromeButtonStyle}"
                            Click="Maximize_Click">
                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.WindowMaximize}"
                                                 Style="{StaticResource Button.PackIcon}"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button ToolTip="关闭"
                            Style="{StaticResource CloseChromeButtonStyle}"
                            Click="Close_Click">
                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.Close}"
                                                 Style="{StaticResource Button.PackIcon}"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <TextBlock Text="配方选择" Style="{StaticResource CardHeaderTextStyle}" />
                </Border>

                <Grid Grid.Row="1" Margin="{StaticResource PagePanelHorizontalMargin}" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="配方："
                               Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Grid.Column="1"
                              Width="270"
                              Height="36"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding FunctionCheckConfigs}"
                              SelectedItem="{Binding SelectedFunctionCheckConfig}"
                              FontSize="14" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <TextBlock Text="功能检测" Style="{StaticResource CardHeaderTextStyle}" />
                </Border>

                <Grid Grid.Row="1" Margin="{StaticResource PagePanelContentMargin}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="44" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding FunctionalChecks}"
                              Style="{StaticResource FunctionCheckDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Binding="{Binding Sequence}" Width="100" ElementStyle="{StaticResource FunctionCheckCellTextStyle}" />
                            <DataGridTextColumn Header="检测项" Binding="{Binding Name}" Width="300" ElementStyle="{StaticResource FunctionCheckCellTextStyle}" />
                            <DataGridTextColumn Header="期望值" Binding="{Binding ExpectedValue}" Width="130" ElementStyle="{StaticResource FunctionCheckCellTextStyle}" />
                            <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="130" ElementStyle="{StaticResource FunctionCheckCellTextStyle}" />
                            <DataGridTextColumn Header="检测日期" Binding="{Binding DetectionDate}" Width="200" ElementStyle="{StaticResource FunctionCheckCellTextStyle}" />
                            <DataGridTextColumn Header="检测结果" Binding="{Binding Result}" Width="*" ElementStyle="{StaticResource FunctionCheckResultCellTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2"
                            Width="130"
                            Height="36"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Command="{Binding StartFunctionCheckCommand}"
                            Style="{StaticResource Button.Primary}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.PlayCircleOutline}"
                                                     Style="{StaticResource Button.PackIcon.Inverse}" />
                            <TextBlock Text="开始检测"
                                       FontSize="14"
                                       Style="{StaticResource Button.IconLabel.Inverse}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
