<UserControl x:Class="DiagnosticFlashTool.App.Views.FlashMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card.Standard}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="刷写监控" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="实时查看设备连接、下载状态、刷写进度与 CAN 报文"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="清空报文"
                        Command="{Binding ClearFramesCommand}"
                        DockPanel.Dock="Right"
                        Width="100"
                        Style="{StaticResource Button.Danger}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card.Standard}">
                <StackPanel>
                    <TextBlock Text="设备状态" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding DeviceStatusText}"
                               Tag="{Binding DeviceStatusKind}"
                               Style="{StaticResource StatusValueTextStyle}"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,10,0,0" />
                    <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card.Standard}">
                <StackPanel>
                    <TextBlock Text="下载状态" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding DownloadStatusText}"
                               Tag="{Binding DownloadStatusKind}"
                               Style="{StaticResource StatusValueTextStyle}"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,10,0,0" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card.Standard}">
                <StackPanel>
                    <TextBlock Text="刷写进度" Foreground="{StaticResource MutedTextBrush}" />
                    <Grid Margin="0,12,0,0">
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress}"
                                     Style="{StaticResource SoftProgressBarStyle}" />
                        <TextBlock Text="{Binding ProgressText}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card.Compact}">
            <DataGrid ItemsSource="{Binding Frames}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="120" />
                    <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="70" />
                    <DataGridTextColumn Header="Ch" Binding="{Binding Channel}" Width="70" />
                    <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="140" />
                    <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="70" />
                    <DataGridTextColumn Header="Data" Binding="{Binding DataText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
