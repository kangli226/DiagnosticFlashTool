<UserControl x:Class="DiagnosticFlashTool.App.Views.FlashMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource PageHeaderRowStyle}" />
            <RowDefinition Style="{StaticResource PageHeaderGapRowStyle}" />
            <RowDefinition Style="{StaticResource PageSummaryRowStyle}" />
            <RowDefinition Style="{StaticResource PageSectionGapRowStyle}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             Title="刷写监控"
                             Subtitle="实时查看设备连接、下载状态、刷写进度与 CAN 报文">
            <controls:PageHeader.Actions>
                <Button Content="清空报文"
                        Command="{Binding ClearFramesCommand}"
                        Width="100"
                        Style="{StaticResource Button.Danger}" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Style="{StaticResource PageColumnGapStyle}" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Style="{StaticResource PageColumnGapStyle}" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PageSummaryCardStyle}">
                <StackPanel Style="{StaticResource PageSummaryContentStyle}">
                    <TextBlock Text="设备状态" Foreground="{StaticResource LabelTextBrush}" />
                    <TextBlock Text="{Binding DeviceStatusText}"
                               Tag="{Binding DeviceStatusKind}"
                               Style="{StaticResource StatusValueTextStyle}"
                               FontSize="22"
                               Margin="0,10,0,0" />
                    <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource BodyTextBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PageSummaryCardStyle}">
                <StackPanel Style="{StaticResource PageSummaryContentStyle}">
                    <TextBlock Text="下载状态" Foreground="{StaticResource LabelTextBrush}" />
                    <TextBlock Text="{Binding DownloadStatusText}"
                               Tag="{Binding DownloadStatusKind}"
                               Style="{StaticResource StatusValueTextStyle}"
                               FontSize="22"
                               Margin="0,10,0,0" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BodyTextBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource PageSummaryCardStyle}">
                <StackPanel Style="{StaticResource PageSummaryContentStyle}">
                    <TextBlock Text="刷写进度" Foreground="{StaticResource LabelTextBrush}" />
                    <Grid Margin="{StaticResource PageContentTopGap}">
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Progress}"
                                     Style="{StaticResource SoftProgressBarStyle}" />
                        <TextBlock Text="{Binding ProgressText}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource Card.Compact}">
            <DataGrid ItemsSource="{Binding Frames}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="120" />
                    <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="70" />
                    <DataGridTextColumn Header="Ch" Binding="{Binding Channel}" Width="70" />
                    <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="140" />
                    <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="70" />
                    <DataGridTextColumn Header="Data" Binding="{Binding DataText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
