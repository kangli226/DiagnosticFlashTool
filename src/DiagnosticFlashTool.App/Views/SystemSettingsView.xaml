<UserControl x:Class="DiagnosticFlashTool.App.Views.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Border Style="{StaticResource CardStyle}" Padding="18">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="实时日志" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding ConfigRootText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Content="Clear" Command="{Binding ClearLogCommand}" DockPanel.Dock="Right" Width="90" />
                </DockPanel>
                <ListBox ItemsSource="{Binding LogLines}" Style="{StaticResource LogListBoxStyle}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
