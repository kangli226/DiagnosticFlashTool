<UserControl x:Class="DiagnosticFlashTool.App.Views.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Border Style="{StaticResource Card.Standard}">
            <StackPanel>
                <TextBlock Text="系统设置" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="基础运行配置与资源路径"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="{StaticResource PageContentBottomGap}" />

                <Grid Margin="{StaticResource PageFormRowBottomGap}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="默认设备：" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DeviceTypes}"
                              SelectedItem="{Binding SelectedDeviceType}" />
                </Grid>

                <Grid Margin="{StaticResource PageFormRowBottomGap}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="默认波特率：" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding BaudRates}"
                              SelectedItem="{Binding SelectedBaudRate}" />
                </Grid>

                <Grid Margin="{StaticResource PageFormRowBottomGap}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="配置目录：" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding ConfigRootText, Mode=OneWay}"
                             IsReadOnly="True"
                             Style="{StaticResource SoftTextBoxStyle}" />
                </Grid>

                <Button Content="刷新配置"
                        Command="{Binding RefreshCommand}"
                        Width="100"
                        HorizontalAlignment="Left"
                        Style="{StaticResource Button.Normal}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
