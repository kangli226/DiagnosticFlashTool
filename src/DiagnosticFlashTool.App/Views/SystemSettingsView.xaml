<UserControl x:Class="DiagnosticFlashTool.App.Views.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource PageHeaderRowStyle}" />
            <RowDefinition Style="{StaticResource PageHeaderGapRowStyle}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PageHeaderCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="系统设置"
                               Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="配置 CAN 连接、运行路径、日志与管理员模式"
                               Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Width="112"
                        Margin="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Button.ConnectionAction}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.HelpRhombusOutline}"
                                                 Width="16"
                                                 Height="16"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 VerticalAlignment="Center" />
                        <TextBlock Text="帮助文档"
                                   Style="{StaticResource Button.IconLabel}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource PageLeadStandardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="基础设置" Style="{StaticResource CardHeaderTextStyle}" Margin="0,0,0,14" />

                        <Grid Margin="{StaticResource PageContentBottomGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="夜间模式" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding NightModeEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource SoftSwitchStyle}" />
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="后台运行" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding KeepRunningInTray, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource SoftSwitchStyle}" />
                                <TextBlock Grid.Column="3"
                                           Text="关闭窗口时驻留到系统托盘"
                                           Style="{StaticResource HintTextStyle}" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageLeadStandardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="CAN 连接" Style="{StaticResource CardHeaderTextStyle}" Margin="0,0,0,14" />

                        <Grid Margin="{StaticResource PageContentBottomGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CAN 设备类型" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding DeviceTypes}"
                                      SelectedItem="{Binding SelectedDeviceType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource SoftComboBoxStyle}" />
                        </Grid>

                        <Grid Margin="{StaticResource PageContentBottomGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="自动连接" Style="{StaticResource FieldLabelStyle}" />
                            <ToggleButton Grid.Column="1"
                                          IsChecked="{Binding AutoFlashEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource SoftSwitchStyle}" />
                            <TextBlock Grid.Column="3"
                                       Text="开启后软件启动自动进入刷写模式"
                                       Style="{StaticResource HintTextStyle}" />
                        </Grid>

                        <Grid Margin="{StaticResource PageContentBottomGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="波特率搜索" Style="{StaticResource FieldLabelStyle}" />
                            <ToggleButton Grid.Column="1"
                                          IsChecked="{Binding AutoSearchBaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource SoftSwitchStyle}" />
                            <TextBlock Grid.Column="3"
                                       Text="启动连接时自动搜索并更新刷写波特率，用户不可手动修改"
                                       Style="{StaticResource HintTextStyle}" />
                        </Grid>

                        <Grid Margin="{StaticResource PageContentBottomGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="设备通道" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding CanChannels}"
                                      SelectedItem="{Binding SelectedCanChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource SoftComboBoxStyle}" />
                        </Grid>

                        <Grid Margin="{StaticResource PageContentBottomGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="刷写波特率" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding BaudRates}"
                                      SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource SoftComboBoxStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AutoSearchBaudRate}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="连接状态" Style="{StaticResource FieldLabelStyle}" />
                            <Border Grid.Column="1"
                                    MinWidth="176"
                                    Style="{StaticResource InlineStatusValueBorderStyle}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DeviceStatusIcon}"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ConnectionSummaryText}"
                                               Style="{StaticResource InlineStatusValueTextStyle}"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="3"
                                    Command="{Binding ToggleConnectionCommand}"
                                    Tag="{Binding IsConnected}"
                                    Style="{StaticResource Button.ConnectionAction}"
                                    Width="110"
                                    Height="32"
                                    Margin="0">
                                <TextBlock Text="{Binding ConnectionActionText}" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageLeadStandardCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="运行配置管理" Style="{StaticResource CardHeaderTextStyle}" />
                            <Button Grid.Column="1"
                                    Command="{Binding ImportBuiltinConfigurationCommand}"
                                    Style="{StaticResource Button.Normal}"
                                    Height="32"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.CloudDownloadOutline}"
                                                             Style="{StaticResource Button.PackIcon.Accent}" />
                                    <TextBlock Text="导入内置配置" Style="{StaticResource Button.IconLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding ClearRuntimeConfigurationCommand}"
                                    Style="{StaticResource Button.Normal}"
                                    Height="32"
                                    Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.DeleteOutline}"
                                                             Style="{StaticResource Button.PackIcon.Accent}" />
                                    <TextBlock Text="清空全部配置"
                                               Style="{StaticResource Button.IconLabel}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Margin="{StaticResource PageContentBottomGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="流程配置" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding FlowConfigDirectory, Mode=OneWay}"
                                     Style="{StaticResource PathTextBoxStyle}" />
                            <Button Grid.Column="2"
                                    Command="{Binding OpenFlowConfigDirectoryCommand}"
                                    Style="{StaticResource Button.Compact}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderOpenOutline}" Width="16" Height="16" />
                                    <TextBlock Text="打开" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    Command="{Binding ChooseFlowConfigDirectoryCommand}"
                                    Style="{StaticResource Button.Compact}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderCogOutline}" Width="16" Height="16" />
                                    <TextBlock Text="选择" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Margin="{StaticResource PageContentBottomGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="配方数据库" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding FormulaDatabaseDirectory, Mode=OneWay}"
                                     Style="{StaticResource PathTextBoxStyle}" />
                            <Button Grid.Column="2"
                                    Command="{Binding OpenFormulaDatabaseDirectoryCommand}"
                                    Style="{StaticResource Button.Compact}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderOpenOutline}" Width="16" Height="16" />
                                    <TextBlock Text="打开" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    Command="{Binding ChooseFormulaDatabaseDirectoryCommand}"
                                    Style="{StaticResource Button.Compact}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderCogOutline}" Width="16" Height="16" />
                                    <TextBlock Text="选择" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="项目配置" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding ProjectConfigPath, Mode=OneWay}"
                                     Style="{StaticResource PathTextBoxStyle}" />
                            <Button Grid.Column="2"
                                    Command="{Binding OpenProjectConfigDirectoryCommand}"
                                    Style="{StaticResource Button.Compact}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderOpenOutline}" Width="16" Height="16" />
                                    <TextBlock Text="打开" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    Command="{Binding ChooseProjectConfigFileCommand}"
                                    Style="{StaticResource Button.Compact}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderCogOutline}" Width="16" Height="16" />
                                    <TextBlock Text="选择" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageLeadStandardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="日志" Style="{StaticResource CardHeaderTextStyle}" Margin="0,0,0,14" />

                        <Grid Margin="{StaticResource PageContentBottomGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="保存到文件" Style="{StaticResource FieldLabelStyle}" />
                            <ToggleButton Grid.Column="1"
                                          IsChecked="{Binding LogFileEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource SoftSwitchStyle}" />
                            <TextBlock Grid.Column="3"
                                       Text="更改后重启生效"
                                       Style="{StaticResource HintTextStyle}" />
                        </Grid>

                        <Grid Margin="{StaticResource PageContentBottomGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="保存地址" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding LogFilePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     IsEnabled="{Binding LogFileEnabled}"
                                     Style="{StaticResource SoftTextBoxStyle}" />
                            <Button Grid.Column="2"
                                    Command="{Binding OpenLogDirectoryCommand}"
                                    IsEnabled="{Binding LogFileEnabled}"
                                    Style="{StaticResource Button.Compact}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderOpenOutline}" Width="16" Height="16" />
                                    <TextBlock Text="打开" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="运行日志" Style="{StaticResource FieldLabelStyle}" />
                            <Button Grid.Column="1"
                                    Command="{Binding OpenRuntimeLogPageCommand}"
                                    Style="{StaticResource Button.Normal}"
                                    Height="32"
                                    Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.TextBoxOutline}"
                                                             Width="16"
                                                             Height="16" />
                                    <TextBlock Text="查看日志" Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageLeadStandardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="6"
                                   Text="管理员模式"
                                   Style="{StaticResource CardHeaderTextStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="状态" Style="{StaticResource FieldLabelStyle}" />
                        <ToggleButton Grid.Row="2"
                                      Grid.Column="1"
                                      IsChecked="{Binding AdminModeEnabled, Mode=OneWay}"
                                      Click="AdminModeToggle_Click"
                                      Style="{StaticResource SoftSwitchStyle}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="3"
                                   Text="{Binding AdminModeStatusText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ConfigValueTextStyle}">
                                    <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AdminModeEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Row="2"
                                   Grid.Column="5"
                                   Text="开启后显示配方配置、开发者选项、流程配置、项目配置。"
                                   Style="{StaticResource HintTextStyle}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="AdminPasswordOverlay"
                Grid.RowSpan="3"
                Visibility="Collapsed"
                Background="#66000000">
            <Border Width="380"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogPanelStyle}">
                <StackPanel>
                    <TextBlock Text="启动管理员模式"
                               Style="{StaticResource CardHeaderTextStyle}"
                               Margin="0,0,0,10" />
                    <TextBlock Text="请输入管理员密码，本次启动内有效。"
                               Style="{StaticResource HintTextStyle}"
                               Margin="0,0,0,12" />
                    <PasswordBox x:Name="AdminPasswordBox"
                                 Height="32"
                                 Padding="10,4"
                                 PasswordChar="*"
                                 KeyDown="AdminPasswordBox_KeyDown"
                                 Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消"
                                Click="CancelAdminPassword_Click"
                                Style="{StaticResource Button.Normal}"
                                Width="78"
                                Height="32"
                                Margin="0,0,8,0" />
                        <Button Click="SubmitAdminPassword_Click"
                                Style="{StaticResource Button.Primary}"
                                Height="32"
                                Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.ShieldAccountOutline}"
                                                         Style="{StaticResource Button.PackIcon.Inverse}" />
                                <TextBlock Text="启动管理员模式" Style="{StaticResource Button.IconLabel.Inverse}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
