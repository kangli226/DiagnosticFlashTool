<UserControl x:Class="DiagnosticFlashTool.App.Views.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource PageHeaderRowStyle}" />
            <RowDefinition Style="{StaticResource PageHeaderGapRowStyle}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             Title="系统设置"
                             Subtitle="配置 CAN 连接、运行路径、日志与管理员模式">
            <controls:PageHeader.Actions>
                <controls:PageHelpDocumentButton />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource PageLeadStandardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="基础设置" Style="{StaticResource CardHeaderTextStyle}" Margin="0,0,0,14" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="夜间模式" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding NightModeEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource SoftSwitchStyle}" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding PageModeStatusText}"
                                           Style="{StaticResource SettingAssistTextStyle}" />
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="后台运行" Style="{StaticResource FieldLabelStyle}" />
                                <ToggleButton Grid.Column="1"
                                              IsChecked="{Binding KeepRunningInTray, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource SoftSwitchStyle}" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding KeepRunningInTrayStatusText}"
                                           Style="{StaticResource SettingAssistTextStyle}" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageLeadStandardCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="CAN 连接"
                                       Style="{StaticResource CardHeaderTextStyle}"
                                       VerticalAlignment="Center" />

                            <Border Grid.Column="1"
                                    MinWidth="176"
                                    Tag="{Binding DeviceStatusKind}"
                                    Style="{StaticResource StatusBadgeBorderStyle}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Tag="{Binding DeviceStatusKind}"
                                             Style="{StaticResource StatusDotStyle}" />
                                    <TextBlock Text="{Binding ConnectionSummaryText}"
                                               Tag="{Binding DeviceStatusKind}"
                                               Style="{StaticResource StatusBadgeTextStyle}"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                            </Border>

                            <Button Grid.Column="3"
                                    Command="{Binding ToggleConnectionCommand}"
                                    Tag="{Binding IsConnected}"
                                    Style="{StaticResource Button.ConnectionPrimaryAction}"
                                    Width="126"
                                    VerticalAlignment="Center">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.PowerPlugOutline}"
                                                             Style="{StaticResource Button.PackIcon.Current}" />
                                    <TextBlock Text="{Binding ConnectionActionText}"
                                               Style="{StaticResource Button.IconLabel}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource SettingGroupPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="设备设置"
                                               Style="{StaticResource SettingGroupTitleTextStyle}" />

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="CAN 设备类型" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox Grid.Column="1"
                                                  Width="Auto"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding DeviceTypes}"
                                                  SelectedItem="{Binding SelectedDeviceType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource StandardComboBoxStyle}" />
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="自动连接"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   FontWeight="Normal" />
                                        <ToggleButton Grid.Column="1"
                                                      IsChecked="{Binding AutoFlashEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource SoftSwitchStyle}" />
                                        <TextBlock Grid.Column="3"
                                                   Text="启动后自动进入刷写模式"
                                                   Style="{StaticResource SettingAssistTextStyle}" />
                                    </Grid>

                                    <Grid Grid.Row="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="设备通道" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox Grid.Column="1"
                                                  Width="Auto"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding CanChannels}"
                                                  SelectedItem="{Binding SelectedCanChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource StandardComboBoxStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource SettingGroupPanelStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="波特率设置"
                                               Style="{StaticResource SettingGroupTitleTextStyle}" />

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="自动搜索"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   FontWeight="Normal" />
                                        <ToggleButton Grid.Column="1"
                                                      IsChecked="{Binding AutoSearchBaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource SoftSwitchStyle}" />
                                        <TextBlock Grid.Column="3"
                                                   Text="连接时自动搜索并更新刷写波特率"
                                                   Style="{StaticResource SettingAssistTextStyle}" />
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="刷写波特率" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox Grid.Column="1"
                                                  Width="Auto"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding BaudRates}"
                                                  SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource StandardComboBoxStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AutoSearchBaudRate}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                    </Grid>

                                    <TextBlock Grid.Row="6"
                                               Margin="{StaticResource FormAssistTextAfterLabelMargin}"
                                               Text="启用自动搜索时，刷写波特率不可手动修改"
                                               Style="{StaticResource SettingAssistTextStyle}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PageLeadStandardCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="运行配置管理" Style="{StaticResource CardHeaderTextStyle}" />
                            <Button Grid.Column="1"
                                    Command="{Binding ImportBuiltinConfigurationCommand}"
                                    Style="{StaticResource Button.Normal}"
                                    Height="32"
                                    Margin="0,0,8,0">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.CloudDownloadOutline}"
                                                             Style="{StaticResource Button.PackIcon.Accent}" />
                                    <TextBlock Text="导入内置配置" Style="{StaticResource Button.IconLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding ClearRuntimeConfigurationCommand}"
                                    Style="{StaticResource Button.Normal}"
                                    Height="32"
                                    Margin="0">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.DeleteOutline}"
                                                             Style="{StaticResource Button.PackIcon.Accent}" />
                                    <TextBlock Text="清空全部配置"
                                               Style="{StaticResource Button.IconLabel}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="流程配置" Style="{StaticResource FieldLabelStyle}" />
                            <Border Grid.Column="1"
                                    Style="{StaticResource PathDisplayBorderStyle}"
                                    ToolTip="{Binding FlowConfigDirectory}">
                                <TextBlock Text="{Binding FlowConfigDirectory, Mode=OneWay}"
                                           Style="{StaticResource PathDisplayTextStyle}" />
                            </Border>
                            <Button Grid.Column="2"
                                    Command="{Binding OpenFlowConfigDirectoryCommand}"
                                    Style="{StaticResource Button.PathAction}">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderOpenOutline}"
                                                             Style="{StaticResource Button.PathActionIcon}" />
                                    <TextBlock Text="打开" Style="{StaticResource Button.PathActionLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    Command="{Binding ChooseFlowConfigDirectoryCommand}"
                                    Style="{StaticResource Button.PathAction}">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderCogOutline}"
                                                             Style="{StaticResource Button.PathActionIcon}" />
                                    <TextBlock Text="选择" Style="{StaticResource Button.PathActionLabel}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="配方数据库" Style="{StaticResource FieldLabelStyle}" />
                            <Border Grid.Column="1"
                                    Style="{StaticResource PathDisplayBorderStyle}"
                                    ToolTip="{Binding FormulaDatabaseDirectory}">
                                <TextBlock Text="{Binding FormulaDatabaseDirectory, Mode=OneWay}"
                                           Style="{StaticResource PathDisplayTextStyle}" />
                            </Border>
                            <Button Grid.Column="2"
                                    Command="{Binding OpenFormulaDatabaseDirectoryCommand}"
                                    Style="{StaticResource Button.PathAction}">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderOpenOutline}"
                                                             Style="{StaticResource Button.PathActionIcon}" />
                                    <TextBlock Text="打开" Style="{StaticResource Button.PathActionLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    Command="{Binding ChooseFormulaDatabaseDirectoryCommand}"
                                    Style="{StaticResource Button.PathAction}">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderCogOutline}"
                                                             Style="{StaticResource Button.PathActionIcon}" />
                                    <TextBlock Text="选择" Style="{StaticResource Button.PathActionLabel}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="项目配置" Style="{StaticResource FieldLabelStyle}" />
                            <Border Grid.Column="1"
                                    Style="{StaticResource PathDisplayBorderStyle}"
                                    ToolTip="{Binding ProjectConfigPath}">
                                <TextBlock Text="{Binding ProjectConfigPath, Mode=OneWay}"
                                           Style="{StaticResource PathDisplayTextStyle}" />
                            </Border>
                            <Button Grid.Column="2"
                                    Command="{Binding OpenProjectConfigDirectoryCommand}"
                                    Style="{StaticResource Button.PathAction}">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderOpenOutline}"
                                                             Style="{StaticResource Button.PathActionIcon}" />
                                    <TextBlock Text="打开" Style="{StaticResource Button.PathActionLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    Command="{Binding ChooseProjectConfigFileCommand}"
                                    Style="{StaticResource Button.PathAction}">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderCogOutline}"
                                                             Style="{StaticResource Button.PathActionIcon}" />
                                    <TextBlock Text="选择" Style="{StaticResource Button.PathActionLabel}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageLeadStandardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="日志存储" Style="{StaticResource CardHeaderTextStyle}" Margin="0,0,0,14" />

                        <Grid Margin="{StaticResource PageContentBottomGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="保存到文件" Style="{StaticResource FieldLabelStyle}" />
                            <ToggleButton Grid.Column="1"
                                          IsChecked="{Binding LogFileEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource SoftSwitchStyle}" />
                            <TextBlock Grid.Column="3"
                                       Text="开启后写入本地日志文件"
                                       Style="{StaticResource SettingAssistTextStyle}" />
                        </Grid>

                        <Grid Margin="{StaticResource PageContentBottomGap}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="日志文件" Style="{StaticResource FieldLabelStyle}" />
                            <Border Grid.Column="1"
                                    Style="{StaticResource PathDisplayBorderStyle}"
                                    ToolTip="{Binding LogFilePath}">
                                <TextBlock Text="{Binding LogFilePath, Mode=OneWay}"
                                           Style="{StaticResource PathDisplayTextStyle}" />
                            </Border>
                            <Button Grid.Column="2"
                                    Command="{Binding OpenLogDirectoryCommand}"
                                    Style="{StaticResource Button.PathAction}">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderOpenOutline}"
                                                             Style="{StaticResource Button.PathActionIcon}" />
                                    <TextBlock Text="打开目录" Style="{StaticResource Button.PathActionLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    Command="{Binding ChooseLogFileCommand}"
                                    Style="{StaticResource Button.PathAction}">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderCogOutline}"
                                                             Style="{StaticResource Button.PathActionIcon}" />
                                    <TextBlock Text="选择文件" Style="{StaticResource Button.PathActionLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4"
                                    Command="{Binding RestoreDefaultLogStorageCommand}"
                                    Style="{StaticResource Button.PathAction}">
                                <TextBlock Text="恢复默认"
                                           FontWeight="Medium"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="日志保留" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Width="64"
                                     Height="32"
                                     TextAlignment="Right"
                                     Text="{Binding LogRetentionDays, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource SoftTextBoxStyle}" />
                            <TextBlock Grid.Column="3"
                                       Text="天"
                                       Style="{StaticResource SettingAssistTextStyle}" />
                            <TextBlock Grid.Column="5"
                                       Text="单文件上限"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="6"
                                     Width="64"
                                     Height="32"
                                     TextAlignment="Right"
                                     Text="{Binding LogMaxFileSizeMb, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource SoftTextBoxStyle}" />
                            <TextBlock Grid.Column="8"
                                       Text="MB"
                                       Style="{StaticResource SettingAssistTextStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PageLeadStandardCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="6"
                                   Text="管理员模式"
                                   Style="{StaticResource CardHeaderTextStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="状态" Style="{StaticResource FieldLabelStyle}" />
                        <ToggleButton Grid.Row="2"
                                      Grid.Column="1"
                                      IsChecked="{Binding AdminModeEnabled, Mode=OneWay}"
                                      Command="{Binding ShowAdminPasswordCommand}"
                                      Style="{StaticResource SoftSwitchStyle}" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="3"
                                   Text="{Binding AdminModeStatusText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ConfigValueTextStyle}">
                                    <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AdminModeEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Row="2"
                                   Grid.Column="5"
                                   Text="开启后显示配方配置、开发者选项、流程配置、项目配置。"
                                   Style="{StaticResource HintTextStyle}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.RowSpan="3">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource DialogOverlayStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AdminPasswordPromptVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border Width="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogPanelStyle}">
                <StackPanel>
                    <TextBlock Text="启动管理员模式"
                               Style="{StaticResource CardHeaderTextStyle}"
                               Margin="0,0,0,10" />
                    <TextBlock Text="{Binding AdminPasswordMessage}"
                               Style="{StaticResource HintTextStyle}"
                               Margin="0,0,0,12" />
                    <PasswordBox Style="{StaticResource DialogPasswordBoxStyle}"
                                 controls:PasswordBoxBinding.BoundPassword="{Binding AdminPassword, Mode=TwoWay}">
                        <PasswordBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SubmitAdminPasswordCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CancelAdminPasswordCommand}" />
                        </PasswordBox.InputBindings>
                    </PasswordBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消"
                                Command="{Binding CancelAdminPasswordCommand}"
                                Style="{StaticResource Button.DialogSecondary}" />
                        <Button Command="{Binding SubmitAdminPasswordCommand}"
                                Style="{StaticResource Button.DialogPrimary}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.ShieldAccountOutline}"
                                                         Style="{StaticResource Button.PackIcon.Current}" />
                                <TextBlock Text="启动管理员模式" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
