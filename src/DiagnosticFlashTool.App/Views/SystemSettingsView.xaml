   <UserControl x:Class="DiagnosticFlashTool.App.Views.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource PageHeaderRowStyle}" />
            <RowDefinition Style="{StaticResource PageHeaderGapRowStyle}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Style="{StaticResource PageHeader.Standard}" Breadcrumb="系统" Title="系统设置">
            <controls:PageHeader.Actions>
                <controls:PageHelpDocumentButton Style="{StaticResource PageHelpDocumentButton.Standard}" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <controls:HeaderedCard Header="基础设置"
                                       Style="{StaticResource HeaderedCard.Form.Lead}">
                    <controls:CardContentPanel Style="{StaticResource Card.FormRowsContent}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Style="{StaticResource PageColumnGapStyle}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="后台运行" Style="{StaticResource FieldLabelStyle}" />
                            <ToggleButton Grid.Column="1"
                                          IsChecked="{Binding KeepRunningInTray, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource SoftSwitchStyle}" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding KeepRunningInTrayStatusText}"
                                       Style="{StaticResource SettingAssistTextStyle}" />
                        </Grid>
                    </controls:CardContentPanel>
                </controls:HeaderedCard>

                <controls:HeaderedCard Header="CAN 适配器设置"
                                       Style="{StaticResource HeaderedCard.Form.Lead}">
                    <controls:CardContentPanel Style="{StaticResource Card.FormRowsContent}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="设备类型" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Column="1"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding DeviceTypes}"
                                      SelectedItem="{Binding SelectedDeviceType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource StandardComboBoxStyle}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="设备通道" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox Grid.Column="1"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding CanChannels}"
                                      SelectedItem="{Binding SelectedCanChannel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource StandardComboBoxStyle}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Style="{StaticResource PageColumnGapStyle}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="自动连接" Style="{StaticResource FieldLabelStyle}" />
                            <ToggleButton Grid.Column="1"
                                          IsChecked="{Binding AutoFlashEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource SoftSwitchStyle}" />
                            <TextBlock Grid.Column="3"
                                       Text="软件启动后使用上述设备和通道自动连接"
                                       Style="{StaticResource SettingAssistTextStyle}" />
                        </Grid>
                    </controls:CardContentPanel>
                </controls:HeaderedCard>

                <controls:HeaderedCard Header="运行配置管理"
                                       Style="{StaticResource HeaderedCard.Form.Actions.Lead}">
                    <controls:HeaderedCard.Actions>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding ImportBuiltinConfigurationCommand}"
                                    Style="{StaticResource Button.ToolBar}">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <controls:FluentIcon Kind="CloudDownloadOutline"
                                                             Style="{StaticResource Button.Glyph.Current}" />
                                    <TextBlock Text="导入" Style="{StaticResource Button.IconLabel}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ClearRuntimeConfigurationCommand}"
                                    Style="{StaticResource Button.DestructiveToolBar}"
                                    Margin="0">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <controls:FluentIcon Kind="DeleteOutline"
                                                             Style="{StaticResource Button.Glyph.Current}" />
                                    <TextBlock Text="清空"
                                               Style="{StaticResource Button.IconLabel}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:HeaderedCard.Actions>

                    <controls:CardContentPanel Style="{StaticResource Card.FormRowsContent}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="应用数据" Style="{StaticResource PathDisplayLabelStyle}" />
                            <Border Grid.Row="0" Grid.Column="1"
                                    Tag="{Binding ApplicationDataDirectoryStatusKind}"
                                    Style="{StaticResource PathDisplayBorderStyle}"
                                    ToolTip="{Binding ApplicationDataDirectory}">
                                <TextBlock Text="{Binding ApplicationDataDirectoryDisplay, Mode=OneWay}"
                                           Style="{StaticResource PathDisplayTextStyle}" />
                            </Border>
                            <controls:PathActionSplitButton Grid.Row="0" Grid.Column="2"
                                                            PrimaryCommand="{Binding OpenApplicationDataDirectoryCommand}"
                                                            ChangeCommand="{Binding ChooseApplicationDataDirectoryCommand}"
                                                            ChangeLabel="更改目录…" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                       Text="更改后，未单独指定的项目、流程及脚本配置随目录切换；原目录内容保留，新目录仅补充缺失的内置配置。"
                                       Style="{StaticResource SettingAssistTextStyle}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="流程配置" Style="{StaticResource PathDisplayLabelStyle}" />
                            <Border Grid.Column="1"
                                    Tag="{Binding FlowConfigDirectoryStatusKind}"
                                    Style="{StaticResource PathDisplayBorderStyle}"
                                    ToolTip="{Binding FlowConfigDirectory}">
                                <TextBlock Text="{Binding FlowConfigDirectoryDisplay, Mode=OneWay}"
                                           Style="{StaticResource PathDisplayTextStyle}" />
                            </Border>
                            <controls:PathActionSplitButton Grid.Column="2"
                                                            PrimaryCommand="{Binding OpenFlowConfigDirectoryCommand}"
                                                            ChangeCommand="{Binding ChooseFlowConfigDirectoryCommand}"
                                                            ChangeLabel="更改目录…" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="项目配置" Style="{StaticResource PathDisplayLabelStyle}" />
                            <Border Grid.Column="1"
                                    Tag="{Binding ProjectConfigPathStatusKind}"
                                    Style="{StaticResource PathDisplayBorderStyle}"
                                    ToolTip="{Binding ProjectConfigPath}">
                                <TextBlock Text="{Binding ProjectConfigPathDisplay, Mode=OneWay}"
                                           Style="{StaticResource PathDisplayTextStyle}" />
                            </Border>
                            <controls:PathActionSplitButton Grid.Column="2"
                                                            PrimaryCommand="{Binding OpenProjectConfigDirectoryCommand}"
                                                            ChangeCommand="{Binding ChooseProjectConfigFileCommand}"
                                                            ChangeLabel="更改文件…" />
                        </Grid>
                    </controls:CardContentPanel>
                </controls:HeaderedCard>

                <controls:HeaderedCard Header="日志存储"
                                       Style="{StaticResource HeaderedCard.Form}">
                    <controls:CardContentPanel Style="{StaticResource Card.FormRowsContent}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Style="{StaticResource PageColumnGapStyle}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="保存到文件" Style="{StaticResource FieldLabelStyle}" />
                            <ToggleButton Grid.Column="1"
                                          IsChecked="{Binding LogFileEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource SoftSwitchStyle}" />
                            <TextBlock Grid.Column="3"
                                       Text="开启后写入本地日志文件"
                                       Style="{StaticResource SettingAssistTextStyle}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="日志文件" Style="{StaticResource PathDisplayLabelStyle}" />
                            <Border Grid.Column="1"
                                    Tag="{Binding LogFileStatusKind}"
                                    Style="{StaticResource PathDisplayBorderStyle}"
                                    ToolTip="{Binding LogFilePath}">
                                <TextBlock Text="{Binding LogFilePath, Mode=OneWay}"
                                           Style="{StaticResource PathDisplayTextStyle}" />
                            </Border>
                            <controls:PathActionSplitButton Grid.Column="2"
                                                            PrimaryCommand="{Binding OpenLogDirectoryCommand}"
                                                            ChangeCommand="{Binding ChooseLogFileCommand}"
                                                            ChangeLabel="更改文件…" />
                            <Button Grid.Column="3"
                                    Command="{Binding RestoreDefaultLogStorageCommand}"
                                    Style="{StaticResource Button.PathAction}">
                                <TextBlock Text="恢复默认"
                                           FontWeight="Medium"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Style="{StaticResource PageColumnGapStyle}" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Style="{StaticResource PageColumnGapStyle}" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="日志保留" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Width="64"
                                     Height="32"
                                     TextAlignment="Right"
                                     Text="{Binding LogRetentionDays, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource SoftTextBoxStyle}" />
                            <TextBlock Grid.Column="3"
                                       Text="天"
                                       Style="{StaticResource SettingAssistTextStyle}" />
                            <TextBlock Grid.Column="5"
                                       Text="单文件上限"
                                       Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="6"
                                     Width="64"
                                     Height="32"
                                     TextAlignment="Right"
                                     Text="{Binding LogMaxFileSizeMb, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource SoftTextBoxStyle}" />
                            <TextBlock Grid.Column="8"
                                       Text="MB"
                                       Style="{StaticResource SettingAssistTextStyle}" />
                        </Grid>
                    </controls:CardContentPanel>
                </controls:HeaderedCard>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
