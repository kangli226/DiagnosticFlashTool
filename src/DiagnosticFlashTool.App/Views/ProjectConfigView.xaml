<UserControl x:Class="DiagnosticFlashTool.App.Views.ProjectConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <Grid Style="{StaticResource PageRootGridStyle}">
        <!-- 全部项目配置：左侧项目列表，右侧固定宽编辑区；两栏之间只保留列间距。 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Style="{StaticResource PageColumnGapStyle}" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <controls:HeaderedCard Grid.Column="0"
                                   Header="全部项目配置"
                                   Style="{StaticResource HeaderedCard.Data.Actions}">
                <controls:HeaderedCard.Actions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding RefreshProjectsCommand}"
                                Style="{StaticResource Button.Normal}"
                                ToolTip="重新读取项目配置列表">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="Refresh"
                                                     Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="刷新" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NewProjectCommand}"
                                Visibility="{Binding IsSystemAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource Button.Normal}"
                                ToolTip="新建项目配置">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="Plus"
                                                     Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="新增项目" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding EditProjectCommand}"
                                Margin="0"
                                Style="{StaticResource Button.Normal}"
                                ToolTip="编辑选中项目（也可双击列表项）">
                            <TextBlock Text="编辑"
                                       Style="{StaticResource Button.IconLabel}"
                                       Margin="0" />
                        </Button>
                    </StackPanel>
                </controls:HeaderedCard.Actions>

                <Grid>
                    <DataGrid ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              IsReadOnly="True"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditProjectCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="项目名称" Binding="{Binding ProjectName}" Width="*" MinWidth="130" ElementStyle="{StaticResource DataGrid.CellText}" />
                            <DataGridTextColumn Header="项目码" Binding="{Binding ProjectNo}" Width="56" ElementStyle="{StaticResource DataGrid.MonoCellText}" />
                            <DataGridTextColumn Header="波特率" Binding="{Binding BaudRate}" Width="56" ElementStyle="{StaticResource DataGrid.MonoCellText}" />
                            <DataGridTextColumn Header="物理请求" Binding="{Binding PhysicalRequestId}" Width="90" ElementStyle="{StaticResource DataGrid.MonoCellText}" />
                            <DataGridTextColumn Header="功能请求" Binding="{Binding FunctionalRequestId}" Width="90" ElementStyle="{StaticResource DataGrid.MonoCellText}" />
                            <DataGridTextColumn Header="响应地址" Binding="{Binding ResponseAddressId}" Width="90" ElementStyle="{StaticResource DataGrid.MonoCellText}" />
                            <DataGridTemplateColumn Header="BOOT 配置" Width="108">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BootConfigFile, Converter={StaticResource FileNameConverter}}"
                                                   ToolTip="{Binding BootConfigFile}"
                                                   Style="{StaticResource DataGrid.CellText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="CAN 协议" Binding="{Binding CanProtocol}" Width="64" ElementStyle="{StaticResource DataGrid.CellText}" />
                            <DataGridTemplateColumn Width="64">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Driver"
                                               FontSize="{StaticResource FontSize.Caption}"
                                               ToolTip="Driver 文件是否可用"
                                               Foreground="{StaticResource SubtleTextBrush}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding DriverFileStatusText}">
                                            <TextBlock Text="-">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGrid.StatusText}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DriverFileStatusIcon}" Value="-">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <controls:FluentIcon Kind="Check"
                                                                 Foreground="{StaticResource StatusSuccessBrush}">
                                                <controls:FluentIcon.Style>
                                                    <Style TargetType="{x:Type controls:FluentIcon}" BasedOn="{StaticResource DataGrid.StatusIcon}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDriverFileAvailable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:FluentIcon.Style>
                                            </controls:FluentIcon>
                                            <controls:FluentIcon Kind="CloseCircleOutline"
                                                                 Foreground="{StaticResource StatusErrorBrush}">
                                                <controls:FluentIcon.Style>
                                                    <Style TargetType="{x:Type controls:FluentIcon}" BasedOn="{StaticResource DataGrid.StatusIcon}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDriverFileError}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:FluentIcon.Style>
                                            </controls:FluentIcon>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="52">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="App"
                                               FontSize="{StaticResource FontSize.Caption}"
                                               ToolTip="App 文件是否可用"
                                               Foreground="{StaticResource SubtleTextBrush}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding ApplicationFileStatusText}">
                                            <TextBlock Text="-">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGrid.StatusText}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ApplicationFileStatusIcon}" Value="-">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <controls:FluentIcon Kind="Check"
                                                                 Foreground="{StaticResource StatusSuccessBrush}">
                                                <controls:FluentIcon.Style>
                                                    <Style TargetType="{x:Type controls:FluentIcon}" BasedOn="{StaticResource DataGrid.StatusIcon}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApplicationFileAvailable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:FluentIcon.Style>
                                            </controls:FluentIcon>
                                            <controls:FluentIcon Kind="CloseCircleOutline"
                                                                 Foreground="{StaticResource StatusErrorBrush}">
                                                <controls:FluentIcon.Style>
                                                    <Style TargetType="{x:Type controls:FluentIcon}" BasedOn="{StaticResource DataGrid.StatusIcon}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApplicationFileError}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:FluentIcon.Style>
                                            </controls:FluentIcon>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 列表空状态：不占位、不拦截点击，下一步仍走卡片标题行的“新增项目”。 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="暂无项目配置" Style="{StaticResource EmptyStateTitleTextStyle}" />
                        <TextBlock Text="点击上方“新增项目”创建第一条项目配置。"
                                   Style="{StaticResource HintTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </controls:HeaderedCard>

            <Grid Grid.Column="2">
                <!-- 未打开编辑时的空状态：不保留空表单框架，只说明下一步。 -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="300">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProjectEditorVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="未打开项目详情"
                               Style="{StaticResource EmptyStateTitleTextStyle}" />
                    <TextBlock Text="在左侧列表选择项目后双击，或点击工具栏“编辑”查看与修改配置。"
                               Style="{StaticResource HintTextStyle}"
                               TextAlignment="Center"
                               Margin="0,6,0,0" />
                    <Button Command="{Binding NewProjectCommand}"
                            Visibility="{Binding IsSystemAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource Button.Normal}"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0">
                        <StackPanel Style="{StaticResource Button.InlineContent}">
                            <controls:FluentIcon Kind="Plus"
                                                 Style="{StaticResource Button.Glyph.Current}" />
                            <TextBlock Text="新增项目" Style="{StaticResource Button.IconLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 详情面板不铺满白色：面板底用页面底色，只有输入框保持白底，减少大面积纯白与深色框架的对比。 -->
                <controls:HeaderedCard Header="{Binding ProjectEditorTitle}"
                                       Background="{StaticResource AppBackgroundBrush}">
                    <controls:HeaderedCard.Style>
                        <Style TargetType="{x:Type controls:HeaderedCard}"
                               BasedOn="{StaticResource HeaderedCard.Form}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProjectEditorVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:HeaderedCard.Style>
                    <controls:HeaderedCard.Actions>
                        <Button Command="{Binding CancelProjectEditorCommand}"
                                Width="26"
                                Height="26"
                                Padding="0"
                                Margin="0"
                                Style="{StaticResource Button.Normal}"
                                ToolTip="关闭编辑">
                            <controls:FluentIcon Kind="Close"
                                                 Style="{StaticResource Button.Glyph.Current}" />
                        </Button>
                    </controls:HeaderedCard.Actions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden">
                            <controls:CardContentPanel Style="{StaticResource Card.FormRowsContent}"
                                                       IsEnabled="{Binding CanChangeWorkspace}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="项目名称" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             Height="26"
                                             Text="{Binding ProjectEditor.ProjectName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SoftTextBoxStyle}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="项目码" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             Height="26"
                                             Text="{Binding ProjectEditor.ProjectNoText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SoftTextBoxStyle}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="物理请求" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             Height="26"
                                             Text="{Binding ProjectEditor.PhysicalRequestId, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MonoTextBoxStyle}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="响应地址" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             Height="26"
                                             Text="{Binding ProjectEditor.ResponseAddressId, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MonoTextBoxStyle}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="功能请求" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             Height="26"
                                             Text="{Binding ProjectEditor.FunctionalRequestId, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MonoTextBoxStyle}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="BOOT 配置" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              Width="Auto"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding BootConfigFiles}"
                                              SelectedItem="{Binding ProjectEditor.BootConfigFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource StandardComboBoxStyle}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}"
                                                           ToolTip="{Binding}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="波特率" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              Width="Auto"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding BaudRates}"
                                              SelectedItem="{Binding ProjectEditor.BaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource StandardComboBoxStyle}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CAN 协议" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              Width="Auto"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding CanProtocols}"
                                              SelectedItem="{Binding ProjectEditor.CanProtocol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource StandardComboBoxStyle}" />
                                </Grid>

                                <Grid Visibility="{Binding ProjectEditor.IsDriverFileRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Driver 文件" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Height="26"
                                                 Text="{Binding ProjectEditor.DriverFileDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding ProjectEditor.DriverFilePath}"
                                                 Style="{StaticResource MonoTextBoxStyle}" />
                                        <Button Grid.Column="2"
                                                Command="{Binding BrowseProjectEditorDriverCommand}"
                                                Margin="0"
                                                Style="{StaticResource Button.Normal}"
                                                ToolTip="浏览 Driver 文件">
                                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                                <controls:FluentIcon Kind="FolderOpenOutline"
                                                                     Style="{StaticResource Button.Glyph.Current}" />
                                                <TextBlock Text="浏览" Style="{StaticResource Button.IconLabel}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>

                                <Grid Visibility="{Binding ProjectEditor.IsApplicationFileRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="App 文件" Style="{StaticResource FieldLabelStyle}" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Height="26"
                                                 Text="{Binding ProjectEditor.ApplicationFileDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding ProjectEditor.ApplicationFilePath}"
                                                 Style="{StaticResource MonoTextBoxStyle}" />
                                        <Button Grid.Column="2"
                                                Command="{Binding BrowseProjectEditorApplicationCommand}"
                                                Margin="0"
                                                Style="{StaticResource Button.Normal}"
                                                ToolTip="浏览 App 文件">
                                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                                <controls:FluentIcon Kind="FolderOpenOutline"
                                                                     Style="{StaticResource Button.Glyph.Current}" />
                                                <TextBlock Text="浏览" Style="{StaticResource Button.IconLabel}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </controls:CardContentPanel>
                        </ScrollViewer>

                        <!-- 1px 分隔线把可滚动表单与固定操作行分开，保存/取消/删除始终可见。 -->
                        <Border Grid.Row="1"
                                Margin="0,10,0,0"
                                Padding="0,8,0,0"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding DeleteProjectEditorCommand}"
                                        Visibility="{Binding CanDeleteEditedProject, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{StaticResource Button.Danger}"
                                        ToolTip="删除当前项目配置">
                                    <StackPanel Style="{StaticResource Button.InlineContent}">
                                        <controls:FluentIcon Kind="DeleteOutline"
                                                             Style="{StaticResource Button.Glyph.Current}" />
                                        <TextBlock Text="删除项目" Style="{StaticResource Button.IconLabel}" />
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Command="{Binding CancelProjectEditorCommand}"
                                            Style="{StaticResource Button.Normal}">
                                        <TextBlock Text="取消"
                                                   Style="{StaticResource Button.IconLabel}"
                                                   Margin="0" />
                                    </Button>
                                    <Button Command="{Binding SaveProjectEditorCommand}"
                                            Margin="0"
                                            Style="{StaticResource Button.Normal}">
                                        <StackPanel Style="{StaticResource Button.InlineContent}">
                                            <controls:FluentIcon Kind="ContentSaveOutline"
                                                                 Style="{StaticResource Button.Glyph.Current}" />
                                            <TextBlock Text="保存" Style="{StaticResource Button.IconLabel}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </controls:HeaderedCard>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
