<UserControl x:Class="DiagnosticFlashTool.App.Views.ProjectConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource PageHeaderRowStyle}" />
            <RowDefinition Style="{StaticResource PageHeaderGapRowStyle}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Style="{StaticResource PageHeader.Standard}" Title="项目配置">
            <controls:PageHeader.Actions>
                <controls:PageHelpDocumentButton Style="{StaticResource PageHelpDocumentButton.Standard}" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:HeaderedCard Grid.Column="0"
                                   MinWidth="500"
                                   Header="项目列表"
                                   Style="{StaticResource HeaderedCard.Data.Actions}">
                <controls:HeaderedCard.Actions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding RefreshProjectsCommand}"
                                    Style="{StaticResource Button.Normal}"
                                    ToolTip="刷新项目列表">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <controls:FluentIcon Kind="Refresh"
                                                             Style="{StaticResource Button.Glyph.Current}" />
                                    <TextBlock Text="刷新" Style="{StaticResource Button.IconLabel}" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NewProjectCommand}"
                                    Margin="0"
                                    Style="{StaticResource Button.Normal}"
                                    ToolTip="新增项目">
                                <StackPanel Style="{StaticResource Button.InlineContent}">
                                    <controls:FluentIcon Kind="Plus"
                                                             Style="{StaticResource Button.Glyph.Current}" />
                                    <TextBlock Text="新增项目" Style="{StaticResource Button.IconLabel}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                </controls:HeaderedCard.Actions>

                <DataGrid ItemsSource="{Binding Projects}"
                          SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                          IsReadOnly="True"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <DataGrid.Resources>
                            <Style x:Key="ProjectConfigCellTextStyle" TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="Margin" Value="16,0,0,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="ProjectConfigBootFileCellTextStyle"
                                   TargetType="TextBlock"
                                   BasedOn="{StaticResource ProjectConfigCellTextStyle}">
                                <Setter Property="ToolTip" Value="{Binding BootConfigFile}" />
                            </Style>
                            <Style x:Key="ProjectConfigDriverFileCellTextStyle"
                                   TargetType="TextBlock"
                                   BasedOn="{StaticResource ProjectConfigCellTextStyle}">
                                <Setter Property="ToolTip" Value="{Binding DriveFilePath}" />
                            </Style>
                            <Style x:Key="ProjectConfigApplicationFileCellTextStyle"
                                   TargetType="TextBlock"
                                   BasedOn="{StaticResource ProjectConfigCellTextStyle}">
                                <Setter Property="ToolTip" Value="{Binding FlashFilePath}" />
                            </Style>
                            <Style x:Key="ProjectConfigFileStatusTextStyle" TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontSize" Value="18" />
                                <Setter Property="Foreground" Value="{StaticResource StatusNeutralBrush}" />
                            </Style>
                            <Style x:Key="ProjectConfigFileStatusIconStyle" TargetType="{x:Type controls:FluentIcon}">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontSize" Value="18" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditProjectCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="项目名称" Binding="{Binding ProjectName}" Width="150" ElementStyle="{StaticResource ProjectConfigCellTextStyle}" />
                            <DataGridTextColumn Header="项目码" Binding="{Binding ProjectNo}" Width="76" ElementStyle="{StaticResource ProjectConfigCellTextStyle}" />
                            <DataGridTextColumn Header="波特率" Binding="{Binding BaudRate}" Width="90" ElementStyle="{StaticResource ProjectConfigCellTextStyle}" />
                            <DataGridTextColumn Header="物理请求" Binding="{Binding PhysicalRequestId}" Width="135" ElementStyle="{StaticResource ProjectConfigCellTextStyle}" />
                            <DataGridTextColumn Header="功能请求" Binding="{Binding FunctionalRequestId}" Width="135" ElementStyle="{StaticResource ProjectConfigCellTextStyle}" />
                            <DataGridTextColumn Header="响应地址" Binding="{Binding ResponseAddressId}" Width="135" ElementStyle="{StaticResource ProjectConfigCellTextStyle}" />
                            <DataGridTextColumn Header="BOOT 配置" Binding="{Binding BootConfigFile, Converter={StaticResource FileNameConverter}}" Width="130" ElementStyle="{StaticResource ProjectConfigBootFileCellTextStyle}" />
                            <DataGridTextColumn Header="CAN 协议" Binding="{Binding CanProtocol}" Width="90" ElementStyle="{StaticResource ProjectConfigCellTextStyle}" />
                            <DataGridTemplateColumn Header="Driver 文件" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding DriverFileStatusText}">
                                            <TextBlock Text="-">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ProjectConfigFileStatusTextStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DriverFileStatusIcon}" Value="-">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <controls:FluentIcon Kind="CheckCircleOutline"
                                                                 Foreground="{StaticResource StatusSuccessBrush}">
                                                <controls:FluentIcon.Style>
                                                    <Style TargetType="{x:Type controls:FluentIcon}" BasedOn="{StaticResource ProjectConfigFileStatusIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDriverFileAvailable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:FluentIcon.Style>
                                            </controls:FluentIcon>
                                            <controls:FluentIcon Kind="CloseCircleOutline"
                                                                 Foreground="{StaticResource StatusErrorBrush}">
                                                <controls:FluentIcon.Style>
                                                    <Style TargetType="{x:Type controls:FluentIcon}" BasedOn="{StaticResource ProjectConfigFileStatusIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDriverFileError}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:FluentIcon.Style>
                                            </controls:FluentIcon>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="App 文件" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding ApplicationFileStatusText}">
                                            <TextBlock Text="-">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ProjectConfigFileStatusTextStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ApplicationFileStatusIcon}" Value="-">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <controls:FluentIcon Kind="CheckCircleOutline"
                                                                 Foreground="{StaticResource StatusSuccessBrush}">
                                                <controls:FluentIcon.Style>
                                                    <Style TargetType="{x:Type controls:FluentIcon}" BasedOn="{StaticResource ProjectConfigFileStatusIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApplicationFileAvailable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:FluentIcon.Style>
                                            </controls:FluentIcon>
                                            <controls:FluentIcon Kind="CloseCircleOutline"
                                                                 Foreground="{StaticResource StatusErrorBrush}">
                                                <controls:FluentIcon.Style>
                                                    <Style TargetType="{x:Type controls:FluentIcon}" BasedOn="{StaticResource ProjectConfigFileStatusIconStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApplicationFileError}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:FluentIcon.Style>
                                            </controls:FluentIcon>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                </DataGrid>
            </controls:HeaderedCard>

            <controls:HeaderedCard Grid.Column="1"
                                   Width="400"
                                   Margin="16,0,0,0"
                                   Header="{Binding ProjectEditorTitle}">
                <controls:HeaderedCard.Style>
                    <Style TargetType="{x:Type controls:HeaderedCard}"
                           BasedOn="{StaticResource HeaderedCard.Form}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProjectEditorVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:HeaderedCard.Style>
                <controls:HeaderedCard.Actions>
                    <Button Command="{Binding CancelProjectEditorCommand}"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Margin="0"
                            Style="{StaticResource Button.Normal}"
                            ToolTip="关闭">
                        <controls:FluentIcon Kind="Close"
                                                 Style="{StaticResource Button.Glyph.Current}" />
                    </Button>
                </controls:HeaderedCard.Actions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="项目名称" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Column="1"
                                         Height="32"
                                         Text="{Binding ProjectEditor.ProjectName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SoftTextBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="项目码" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Column="1"
                                         Height="32"
                                         Text="{Binding ProjectEditor.ProjectNoText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SoftTextBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="物理请求" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Column="1"
                                         Height="32"
                                         Text="{Binding ProjectEditor.PhysicalRequestId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SoftTextBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="响应地址" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Column="1"
                                         Height="32"
                                         Text="{Binding ProjectEditor.ResponseAddressId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SoftTextBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="功能请求" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Column="1"
                                         Height="32"
                                         Text="{Binding ProjectEditor.FunctionalRequestId, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SoftTextBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="BOOT 配置" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox Grid.Column="1"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding BootConfigFiles}"
                                          SelectedItem="{Binding ProjectEditor.BootConfigFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource StandardComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}"
                                                       ToolTip="{Binding}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="波特率" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox Grid.Column="1"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding BaudRates}"
                                          SelectedItem="{Binding ProjectEditor.BaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CAN 协议" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox Grid.Column="1"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding CanProtocols}"
                                          SelectedItem="{Binding ProjectEditor.CanProtocol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,12"
                                  Visibility="{Binding ProjectEditor.IsDriverFileRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Driver 文件" Style="{StaticResource FieldLabelStyle}" />
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Height="32"
                                             Text="{Binding ProjectEditor.DriverFileDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding ProjectEditor.DriverFilePath}"
                                             Style="{StaticResource MonoTextBoxStyle}" />
                                    <Button Grid.Column="2"
                                            Command="{Binding BrowseProjectEditorDriverCommand}"
                                            Margin="0"
                                            Style="{StaticResource Button.Normal}">
                                        <StackPanel Style="{StaticResource Button.InlineContent}">
                                            <controls:FluentIcon Kind="FolderOpenOutline"
                                                                     Style="{StaticResource Button.Glyph.Current}" />
                                            <TextBlock Text="浏览" Style="{StaticResource Button.IconLabel}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>

                            <Grid Visibility="{Binding ProjectEditor.IsApplicationFileRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="App 文件" Style="{StaticResource FieldLabelStyle}" />
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Height="32"
                                             Text="{Binding ProjectEditor.ApplicationFileDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding ProjectEditor.ApplicationFilePath}"
                                             Style="{StaticResource MonoTextBoxStyle}" />
                                    <Button Grid.Column="2"
                                            Command="{Binding BrowseProjectEditorApplicationCommand}"
                                            Margin="0"
                                            Style="{StaticResource Button.Normal}">
                                        <StackPanel Style="{StaticResource Button.InlineContent}">
                                            <controls:FluentIcon Kind="FolderOpenOutline"
                                                                     Style="{StaticResource Button.Glyph.Current}" />
                                            <TextBlock Text="浏览" Style="{StaticResource Button.IconLabel}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding DeleteProjectEditorCommand}"
                                Visibility="{Binding IsEditingProject, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource Button.Danger}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="DeleteOutline"
                                                         Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="删除项目信息" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveProjectEditorCommand}"
                                Margin="0"
                                Style="{StaticResource Button.Normal}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="ContentSaveOutline"
                                                         Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="保存" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </controls:HeaderedCard>
        </Grid>
    </Grid>
</UserControl>
