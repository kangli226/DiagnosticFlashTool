<UserControl x:Class="DiagnosticFlashTool.App.Views.ProjectConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock Text="项目配置" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Add" Command="{Binding AddProjectCommand}" Width="80" />
                    <Button Content="Delete" Command="{Binding DeleteProjectCommand}" Width="80" />
                    <Button Content="Save" Command="{Binding SaveProjectsCommand}" Width="90" Style="{StaticResource PrimaryFilledButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14">
            <DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Project" Binding="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                    <DataGridTextColumn Header="No" Binding="{Binding ProjectNo, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                    <DataGridTextColumn Header="Baud" Binding="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                    <DataGridTextColumn Header="Physical ID" Binding="{Binding PhysicalRequestId, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                    <DataGridTextColumn Header="Functional ID" Binding="{Binding FunctionalRequestId, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                    <DataGridTextColumn Header="Response ID" Binding="{Binding ResponseAddressId, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                    <DataGridTextColumn Header="BOOT" Binding="{Binding BootConfigFile, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                    <DataGridTextColumn Header="Driver file" Binding="{Binding DriveFilePath, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                    <DataGridTextColumn Header="Application file" Binding="{Binding FlashFilePath, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>