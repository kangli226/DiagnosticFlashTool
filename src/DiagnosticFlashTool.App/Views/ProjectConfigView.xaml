<UserControl x:Class="DiagnosticFlashTool.App.Views.ProjectConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <Grid>
        <Grid.InputBindings>
            <KeyBinding Key="Escape" Command="{Binding CancelProjectEditorCommand}" />
        </Grid.InputBindings>

        <Grid Style="{StaticResource PageRootGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:HeaderedCard Grid.Column="0"
                                   Header="项目配置"
                                   Style="{StaticResource HeaderedCard.Data.Actions}">
                <controls:HeaderedCard.Actions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding RefreshProjectsCommand}"
                                Style="{StaticResource Button.Normal}"
                                ToolTip="重新读取项目配置列表">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="Refresh"
                                                     Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="刷新" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NewProjectButton"
                                Command="{Binding NewProjectCommand}"
                                Visibility="{Binding IsSystemAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Margin="0"
                                Style="{StaticResource Button.Normal}"
                                ToolTip="新建项目配置">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="Plus"
                                                     Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="新增项目" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:HeaderedCard.Actions>

                <Grid>
                    <DataGrid x:Name="ProjectsGrid"
                              ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              IsReadOnly="True"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              AutomationProperties.HelpText="双击项目行查看详情"
                              MouseDoubleClick="ProjectsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="项目名称" Binding="{Binding ProjectName}" Width="*" MinWidth="130" ElementStyle="{StaticResource DataGrid.CellText}" />
                            <DataGridTextColumn Header="波特率" Binding="{Binding BaudRate}" Width="56" MinWidth="56" ElementStyle="{StaticResource DataGrid.CellText}" />
                            <DataGridTextColumn Header="物理请求" Binding="{Binding PhysicalRequestId}" Width="108" MinWidth="108" ElementStyle="{StaticResource DataGrid.CellText}" />
                            <DataGridTextColumn Header="功能请求" Binding="{Binding FunctionalRequestId}" Width="108" MinWidth="108" ElementStyle="{StaticResource DataGrid.CellText}" />
                            <DataGridTextColumn Header="响应地址" Binding="{Binding ResponseAddressId}" Width="108" MinWidth="108" ElementStyle="{StaticResource DataGrid.CellText}" />
                            <DataGridTemplateColumn Header="BOOT 配置" Width="108" MinWidth="108">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding BootConfigFile, Converter={StaticResource FileNameConverter}}"
                                                   ToolTip="{Binding BootConfigFile}"
                                                   Style="{StaticResource DataGrid.CellText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="CAN 协议" Binding="{Binding CanProtocol}" Width="76" MinWidth="76" ElementStyle="{StaticResource DataGrid.CellText}" />
                            <DataGridTemplateColumn Header="Driver" Width="64" MinWidth="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding DriverFileStatusText}">
                                            <TextBlock Text="-">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGrid.StatusText}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DriverFileStatusIcon}" Value="-">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <controls:FluentIcon Kind="Check"
                                                                 Foreground="{StaticResource StatusSuccessBrush}">
                                                <controls:FluentIcon.Style>
                                                    <Style TargetType="{x:Type controls:FluentIcon}" BasedOn="{StaticResource DataGrid.StatusIcon}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDriverFileAvailable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:FluentIcon.Style>
                                            </controls:FluentIcon>
                                            <controls:FluentIcon Kind="CloseCircleOutline"
                                                                 Foreground="{StaticResource StatusErrorBrush}">
                                                <controls:FluentIcon.Style>
                                                    <Style TargetType="{x:Type controls:FluentIcon}" BasedOn="{StaticResource DataGrid.StatusIcon}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDriverFileError}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:FluentIcon.Style>
                                            </controls:FluentIcon>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="App" Width="52" MinWidth="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding ApplicationFileStatusText}">
                                            <TextBlock Text="-">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGrid.StatusText}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ApplicationFileStatusIcon}" Value="-">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <controls:FluentIcon Kind="Check"
                                                                 Foreground="{StaticResource StatusSuccessBrush}">
                                                <controls:FluentIcon.Style>
                                                    <Style TargetType="{x:Type controls:FluentIcon}" BasedOn="{StaticResource DataGrid.StatusIcon}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApplicationFileAvailable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:FluentIcon.Style>
                                            </controls:FluentIcon>
                                            <controls:FluentIcon Kind="CloseCircleOutline"
                                                                 Foreground="{StaticResource StatusErrorBrush}">
                                                <controls:FluentIcon.Style>
                                                    <Style TargetType="{x:Type controls:FluentIcon}" BasedOn="{StaticResource DataGrid.StatusIcon}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApplicationFileError}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </controls:FluentIcon.Style>
                                            </controls:FluentIcon>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 列表空状态：不占位、不拦截点击，下一步仍走卡片标题行的“新增项目”。 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="暂无项目配置" Style="{StaticResource EmptyStateTitleTextStyle}" />
                        <TextBlock Text="点击上方“新增项目”创建第一条项目配置。"
                                   Style="{StaticResource HintTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </controls:HeaderedCard>

            <Grid Grid.Column="1"
                  Visibility="{Binding IsEditingProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Style="{StaticResource PageColumnGapStyle}" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <controls:HeaderedCard Grid.Column="1"
                                       Header="项目详情"
                                       Background="{StaticResource AppBackgroundBrush}"
                                       Style="{StaticResource HeaderedCard.Form}">
                    <controls:HeaderedCard.Actions>
                        <Button Command="{Binding CancelProjectEditorCommand}"
                                Width="26"
                                Height="26"
                                Padding="0"
                                Margin="0"
                                Style="{StaticResource Button.Normal}"
                                ToolTip="关闭编辑">
                            <controls:FluentIcon Kind="Close"
                                                 Style="{StaticResource Button.Glyph.Current}" />
                        </Button>
                    </controls:HeaderedCard.Actions>

                    <controls:ProjectEditorForm />
                </controls:HeaderedCard>
            </Grid>
        </Grid>

        <Border Visibility="{Binding IsNewProjectDialogVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Style="{StaticResource DialogOverlayStyle}"
                IsVisibleChanged="NewProjectDialog_IsVisibleChanged">
            <Border x:Name="NewProjectDialogPanel"
                    Width="420"
                    Margin="{StaticResource PageMargin}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogPanelStyle}">
                <Grid KeyboardNavigation.TabNavigation="Cycle">
                    <Grid.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SaveProjectEditorCommand}" />
                    </Grid.InputBindings>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Style="{StaticResource PageSectionGapRowStyle}" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="新建项目" Style="{StaticResource DialogTitleTextStyle}" />
                    <controls:ProjectEditorForm Grid.Row="2" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
