<UserControl x:Class="DiagnosticFlashTool.App.Views.FirmwareFlashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="22" />
            <RowDefinition Height="122" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="22,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="固件刷写"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="连接 CAN 设备并监控刷写状态与进度"
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Height="36"
                            Margin="0,0,22,0"
                            Style="{StaticResource Button.ToolBar}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="主题"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="8,0,0,0" />
                            </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                        <TextBlock Text="设备配置" Style="{StaticResource CardHeaderTextStyle}" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="16,8,16,0">
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="波特率：" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Text="待自动搜索"
                                     IsReadOnly="True"
                                     IsEnabled="False"
                                     Style="{StaticResource SoftTextBoxStyle}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="设备连接：" Style="{StaticResource FieldLabelStyle}" />
                            <Button Grid.Column="1"
                                    Command="{Binding ToggleConnectionCommand}"
                                    Width="128"
                                    Style="{StaticResource Button.Primary}"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE839;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               Margin="0,0,8,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, FallbackValue=#FFFFFF, TargetNullValue=#FFFFFF}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ConnectionActionText}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, FallbackValue=#FFFFFF, TargetNullValue=#FFFFFF}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                        <TextBlock Text="BTMS 刷写监视器" Style="{StaticResource CardHeaderTextStyle}" />
                    </Border>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel Width="160" Margin="0,0,24,0">
                            <Border Height="90"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Tag="{Binding DeviceStatusKind}"
                                    Style="{StaticResource StatusCardBorderStyle}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="22"
                                            Height="22"
                                            CornerRadius="11"
                                            BorderThickness="2"
                                            HorizontalAlignment="Center"
                                            Tag="{Binding DeviceStatusKind}"
                                            Style="{StaticResource StatusIconBorderStyle}">
                                        <TextBlock Text="{Binding DeviceStatusIcon}"
                                                   Style="{StaticResource StatusIconTextStyle}" />
                                    </Border>
                                    <Border Margin="0,12,0,0"
                                            Tag="{Binding DeviceStatusKind}"
                                            Style="{StaticResource StatusBadgeBorderStyle}">
                                        <TextBlock Text="{Binding DeviceStatusText}"
                                                   Style="{StaticResource StatusBadgeTextStyle}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="设备状态"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>

                        <StackPanel Width="160">
                            <Border Height="90"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Tag="{Binding DownloadStatusKind}"
                                    Style="{StaticResource StatusCardBorderStyle}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="22"
                                            Height="22"
                                            CornerRadius="11"
                                            BorderThickness="2"
                                            HorizontalAlignment="Center"
                                            Tag="{Binding DownloadStatusKind}"
                                            Style="{StaticResource StatusIconBorderStyle}">
                                        <TextBlock Text="{Binding DownloadStatusIcon}"
                                                   Style="{StaticResource StatusIconTextStyle}" />
                                    </Border>
                                    <Border Margin="0,12,0,0"
                                            Tag="{Binding DownloadStatusKind}"
                                            Style="{StaticResource StatusBadgeBorderStyle}">
                                        <TextBlock Text="{Binding DownloadStatusText}"
                                                   Style="{StaticResource StatusBadgeTextStyle}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="下载状态"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <TextBlock Text="下载进度" Style="{StaticResource CardHeaderTextStyle}" />
                </Border>

                <Grid Grid.Row="1" Margin="16,0">
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Progress}"
                                 Style="{StaticResource SoftProgressBarStyle}"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ProgressText}"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
