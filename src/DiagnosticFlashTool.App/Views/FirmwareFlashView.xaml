<UserControl x:Class="DiagnosticFlashTool.App.Views.FirmwareFlashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="22" />
            <RowDefinition Height="122" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="22,0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="固件刷写"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="连接 CAN 设备并监控刷写状态与进度"
                               FontSize="14"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Height="36"
                            Padding="10,0"
                            Margin="0,0,22,0"
                            Background="Transparent"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="主题"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Content="&#xE921;"
                            ToolTip="最小化"
                            Style="{StaticResource ChromeButtonStyle}"
                            Click="Minimize_Click" />
                    <Button Content="&#xE922;"
                            ToolTip="最大化"
                            Style="{StaticResource ChromeButtonStyle}"
                            Click="Maximize_Click" />
                    <Button Content="&#xE8BB;"
                            ToolTip="关闭"
                            Style="{StaticResource CloseChromeButtonStyle}"
                            Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                        <TextBlock Text="设备配置" Style="{StaticResource CardHeaderTextStyle}" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="16,8,16,0">
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="波特率：" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Grid.Column="1"
                                     Text="待自动搜索"
                                     IsReadOnly="True"
                                     IsEnabled="False"
                                     Style="{StaticResource SoftTextBoxStyle}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="设备连接：" Style="{StaticResource FieldLabelStyle}" />
                            <Button Grid.Column="1"
                                    Command="{Binding ToggleConnectionCommand}"
                                    Style="{StaticResource PrimaryOutlineButtonStyle}"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE839;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ConnectionActionText}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                        <TextBlock Text="BTMS 刷写监视器" Style="{StaticResource CardHeaderTextStyle}" />
                    </Border>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel Width="160" Margin="0,0,24,0">
                            <Border Height="90"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    BorderBrush="{StaticResource CardBorderBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="22"
                                            Height="22"
                                            CornerRadius="11"
                                            BorderThickness="2"
                                            BorderBrush="{StaticResource DangerBrush}"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="×"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,-3,0,0" />
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Border Margin="0,12,0,0"
                                            Padding="10,4"
                                            CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding DeviceStatusText}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="设备状态"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0"
                                       FontSize="14"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>

                        <StackPanel Width="160">
                            <Border Height="90"
                                    BorderThickness="1"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    CornerRadius="8"
                                    Background="{StaticResource PanelBrush}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="ⓘ"
                                               Foreground="{StaticResource NeutralTextBrush}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center" />
                                    <Border Margin="0,12,0,0"
                                            Padding="12,5"
                                            Background="{StaticResource NeutralSoftBrush}"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding DownloadStatusText}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource NeutralTextBrush}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="下载状态"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0"
                                       FontSize="14"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <TextBlock Text="下载进度" Style="{StaticResource CardHeaderTextStyle}" />
                </Border>

                <Grid Grid.Row="1" Margin="16,0">
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Progress}"
                                 Style="{StaticResource SoftProgressBarStyle}"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ProgressText}"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
