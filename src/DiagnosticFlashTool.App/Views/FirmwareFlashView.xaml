<UserControl x:Class="DiagnosticFlashTool.App.Views.FirmwareFlashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Style="{StaticResource PageHeaderRowStyle}" />
            <RowDefinition Style="{StaticResource PageHeaderGapRowStyle}" />
            <RowDefinition Height="*" />
            <RowDefinition Style="{StaticResource PageSectionGapRowStyle}" />
            <RowDefinition Style="{StaticResource PageSummaryRowStyle}" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PageHeaderCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="固件刷写"
                               Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="连接 CAN 设备并监控刷写状态与进度"
                               Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Width="112"
                            Style="{StaticResource Button.ToolBar}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22"
                                    Height="22"
                                    CornerRadius="4"
                                    Background="{StaticResource TextBrush}">
                                <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.HelpCircleOutline}"
                                                         Width="16"
                                                         Height="16"
                                                         Foreground="{StaticResource InverseTextBrush}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="&#x5E2E;&#x52A9;&#x6587;&#x6863;"
                                       Style="{StaticResource Button.IconLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Style="{StaticResource PageColumnGapStyle}" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                        <TextBlock Text="设备配置"
                                   Style="{StaticResource CardHeaderTextStyle}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Grid Grid.Row="1" Margin="20,20,20,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="74" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="波特率：" Style="{StaticResource FieldLabelStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource InlineStatusValueBorderStyle}">
                                    <TextBlock Text="{Binding BaudRateStatusText}"
                                               Style="{StaticResource InlineStatusValueTextStyle}" />
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="设备连接：" Style="{StaticResource FieldLabelStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource InlineStatusValueBorderStyle}">
                                    <TextBlock Text="{Binding ConnectionSummaryText}"
                                               Style="{StaticResource InlineStatusValueTextStyle}" />
                                </Border>
                                <Button Grid.Column="2"
                                        Command="{Binding ToggleConnectionCommand}"
                                        Tag="{Binding IsConnected}"
                                        Width="112"
                                        Style="{StaticResource Button.ConnectionAction}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.PowerPlug}"
                                                                 Width="16"
                                                                 Height="16"
                                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ConnectionActionText}"
                                                   Margin="6,0,0,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="2"
                                       Text="当前配置"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="设备类型"
                                       Style="{StaticResource ConfigLabelTextStyle}"
                                       Margin="0,0,16,0" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding SelectedDeviceType}"
                                       Style="{StaticResource ConfigValueTextStyle}" />

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Text="波特率"
                                       Style="{StaticResource ConfigLabelTextStyle}"
                                       Margin="0,0,16,0" />
                            <TextBlock Grid.Row="4"
                                       Grid.Column="1"
                                       Text="{Binding SelectedBaudRate}"
                                       Style="{StaticResource ConfigValueTextStyle}" />

                            <TextBlock Grid.Row="6"
                                       Grid.Column="0"
                                       Text="通信协议"
                                       Style="{StaticResource ConfigLabelTextStyle}"
                                       Margin="0,0,16,0" />
                            <TextBlock Grid.Row="6"
                                       Grid.Column="1"
                                       Text="CAN"
                                       Style="{StaticResource ConfigValueTextStyle}" />

                            <TextBlock Grid.Row="8"
                                       Grid.Column="0"
                                       Text="监视器"
                                       Style="{StaticResource ConfigLabelTextStyle}"
                                       Margin="0,0,16,0" />
                            <TextBlock Grid.Row="8"
                                       Grid.Column="1"
                                       Text="BTMS"
                                       Style="{StaticResource ConfigValueTextStyle}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                        <TextBlock Text="BTMS 刷写监视器" 
                                   Style="{StaticResource CardHeaderTextStyle}" 
                                   HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                    </Border>

                    <Grid Grid.Row="1" Margin="20,20,20,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="74" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Border Width="144"
                                    Height="74"
                                    Margin="0,0,12,0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Tag="{Binding DeviceStatusKind}"
                                    Style="{StaticResource StatusCardBorderStyle}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.PowerPlug}"
                                                             Width="24"
                                                             Height="24"
                                                             Tag="{Binding DeviceStatusKind}"
                                                             Style="{StaticResource StatusCardPackIconStyle}" />
                                    <Border Margin="0,6,0,0"
                                            Tag="{Binding DeviceStatusKind}"
                                            Style="{StaticResource StatusBadgeBorderStyle}">
                                        <TextBlock Text="{Binding DeviceStatusText}"
                                                   Style="{StaticResource StatusBadgeTextStyle}" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Width="144"
                                    Height="74"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Tag="{Binding DownloadStatusKind}"
                                    Style="{StaticResource StatusCardBorderStyle}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.Flash}"
                                                             Width="24"
                                                             Height="24"
                                                             Tag="{Binding DownloadStatusKind}"
                                                             Style="{StaticResource StatusCardPackIconStyle}" />
                                    <Border Margin="0,6,0,0"
                                            Tag="{Binding DownloadStatusKind}"
                                            Style="{StaticResource StatusBadgeBorderStyle}">
                                        <TextBlock Text="{Binding DownloadStatusText}"
                                                   Style="{StaticResource StatusBadgeTextStyle}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="2" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="144" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="144" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="设备状态"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource SubtleTextBrush}" />
                                <TextBlock Text="{Binding ConnectionSummaryText}"
                                           Margin="0,3,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="下载状态"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource SubtleTextBrush}" />
                                <TextBlock Text="{Binding DownloadMonitorDetailText}"
                                           Margin="0,3,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                    <TextBlock Text="下载进度" Style="{StaticResource CardHeaderTextStyle}" />
                </Border>

                <Grid Grid.Row="1" Margin="{StaticResource PagePanelHorizontalMargin}">
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Progress}"
                                 Style="{StaticResource SoftProgressBarStyle}"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ProgressText}"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
