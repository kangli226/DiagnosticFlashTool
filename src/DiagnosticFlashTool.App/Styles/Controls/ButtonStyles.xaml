<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 官方模板直接读取这些动态资源；仅设置 Button.Background 无法保留危险操作的交互色。 -->
    <ResourceDictionary x:Key="Button.DangerStateResources">
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource Color.Warning.Hover}" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource Color.Warning.Hover}" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource Color.Warning.Text}" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource Color.Warning.Pressed}" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource Color.Warning.Pressed}" />
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource Color.Warning.Text}" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource Color.Warning.Hover}" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="{StaticResource Color.Warning.Hover}" />
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource Color.Warning.Text}" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource Color.Warning.Pressed}" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{StaticResource Color.Warning.Pressed}" />
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource Color.Warning.Text}" />
    </ResourceDictionary>

    <Style x:Key="Button.Base"
           TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,4,8,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Normal" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimarySoftBorderBrush}" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Button.Normal}" />

    <Style x:Key="Button.Primary"
           TargetType="Button"
           BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,4,8,4" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="controls:FluentButtonAssist.StateResources" Value="{StaticResource Button.DangerStateResources}" />
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerActiveBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerActiveBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource DangerPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                <Setter Property="Background" Value="{StaticResource NeutralSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.ConnectionAction" TargetType="Button" BasedOn="{StaticResource Button.Normal}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="controls:FluentButtonAssist.StateResources" Value="{StaticResource Button.DangerStateResources}" />
                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource DangerActiveBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerActiveBrush}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource DangerPressedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerPressedBrush}" />
            </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.HelpDocument" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Width" Value="88" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.ConnectionPrimaryAction" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="controls:FluentButtonAssist.StateResources" Value="{StaticResource Button.DangerStateResources}" />
                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource DangerActiveBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerActiveBrush}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource DangerPressedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerPressedBrush}" />
            </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundDisabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource IconDefaultBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.ToolBar" TargetType="Button" BasedOn="{StaticResource Button.Normal}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="Button.Compact" TargetType="Button" BasedOn="{StaticResource Button.Normal}">
        <Setter Property="Width" Value="72" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <Style x:Key="Button.PathAction" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Glyph" TargetType="{x:Type controls:FluentIcon}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Button.InlineContent" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Button.Glyph.Current" TargetType="{x:Type controls:FluentIcon}" BasedOn="{StaticResource Button.Glyph}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <Style x:Key="Button.Glyph.Accent" TargetType="{x:Type controls:FluentIcon}" BasedOn="{StaticResource Button.Glyph}">
        <Setter Property="Foreground" Value="{StaticResource IconPrimaryBrush}" />
    </Style>

    <Style x:Key="Button.Glyph.Inverse" TargetType="{x:Type controls:FluentIcon}" BasedOn="{StaticResource Button.Glyph}">
        <Setter Property="Foreground" Value="{StaticResource InverseTextBrush}" />
    </Style>

    <Style x:Key="Button.IconLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Button.HelpDocumentLabel" TargetType="TextBlock" BasedOn="{StaticResource Button.IconLabel}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="Button.IconLabel.Inverse" TargetType="TextBlock" BasedOn="{StaticResource Button.IconLabel}">
        <Setter Property="Foreground" Value="{StaticResource InverseTextBrush}" />
    </Style>

    <Style x:Key="Button.PathActionIcon" TargetType="{x:Type controls:FluentIcon}" BasedOn="{StaticResource Button.Glyph.Current}" />

    <Style x:Key="Button.PathActionLabel" TargetType="TextBlock" BasedOn="{StaticResource Button.IconLabel}">
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>

    <Style x:Key="Button.DialogSecondary" TargetType="Button" BasedOn="{StaticResource Button.Normal}">
        <Setter Property="Width" Value="78" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="Button.DialogPrimary" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="BaseChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>

    <Style x:Key="ChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseChromeButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CloseChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseChromeButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="controls:FluentButtonAssist.StateResources" Value="{StaticResource Button.DangerStateResources}" />
                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
