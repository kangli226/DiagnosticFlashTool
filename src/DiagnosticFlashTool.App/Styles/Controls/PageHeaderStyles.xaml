<!-- 页头（PageHeader）专用资源：几何、文字与隐式样式。
     单独成文件后，页头相关样式无需再翻 Layout/PageStyles.xaml。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Brushes.xaml" />
        <ResourceDictionary Source="../Layout/CardStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 页头所在行高度：单行上下文栏 -->
    <Style x:Key="PageHeaderRowStyle" TargetType="RowDefinition">
        <Setter Property="Height" Value="52" />
    </Style>

    <!-- 页头卡片容器 -->
    <Style x:Key="PageHeaderCardStyle" TargetType="Border" BasedOn="{StaticResource Card.Elevated}">
        <Setter Property="Padding" Value="{StaticResource CardHeaderContentPadding}" />
    </Style>

    <!-- 单行上下文文本：垂直居中、单行省略；为空时整行让位给操作区 -->
    <Style x:Key="PageHeaderContextTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 页头右侧元信息文字 -->
    <Style x:Key="PageHeaderMetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 隐式样式：页头文案统一由 MainViewModel.CurrentPageContextText 供给，
         页面只需 <controls:PageHeader Grid.Row="0" />；个别页面仍可用 Context="..." 覆盖（局部值优先）。 -->
    <Style TargetType="controls:PageHeader">
        <Setter Property="Context" Value="{Binding CurrentPageContextText}" />
    </Style>
</ResourceDictionary>
