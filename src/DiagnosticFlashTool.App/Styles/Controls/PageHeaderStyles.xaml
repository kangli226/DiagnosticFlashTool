<!-- 页头（PageHeader）专用资源：标题、操作行尺寸与元信息文字。
     单独成文件后，页头相关样式无需再翻 Layout/PageStyles.xaml。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Brushes.xaml" />
        <ResourceDictionary Source="../Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 页头内容相对页面根容器的水平内缩；与 PageMargin=16 叠加后文字边缘距 Shell 内容区边界 20 DIP -->
    <Thickness x:Key="PageHeaderContentMargin">4,0</Thickness>

    <Style x:Key="PageHeader.Standard" TargetType="{x:Type controls:PageHeader}">
        <Setter Property="Padding" Value="{StaticResource PageHeaderContentMargin}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="PageHelpDocumentButton.Standard" TargetType="{x:Type controls:PageHelpDocumentButton}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 页头所在行高度：无卡片背景的轻量操作栏 -->
    <Style x:Key="PageHeaderRowStyle" TargetType="RowDefinition">
        <Setter Property="Height" Value="32" />
    </Style>

    <Style x:Key="PageHeaderTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.PageTitle}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.CardTitle}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PageHeaderBreadcrumbTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Assist}" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PageHeaderSeparatorIconStyle" TargetType="{x:Type controls:FluentIcon}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Assist}" />
        <Setter Property="Foreground" Value="{StaticResource DividerBrush}" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PageHeaderBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PrimarySoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Compact}" />
    </Style>

    <Style x:Key="PageHeaderBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 页头右侧元信息文字 -->
    <Style x:Key="PageHeaderMetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
