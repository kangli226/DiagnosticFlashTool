<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Brushes.xaml" />
        <ResourceDictionary Source="../Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="DataGrid.Base" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="controls:CornerRadiusClipBehavior.CornerRadius"
                Value="{StaticResource CornerRadius.Control}" />
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource PanelBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource TableAltRowBrush}" />
        <Setter Property="RowHeight" Value="40" />
        <Setter Property="ColumnHeaderHeight" Value="38" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource TableHeaderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CardTitleTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource PrimarySoftBorderBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DataGrid.CellText" TargetType="TextBlock">
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="DataGrid.MonoCellText"
           TargetType="TextBlock"
           BasedOn="{StaticResource DataGrid.CellText}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    </Style>

    <Style x:Key="DataGrid.StatusText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StatusNeutralBrush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="DataGrid.StatusIcon" TargetType="{x:Type controls:FluentIcon}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="DataGrid" BasedOn="{StaticResource DataGrid.Base}" />
</ResourceDictionary>
