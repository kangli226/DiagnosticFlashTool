<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DiagnosticFlashTool.App.ViewModels">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Brushes.xaml" />
        <ResourceDictionary Source="../Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Keep visible field content 10px from the left edge. TextBox and PasswordBox
        already apply Padding to PART_ContentHost, so their templates must not bind
        the same value to the host Margin.
    -->
    <Thickness x:Key="EditableInputContentPadding">7,0,9,0</Thickness>
    <Thickness x:Key="InputDisplayContentPadding">9,0,9,0</Thickness>
    <!--
        The Fluent ComboBox template already reserves a dedicated column for the
        drop-down glyph, so the content padding must not reserve the glyph width
        again; doing so collapses narrow ComboBoxes to a few pixels.
    -->
    <Thickness x:Key="ComboBoxContentPadding">10,0,8,0</Thickness>

    <Style x:Key="SoftTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="{StaticResource EditableInputContentPadding}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SoftPasswordBoxStyle"
           TargetType="PasswordBox"
           BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="{StaticResource EditableInputContentPadding}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="PasswordChar" Value="*" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="PathDisplayBorderStyle" TargetType="Border">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="{StaticResource InputDisplayContentPadding}" />
        <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Control}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static vm:DiagnosticStatusKind.Success}">
                <Setter Property="Background" Value="{StaticResource StatusSuccessSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static vm:DiagnosticStatusKind.Warning}">
                <Setter Property="Background" Value="{StaticResource StatusWarningSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PathDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}"
                         Value="{x:Static vm:DiagnosticStatusKind.Success}">
                <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}"
                         Value="{x:Static vm:DiagnosticStatusKind.Warning}">
                <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InlineStatusValueBorderStyle" TargetType="Border">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="{StaticResource InputDisplayContentPadding}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Control}" />
    </Style>

    <Style x:Key="InlineStatusValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueCodeTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <ControlTemplate x:Key="SoftSwitchTemplate" TargetType="{x:Type ToggleButton}">
        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
            <Border x:Name="SwitchTrack"
                    Background="{StaticResource DividerBrush}"
                    CornerRadius="{StaticResource CornerRadius.Control}" />
            <Border x:Name="SwitchThumb"
                    Width="18"
                    Height="18"
                    Margin="3"
                    HorizontalAlignment="Left"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="{StaticResource CornerRadius.Compact}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource PrimaryBrush}" />
                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.55" />
                <Setter TargetName="SwitchThumb" Property="Opacity" Value="0.75" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="SoftSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template" Value="{StaticResource SoftSwitchTemplate}" />
    </Style>

    <Style x:Key="SoftProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="{StaticResource ProgressTrackBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryActiveBrush}" />
    </Style>

    <Style TargetType="ProgressBar" BasedOn="{StaticResource SoftProgressBarStyle}" />

    <Style TargetType="TextBox" BasedOn="{StaticResource SoftTextBoxStyle}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,4,0,8" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    </Style>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource SoftPasswordBoxStyle}" />

    <Style x:Key="StandardComboBoxItemStyle"
           TargetType="{x:Type ComboBoxItem}"
           BasedOn="{StaticResource DefaultComboBoxItemStyle}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
    </Style>

    <Style x:Key="StandardComboBoxStyle"
           TargetType="{x:Type ComboBox}"
           BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="Width" Value="280" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="{StaticResource ComboBoxContentPadding}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MaxDropDownHeight" Value="260" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource StandardComboBoxItemStyle}" />
    </Style>

    <Style x:Key="SoftComboBoxStyle" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource StandardComboBoxStyle}" />

    <Style x:Key="MonoTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SoftTextBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    </Style>

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource StandardComboBoxStyle}" />
</ResourceDictionary>
