    <Color x:Key="Color.Success">#16A34A</Color>
    <Color x:Key="Color.Success.Soft">#DCFCE7</Color>
    <Color x:Key="Color.Success.Border">#86EFAC</Color>

    <Color x:Key="Color.Warning">#F59E0B</Color>
    <Color x:Key="Color.Warning.Hover">#D97706</Color>
    <Color x:Key="Color.Warning.Pressed">#B45309</Color>
    <Color x:Key="Color.Warning.Soft">#FEF3C7</Color>
    <Color x:Key="Color.Warning.Border">#FCD34D</Color>
    <Color x:Key="Color.Warning.Text">#1E293B</Color>

    <Color x:Key="Color.Error">#DC2626</Color>
    <Color x:Key="Color.Error.Soft">#FEE2E2</Color>
    <Color x:Key="Color.Error.Border">#FCA5A5</Color>

    <Color x:Key="Color.Neutral.Soft">#F1F5F9</Color>
    <Color x:Key="Color.Neutral.Border">#CBD5E1</Color>
