<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.App.Background">#F1F5F9</Color>
    <Color x:Key="Color.Card.Background">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Background">#F8FAFC</Color>
    <Color x:Key="Color.Border.Card">#E2E8F0</Color>
    <Color x:Key="Color.Border.Divider">#E2E8F0</Color>
    <Color x:Key="Color.Border.Input">#CBD5E1</Color>

    <Color x:Key="Color.Primary">#2563EB</Color>
    <Color x:Key="Color.Primary.Hover">#1D4ED8</Color>
    <Color x:Key="Color.Primary.Pressed">#1E40AF</Color>
    <Color x:Key="Color.Primary.Accent">#3B82F6</Color>
    <Color x:Key="Color.Primary.Soft">#DBEAFE</Color>
    <Color x:Key="Color.Primary.SoftPressed">#BFDBFE</Color>

    <Color x:Key="Color.Text.Primary">#1E293B</Color>
    <Color x:Key="Color.Text.Secondary">#64748B</Color>
    <Color x:Key="Color.Text.Muted">#94A3B8</Color>
    <Color x:Key="Color.Text.Disabled">#94A3B8</Color>
    <Color x:Key="Color.Text.Inverse">#FFFFFF</Color>

    <Color x:Key="Color.Sidebar.Background">#1E293B</Color>
