    <Color x:Key="Color.Sidebar.Text">#CBD5E1</Color>
    <Color x:Key="Color.Sidebar.TextMuted">#94A3B8</Color>

    <Color x:Key="Color.Table.Header">#F8FAFC</Color>
    <Color x:Key="Color.Table.AlternateRow">#F8FAFC</Color>
    <Color x:Key="Color.Progress.Track">#E2E8F0</Color>

    <Color x:Key="Color.Log.Panel">#0F172A</Color>
    <Color x:Key="Color.Log.PanelHover">#111827</Color>
    <Color x:Key="Color.Log.PanelSelected">#1E293B</Color>
    <Color x:Key="Color.Log.Text">#CBD5E1</Color>
