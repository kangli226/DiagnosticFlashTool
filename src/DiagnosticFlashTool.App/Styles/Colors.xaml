<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        桌面工具调色板（v3.3 深色框架 + 浅色内容，主题仍固定 Light）。
        深灰石墨框架（标题栏/菜单栏/侧栏/状态栏）+ 低成本浅色内容区 + 单一工业蓝强调。
        色值只在此处定义，业务页面与样式不得再硬编码十六进制颜色。
    -->
    <Color x:Key="Color.App.Background">#E9EDF1</Color>
    <Color x:Key="Color.Chrome.Background">#23282E</Color>
    <Color x:Key="Color.Chrome.Border">#14181C</Color>
    <Color x:Key="Color.Card.Background">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Background">#F4F6F8</Color>
    <Color x:Key="Color.Surface.Overlay">#66000000</Color>
    <Color x:Key="Color.Shadow">#000000</Color>
    <Color x:Key="Color.Border.Card">#D5DADF</Color>
    <Color x:Key="Color.Border.Divider">#E7EAED</Color>
    <Color x:Key="Color.Border.Input">#C3C9CF</Color>
    <Color x:Key="Color.Border.PrimarySoft">#B7D2EC</Color>

    <Color x:Key="Color.Primary">#1466B8</Color>
    <Color x:Key="Color.Primary.Hover">#0F5599</Color>
    <Color x:Key="Color.Primary.Pressed">#0B4479</Color>
    <Color x:Key="Color.Primary.Accent">#4A8FD0</Color>
    <Color x:Key="Color.Primary.Soft">#E6EFF9</Color>
    <Color x:Key="Color.Primary.SoftPressed">#D6E5F5</Color>
    <Color x:Key="Color.Brand.Navigation">#1466B8</Color>

    <Color x:Key="Color.Text.Primary">#17191B</Color>
    <Color x:Key="Color.Text.CardTitle">#17191B</Color>
    <Color x:Key="Color.Text.Secondary">#3B434B</Color>
    <Color x:Key="Color.Text.Label">#515A63</Color>
    <Color x:Key="Color.Text.Muted">#666E77</Color>
    <Color x:Key="Color.Text.Disabled">#A0A7AE</Color>
    <Color x:Key="Color.Text.Placeholder">#A0A7AE</Color>
    <Color x:Key="Color.Text.Inverse">#FFFFFF</Color>

    <Color x:Key="Color.Icon.Default">#515A63</Color>
    <Color x:Key="Color.Icon.Primary">#1466B8</Color>
    <Color x:Key="Color.Icon.Success">#1B7F45</Color>
    <Color x:Key="Color.Icon.Warning">#9A6400</Color>
    <Color x:Key="Color.Icon.Error">#B5342A</Color>
    <Color x:Key="Color.Icon.Muted">#9AA1A8</Color>

    <!-- Shell 侧栏与窗口框架：桌面工具不再是深色侧栏，改用同族浅灰分区。 -->
    <Color x:Key="Color.Sidebar.Background">#1C2127</Color>
    <Color x:Key="Color.Sidebar.Hover">#2A3037</Color>
    <Color x:Key="Color.Sidebar.Active">#2E3B47</Color>
    <Color x:Key="Color.Sidebar.ActiveRail">#4AA3E8</Color>
    <Color x:Key="Color.Sidebar.IconActive">#7FC0F2</Color>
    <Color x:Key="Color.Sidebar.Text">#E8ECEF</Color>
    <Color x:Key="Color.Sidebar.TextMuted">#98A2AC</Color>

    <Color x:Key="Color.Table.Header">#E9ECEF</Color>
    <Color x:Key="Color.Table.AlternateRow">#FFFFFF</Color>
    <Color x:Key="Color.Progress.Track">#E2E4E7</Color>

    <Color x:Key="Color.Log.Panel">#F6F8F9</Color>
    <Color x:Key="Color.Log.PanelHover">#F3F5F6</Color>
    <Color x:Key="Color.Log.PanelSelected">#E8F1FB</Color>
    <Color x:Key="Color.Log.Text">#2B3138</Color>

    <Color x:Key="Color.Success">#1B7F45</Color>
    <Color x:Key="Color.Success.Soft">#E8F5EE</Color>
    <Color x:Key="Color.Success.Border">#A8D5BC</Color>

    <Color x:Key="Color.Warning">#96620A</Color>
    <Color x:Key="Color.Warning.Hover">#7E5200</Color>
    <Color x:Key="Color.Warning.Pressed">#664200</Color>
    <Color x:Key="Color.Warning.Soft">#FDF3E2</Color>
    <Color x:Key="Color.Warning.Border">#EBC98A</Color>
    <Color x:Key="Color.Warning.Text">#2B2112</Color>

    <Color x:Key="Color.Error">#B5342A</Color>
    <Color x:Key="Color.Error.Soft">#FBEAE8</Color>
    <Color x:Key="Color.Error.Border">#E7AEA6</Color>

    <Color x:Key="Color.Danger">#B5342A</Color>
    <Color x:Key="Color.Danger.Hover">#9C2A22</Color>
    <Color x:Key="Color.Danger.Pressed">#84231C</Color>
    <Color x:Key="Color.Danger.Soft">#FBEAE8</Color>
    <Color x:Key="Color.Danger.Border">#E7AEA6</Color>
    <Color x:Key="Color.Danger.Text">#FFFFFF</Color>

    <Color x:Key="Color.Neutral.Soft">#F3F4F5</Color>
    <Color x:Key="Color.Neutral.Border">#E2E4E7</Color>
    <!-- 深色框架（v3.3）：框架上的文字与图标不得复用内容区文字令牌，
         否则浅色文字会落到浅色内容区、深色文字会落到深色框架上。 -->
    <Color x:Key="Color.Chrome.Text">#E8ECEF</Color>
    <Color x:Key="Color.Chrome.TextMuted">#98A2AC</Color>
    <Color x:Key="Color.Chrome.Accent">#6FB3EE</Color>
    <Color x:Key="Color.Chrome.Hover">#333B44</Color>
    <Color x:Key="Color.Chrome.Pressed">#3E4750</Color>
    <Color x:Key="Color.Chrome.Divider">#3A424B</Color>
</ResourceDictionary>
