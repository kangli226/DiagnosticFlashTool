<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <FontFamily x:Key="Font.UI">Microsoft YaHei UI, Segoe UI, PingFang SC</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <system:Double x:Key="FontSize.Caption">11</system:Double>
    <system:Double x:Key="FontSize.Assist">12</system:Double>
    <system:Double x:Key="FontSize.Body">13</system:Double>
    <system:Double x:Key="FontSize.CardTitle">15</system:Double>
    <system:Double x:Key="FontSize.PageTitle">18</system:Double>
    <system:Double x:Key="LineHeight.Assist">19</system:Double>
    <system:Double x:Key="LineHeight.Body">22</system:Double>
    <system:Double x:Key="LineHeight.CardTitle">24</system:Double>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ValueCodeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Body}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Assist}" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Assist}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingToggleTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style x:Key="SettingAssistTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Assist}" />
    </Style>

    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource CardTitleTextBrush}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Body}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingGroupTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource SectionHeaderTextStyle}" />

    <Style x:Key="ConfigLabelTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource LabelTextBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    </Style>

    <Style x:Key="ConfigValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueCodeTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DialogTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.PageTitle}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.CardTitle}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{StaticResource CardTitleTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusBarTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusBarLabelTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource StatusBarTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource LabelTextBrush}" />
    </Style>

    <Style x:Key="StatusBarCountTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource StatusBarTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
    </Style>

    <Style x:Key="StatusBarCodeTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource StatusBarTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    </Style>

    <Style x:Key="MonoAssistTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource HintTextStyle}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
</ResourceDictionary>
