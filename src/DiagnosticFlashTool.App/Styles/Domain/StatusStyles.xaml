<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DiagnosticFlashTool.App.ViewModels">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="StatusValueTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StatusNeutralBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:DiagnosticStatusKind.Success}">
                <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:DiagnosticStatusKind.Running}">
                <Setter Property="Foreground" Value="{StaticResource StatusRunningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:DiagnosticStatusKind.Warning}">
                <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:DiagnosticStatusKind.Error}">
                <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StatusNeutralSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatusNeutralBorderBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:DiagnosticStatusKind.Success}">
                <Setter Property="Background" Value="{StaticResource StatusSuccessSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:DiagnosticStatusKind.Running}">
                <Setter Property="Background" Value="{StaticResource StatusRunningSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StatusRunningBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:DiagnosticStatusKind.Warning}">
                <Setter Property="Background" Value="{StaticResource StatusWarningSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:DiagnosticStatusKind.Error}">
                <Setter Property="Background" Value="{StaticResource StatusErrorSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource StatusNeutralSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatusNeutralBorderBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:DiagnosticStatusKind.Success}">
                <Setter Property="Background" Value="{StaticResource StatusSuccessSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:DiagnosticStatusKind.Running}">
                <Setter Property="Background" Value="{StaticResource StatusRunningSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StatusRunningBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:DiagnosticStatusKind.Warning}">
                <Setter Property="Background" Value="{StaticResource StatusWarningSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBorderBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:DiagnosticStatusKind.Error}">
                <Setter Property="Background" Value="{StaticResource StatusErrorSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StatusNeutralBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="{x:Static vm:DiagnosticStatusKind.Success}">
                <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="{x:Static vm:DiagnosticStatusKind.Running}">
                <Setter Property="Foreground" Value="{StaticResource StatusRunningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="{x:Static vm:DiagnosticStatusKind.Warning}">
                <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="{x:Static vm:DiagnosticStatusKind.Error}">
                <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusIconBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource StatusNeutralBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:DiagnosticStatusKind.Success}">
                <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:DiagnosticStatusKind.Running}">
                <Setter Property="BorderBrush" Value="{StaticResource StatusRunningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:DiagnosticStatusKind.Warning}">
                <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:DiagnosticStatusKind.Error}">
                <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusIconTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource StatusNeutralBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,-3,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="{x:Static vm:DiagnosticStatusKind.Success}">
                <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="{x:Static vm:DiagnosticStatusKind.Running}">
                <Setter Property="Foreground" Value="{StaticResource StatusRunningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="{x:Static vm:DiagnosticStatusKind.Warning}">
                <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="{x:Static vm:DiagnosticStatusKind.Error}">
                <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
