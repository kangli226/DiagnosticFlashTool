<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DiagnosticFlashTool.App.ViewModels">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="FunctionCheckCellTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,0" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FunctionCheckResultCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource FunctionCheckCellTextStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding ResultStatusKind}" Value="{x:Static vm:DiagnosticStatusKind.Success}">
                <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ResultStatusKind}" Value="{x:Static vm:DiagnosticStatusKind.Error}">
                <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ResultStatusKind}" Value="{x:Static vm:DiagnosticStatusKind.Warning}">
                <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ResultStatusKind}" Value="{x:Static vm:DiagnosticStatusKind.Running}">
                <Setter Property="Foreground" Value="{StaticResource StatusRunningBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
