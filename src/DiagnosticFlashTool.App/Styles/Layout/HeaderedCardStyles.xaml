<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Brushes.xaml" />
        <ResourceDictionary Source="CardStyles.xaml" />
        <ResourceDictionary Source="PageStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <GridLength x:Key="HeaderedCardHeaderHeight">44</GridLength>
    <Thickness x:Key="HeaderedCardHeaderTopInset">0,8,0,0</Thickness>
    <Thickness x:Key="HeaderedCardBodyPadding">16,0,16,16</Thickness>
    <Thickness x:Key="HeaderedCardCenteredBodyPadding">16,0</Thickness>

    <Style x:Key="HeaderedCard.Base" TargetType="{x:Type controls:HeaderedCard}">
        <Setter Property="HeaderHeight" Value="{StaticResource HeaderedCardHeaderHeight}" />
        <Setter Property="HeaderPadding" Value="{StaticResource CardHeaderContentPadding}" />
        <Setter Property="BodyPadding" Value="{StaticResource HeaderedCardBodyPadding}" />
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource CardHeaderTextStyle}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:HeaderedCard}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerRadius.Card}"
                            Effect="{TemplateBinding Effect}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{TemplateBinding HeaderHeight}" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="{TemplateBinding HeaderPadding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 标题按距卡片顶部固定内缩定位，与标题栏高度解耦，避免各卡片标题顶边错位。 -->
                                    <ContentPresenter Grid.Column="0"
                                                      ContentSource="Header"
                                                      Margin="{StaticResource HeaderedCardHeaderTopInset}"
                                                      VerticalAlignment="Top" />
                                    <ContentPresenter Grid.Column="1"
                                                      Content="{TemplateBinding Actions}"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ContentPresenter Grid.Row="1"
                                              Margin="{TemplateBinding BodyPadding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{StaticResource CardElevatedShadowEffect}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HeaderedCard.Form"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Base}" />

    <Style x:Key="HeaderedCard.Form.Lead"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Form}">
        <Setter Property="Margin" Value="{StaticResource PageCardBottomGap}" />
    </Style>

    <!-- .Actions 仅表达“标题栏含多个工具栏按钮”的语义；标题栏高度与标准一致，
         避免标题顶边随操作区高度漂移。 -->
    <Style x:Key="HeaderedCard.Form.Actions"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Form}" />

    <Style x:Key="HeaderedCard.Form.Actions.Lead"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Form.Actions}">
        <Setter Property="Margin" Value="{StaticResource PageCardBottomGap}" />
    </Style>

    <Style x:Key="HeaderedCard.Panel"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Base}" />

    <Style x:Key="HeaderedCard.Panel.Lead"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Panel}">
        <Setter Property="Margin" Value="{StaticResource PageCardBottomGap}" />
    </Style>

    <Style x:Key="HeaderedCard.Panel.Centered"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Panel}">
        <Setter Property="BodyPadding" Value="{StaticResource HeaderedCardCenteredBodyPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="HeaderedCard.Panel.Centered.Lead"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Panel.Centered}">
        <Setter Property="Margin" Value="{StaticResource PageCardBottomGap}" />
    </Style>

    <Style x:Key="HeaderedCard.Data"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Base}" />

    <Style x:Key="HeaderedCard.Data.Actions"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Data}" />

    <Style x:Key="HeaderedCard.Data.Actions.Lead"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Data.Actions}">
        <Setter Property="Margin" Value="{StaticResource PageCardBottomGap}" />
    </Style>

    <Style x:Key="HeaderedCard.Data.Lead"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Data}">
        <Setter Property="Margin" Value="{StaticResource PageCardBottomGap}" />
    </Style>
</ResourceDictionary>
