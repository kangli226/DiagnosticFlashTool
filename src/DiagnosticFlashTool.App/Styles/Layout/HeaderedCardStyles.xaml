<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Brushes.xaml" />
        <ResourceDictionary Source="CardStyles.xaml" />
        <ResourceDictionary Source="PageStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="HeaderedCard.Base" TargetType="{x:Type controls:HeaderedCard}">
        <Setter Property="HeaderHeight" Value="50" />
        <Setter Property="HeaderPadding" Value="{StaticResource CardHeaderContentPadding}" />
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource CardContentPadding}" />
        <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource CardHeaderTextStyle}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:HeaderedCard}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerRadius.Card}"
                            Effect="{TemplateBinding Effect}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{TemplateBinding HeaderHeight}" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="{TemplateBinding HeaderPadding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center" />
                                    <ContentPresenter Grid.Column="1"
                                                      Content="{TemplateBinding Actions}"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ContentPresenter Grid.Row="1"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{StaticResource CardElevatedShadowEffect}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HeaderedCard.Form"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Base}">
        <Setter Property="HeaderHeight" Value="44" />
        <Setter Property="Padding" Value="16,0,16,16" />
    </Style>

    <Style x:Key="HeaderedCard.Form.Lead"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Form}">
        <Setter Property="Margin" Value="{StaticResource PageCardBottomGap}" />
    </Style>

    <Style x:Key="HeaderedCard.Panel"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Base}">
        <Setter Property="Padding" Value="16,12,16,12" />
    </Style>

    <Style x:Key="HeaderedCard.Panel.Lead"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Panel}">
        <Setter Property="Margin" Value="{StaticResource PageCardBottomGap}" />
    </Style>

    <Style x:Key="HeaderedCard.Data"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Base}">
        <Setter Property="Padding" Value="{StaticResource CardDataContentMargin}" />
    </Style>

    <Style x:Key="HeaderedCard.Data.Lead"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Data}">
        <Setter Property="Margin" Value="{StaticResource PageCardBottomGap}" />
    </Style>
</ResourceDictionary>
