<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Brushes.xaml" />
        <ResourceDictionary Source="CardStyles.xaml" />
        <ResourceDictionary Source="PageStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Thickness x:Key="HeaderedCardBodyPadding">17,0,12,10</Thickness>
    <Thickness x:Key="HeaderedCardDividedBodyPadding">17,12,12,12</Thickness>
    <!-- 数据卡片（表格、列表）的正文内边距：表格是整块矩形，四边留白必须等宽，
         否则左 17 / 右 12 / 下 10 会让表格看起来偏向一侧。上边沿用 0，
         由标题行与正文之间的留白承担。 -->
    <Thickness x:Key="HeaderedCardDataBodyPadding">17,0,17,17</Thickness>

    <Style x:Key="HeaderedCard.Base" TargetType="{x:Type controls:HeaderedCard}">
        <Setter Property="HeaderHeight" Value="{Binding Source={StaticResource CardContentRowHeight}, Mode=OneTime}" />
        <Setter Property="HeaderTopInset" Value="{Binding Top, Source={StaticResource CardContentPadding}, Mode=OneTime}" />
        <Setter Property="HeaderPadding" Value="{StaticResource CardHorizontalContentPadding}" />
        <Setter Property="BodyPadding" Value="{StaticResource HeaderedCardBodyPadding}" />
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource CardHeaderTextStyle}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:HeaderedCard}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerRadius.Card}"
                            Effect="{TemplateBinding Effect}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{TemplateBinding HeaderTopInset}" />
                                <RowDefinition Height="{TemplateBinding HeaderHeight}" />
                                <RowDefinition Height="{TemplateBinding HeaderTopInset}" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="1" Margin="{TemplateBinding HeaderPadding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  Content="{TemplateBinding Actions}"
                                                  VerticalAlignment="Center" />
                            </Grid>

                            <Border x:Name="HeaderDivider" Grid.Row="3" Height="1"
                                    Background="{StaticResource DividerBrush}" Visibility="Collapsed" />

                            <ContentPresenter Grid.Row="4"
                                              Margin="{TemplateBinding BodyPadding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowHeaderDivider" Value="True">
                            <Setter TargetName="HeaderDivider" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="ShowHeaderDivider" Value="True">
                <Setter Property="BodyPadding" Value="{StaticResource HeaderedCardDividedBodyPadding}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{StaticResource CardElevatedShadowEffect}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HeaderedCard.Form"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Base}" />

    <Style x:Key="HeaderedCard.Form.Lead"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Form}">
        <Setter Property="Margin" Value="{StaticResource PageCardBottomGap}" />
    </Style>

    <!-- .Actions 仅表达“标题栏含多个工具栏按钮”的语义；标题栏高度与标准一致，
         避免标题顶边随操作区高度漂移。 -->
    <Style x:Key="HeaderedCard.Form.Actions"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Form}" />

    <Style x:Key="HeaderedCard.Form.Actions.Lead"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Form.Actions}">
        <Setter Property="Margin" Value="{StaticResource PageCardBottomGap}" />
    </Style>

    <Style x:Key="HeaderedCard.Panel"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Base}" />

    <Style x:Key="HeaderedCard.Panel.Lead"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Panel}">
        <Setter Property="Margin" Value="{StaticResource PageCardBottomGap}" />
    </Style>

    <Style x:Key="HeaderedCard.Panel.Centered"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Panel}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="HeaderedCard.Panel.Centered.Lead"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Panel.Centered}">
        <Setter Property="Margin" Value="{StaticResource PageCardBottomGap}" />
    </Style>

    <!-- 数据区正文四边统一 17 DIP：左右底与内容区左侧留白同值，表格边框不再贴边或偏斜。 -->
    <Style x:Key="HeaderedCard.Data"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Base}">
        <Setter Property="BodyPadding" Value="{StaticResource HeaderedCardDataBodyPadding}" />
    </Style>

    <Style x:Key="HeaderedCard.Data.Actions"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Data}" />

    <Style x:Key="HeaderedCard.Data.Actions.Lead"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Data.Actions}">
        <Setter Property="Margin" Value="{StaticResource PageCardBottomGap}" />
    </Style>

    <Style x:Key="HeaderedCard.Data.Lead"
           TargetType="{x:Type controls:HeaderedCard}"
           BasedOn="{StaticResource HeaderedCard.Data}">
        <Setter Property="Margin" Value="{StaticResource PageCardBottomGap}" />
    </Style>
</ResourceDictionary>
