<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Brushes.xaml" />
        <ResourceDictionary Source="CardStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- 页面留白两级：外边距 16 大于区块间距 14，让一组卡片整体"浮"在内容区里。
         改节奏只动本节令牌，页面与视图不写数值。 -->
    <Thickness x:Key="PageMargin">16,16,16,16</Thickness>
    <Thickness x:Key="PageCardBottomGap">0,0,0,14</Thickness>
    <Thickness x:Key="PageCardTopGap">0,14,0,0</Thickness>
    <Thickness x:Key="PageContentBottomGap">0,0,0,8</Thickness>
    <Thickness x:Key="PageContentTopGap">0,8,0,0</Thickness>
    <Thickness x:Key="FormAssistTextAfterLabelMargin">100,0,0,0</Thickness>

    <Style x:Key="PageRootGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource PageMargin}" />
    </Style>

    <Style x:Key="PageSectionGapRowStyle" TargetType="RowDefinition">
        <Setter Property="Height" Value="14" />
    </Style>

    <Style x:Key="PageHeaderGapRowStyle"
           TargetType="RowDefinition"
           BasedOn="{StaticResource PageSectionGapRowStyle}">
        <Setter Property="Height" Value="6" />
    </Style>

    <Style x:Key="PageSummaryRowStyle" TargetType="RowDefinition">
        <Setter Property="Height" Value="96" />
    </Style>

    <Style x:Key="PageColumnGapStyle" TargetType="ColumnDefinition">
        <Setter Property="Width" Value="14" />
    </Style>

    <!-- 中文标签最长 7 字（如"CAN FD 能力"），100 可容纳而不裁切。 -->
    <Style x:Key="FormLabelColumnStyle" TargetType="ColumnDefinition">
        <Setter Property="Width" Value="100" />
    </Style>

    <Style x:Key="PageLeadStandardCardStyle" TargetType="Border" BasedOn="{StaticResource Card.Form}">
        <Setter Property="Margin" Value="{StaticResource PageCardBottomGap}" />
    </Style>

    <Style x:Key="PageTrailingStandardCardStyle" TargetType="Border" BasedOn="{StaticResource Card.Form}">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="PageTrailingCompactCardStyle" TargetType="Border" BasedOn="{StaticResource Card.Compact}">
        <Setter Property="Margin" Value="{StaticResource PageCardTopGap}" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Assist}" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="EmptyStateTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.PageTitle}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PageSummaryCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}" />

    <Style x:Key="PageSummaryContentStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="{StaticResource CardHorizontalContentPadding}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
