<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Brushes.xaml" />
        <ResourceDictionary Source="../Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        桌面工具改版：卡片退化为"1px 边框分区"，去掉投影与悬停抬升，
        内边距由 16 压到 12，让窗口在 1440×860 下能多放两行数据。
    -->
    <!-- 以帧 ID 工具条为基准，首行高 32 DIP，左侧留 17 DIP，上下各留 10 DIP。 -->
    <system:Double x:Key="CardContentRowHeight">32</system:Double>
    <Thickness x:Key="CardContentPadding">17,10,12,10</Thickness>
    <Thickness x:Key="CardHorizontalContentPadding">17,0,12,0</Thickness>

    <!-- 无标题卡片的内容行：首行（或唯一行）与「帧 ID」工具条同高。
         单行卡片因此统一为 1 + 10 + 32 + 10 + 1 = 54 DIP；内容不足 32 DIP 时在该行内垂直居中，
         多行卡片只保证首行高度，增加行数不改变上下留白。 -->
    <Style x:Key="Card.ContentRow" TargetType="{x:Type FrameworkElement}">
        <Setter Property="MinHeight" Value="{StaticResource CardContentRowHeight}" />
    </Style>

    <!-- 保留键名以兼容既有引用；桌面工具不使用投影，值统一为 null。 -->
    <DropShadowEffect x:Key="CardShadowEffect"
                      Color="{StaticResource Color.Shadow}"
                      Direction="270"
                      ShadowDepth="0"
                      BlurRadius="0"
                      Opacity="0" />
    <DropShadowEffect x:Key="CardElevatedShadowEffect"
                      Color="{StaticResource Color.Shadow}"
                      Direction="270"
                      ShadowDepth="0"
                      BlurRadius="0"
                      Opacity="0" />

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="{StaticResource CardContentPadding}" />
    </Style>

    <Style x:Key="Card.Elevated" TargetType="Border" BasedOn="{StaticResource CardStyle}" />

    <Style x:Key="Card.Compact" TargetType="Border" BasedOn="{StaticResource CardStyle}" />

    <Style x:Key="Card.Standard" TargetType="Border" BasedOn="{StaticResource CardStyle}" />

    <Style x:Key="Card.Toolbar" TargetType="Border" BasedOn="{StaticResource CardStyle}" />

    <Style x:Key="Card.Form" TargetType="Border" BasedOn="{StaticResource Card.Standard}" />

    <!-- Standard form card rhythm: title gap 8, row gap 8, no extra last-row gap. -->
    <Style x:Key="Card.FormContent" TargetType="{x:Type controls:CardContentPanel}">
        <Setter Property="FirstChildIsHeader" Value="True" />
        <Setter Property="HeaderSpacing" Value="8" />
        <Setter Property="RowSpacing" Value="8" />
        <Setter Property="LastRowBottomSpacing" Value="0" />
    </Style>

    <Style x:Key="Card.FormRowsContent"
           TargetType="{x:Type controls:CardContentPanel}"
           BasedOn="{StaticResource Card.FormContent}">
        <Setter Property="FirstChildIsHeader" Value="False" />
    </Style>

    <Style x:Key="DialogPanelStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Card}" />
    </Style>

    <Style x:Key="DialogOverlayStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OverlayBrush}" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- 设置分组：浅灰底 + 1px 分隔，替代卡片内再套卡片。 -->
    <Style x:Key="SettingGroupPanelStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource CardContentPadding}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Control}" />
    </Style>

    <Style x:Key="CardHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.CardTitle}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.CardTitle}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Foreground" Value="{StaticResource CardTitleTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource LabelTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="PathDisplayLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0,4" />
    </Style>
</ResourceDictionary>
