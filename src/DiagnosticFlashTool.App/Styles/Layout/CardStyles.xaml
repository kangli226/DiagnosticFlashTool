<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Brushes.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Thickness x:Key="CardHeaderContentPadding">22,0</Thickness>
    <Thickness x:Key="PageCardContentPadding">16</Thickness>
    <Thickness x:Key="CardFormContentPadding">16</Thickness>
    <Thickness x:Key="CardContentTitleMargin">0,0,0,10</Thickness>
    <DropShadowEffect x:Key="CardShadowEffect"
                      Color="#0F172A"
                      Direction="270"
                      ShadowDepth="1"
                      BlurRadius="2"
                      Opacity="0.04" />
    <DropShadowEffect x:Key="CardElevatedShadowEffect"
                      Color="#0F172A"
                      Direction="270"
                      ShadowDepth="4"
                      BlurRadius="12"
                      Opacity="0.06" />

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Card}" />
        <Setter Property="Effect" Value="{StaticResource CardShadowEffect}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{StaticResource CardElevatedShadowEffect}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Card.Elevated" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Effect" Value="{StaticResource CardElevatedShadowEffect}" />
    </Style>

    <Style x:Key="Card.Compact" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="{StaticResource PageCardContentPadding}" />
    </Style>

    <Style x:Key="Card.Standard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="{StaticResource PageCardContentPadding}" />
    </Style>

    <!-- Card.Form fixes the title-to-card and last-row-to-card distances via padding. -->
    <Style x:Key="Card.Form" TargetType="Border" BasedOn="{StaticResource Card.Standard}">
        <Setter Property="Padding" Value="{StaticResource CardFormContentPadding}" />
    </Style>

    <!-- Standard form card rhythm: title gap 10, row gap 12, no extra last-row gap. -->
    <Style x:Key="Card.FormContent" TargetType="{x:Type controls:CardContentPanel}">
        <Setter Property="HeaderSpacing" Value="10" />
        <Setter Property="RowSpacing" Value="12" />
        <Setter Property="LastRowBottomSpacing" Value="0" />
    </Style>

    <Style x:Key="DialogPanelStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="24" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Card}" />
    </Style>

    <Style x:Key="DialogOverlayStyle" TargetType="Border">
        <Setter Property="Background" Value="#66000000" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="SettingGroupPanelStyle" TargetType="Border">
        <Setter Property="Padding" Value="14" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Control}" />
    </Style>

    <Style x:Key="CardHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CardTitleTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CardContentTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource CardHeaderTextStyle}">
        <Setter Property="Margin" Value="{StaticResource CardContentTitleMargin}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Used inside CardContentPanel; the panel owns the title-to-first-row gap. -->
    <Style x:Key="CardContentPanelTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource CardHeaderTextStyle}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="CardContentPanelHeaderGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="CardContentHeaderGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource CardContentTitleMargin}" />
    </Style>

    <Style x:Key="CardContentTitleGapRowStyle" TargetType="RowDefinition">
        <Setter Property="Height" Value="10" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource LabelTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
</ResourceDictionary>
