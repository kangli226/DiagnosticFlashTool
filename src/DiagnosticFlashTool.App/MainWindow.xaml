<Window x:Class="DiagnosticFlashTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:DiagnosticFlashTool.App.Views"
        Title="BOOT刷写工具"
        Width="1440"
        Height="860"
        MinWidth="1180"
        MinHeight="760"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Border Width="28"
                            Height="28"
                            Background="{StaticResource BrandNavigationBrush}"
                            CornerRadius="7">
                        <TextBlock Text="B"
                                   Foreground="{StaticResource InverseTextBrush}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="BOOT刷写工具"
                               Margin="10,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button ToolTip="最小化"
                            Style="{StaticResource ChromeButtonStyle}"
                            Click="Minimize_Click">
                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.WindowMinimize}"
                                                 Style="{StaticResource Button.PackIcon}"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button ToolTip="最大化"
                            Style="{StaticResource ChromeButtonStyle}"
                            Click="Maximize_Click">
                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.WindowMaximize}"
                                                 Style="{StaticResource Button.PackIcon}"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button ToolTip="关闭"
                            Style="{StaticResource CloseChromeButtonStyle}"
                            Click="Close_Click">
                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.Close}"
                                                 Style="{StaticResource Button.PackIcon}"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="1079*" />
                <ColumnDefinition Width="105*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer Margin="0,22,0,8"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="刷写中心"
                                   Style="{StaticResource ShellNavGroupTextStyle}" />
                        <RadioButton Content="固件刷写"
                                     Tag="{x:Static materialDesign:PackIconKind.FlashOutline}"
                                     CommandParameter="0"
                                     IsChecked="True"
                                     Checked="ShellNav_Checked"
                                     Style="{StaticResource ShellNavRadioButtonStyle}" />
                        <RadioButton Content="刷写监控"
                                     Tag="{x:Static materialDesign:PackIconKind.MonitorDashboard}"
                                     CommandParameter="1"
                                     Checked="ShellNav_Checked"
                                     Style="{StaticResource ShellNavRadioButtonStyle}" />
                        <RadioButton Content="历史记录"
                                     Tag="{x:Static materialDesign:PackIconKind.History}"
                                     CommandParameter="2"
                                     Checked="ShellNav_Checked"
                                     Style="{StaticResource ShellNavRadioButtonStyle}" />

                        <TextBlock Text="诊断测试"
                                   Style="{StaticResource ShellNavGroupTextStyle}" />
                        <RadioButton Content="功能检测"
                                     Tag="{x:Static materialDesign:PackIconKind.CheckCircleOutline}"
                                     CommandParameter="3"
                                     Checked="ShellNav_Checked"
                                     Style="{StaticResource ShellNavRadioButtonStyle}" />

                        <TextBlock Text="配置管理"
                                   Style="{StaticResource ShellNavGroupTextStyle}" />
                        <RadioButton Content="项目配置"
                                     Tag="{x:Static materialDesign:PackIconKind.FolderCogOutline}"
                                     CommandParameter="4"
                                     Checked="ShellNav_Checked"
                                     Style="{StaticResource ShellNavRadioButtonStyle}" />
                        <RadioButton Content="流程配置"
                                     Tag="{x:Static materialDesign:PackIconKind.FileTreeOutline}"
                                     CommandParameter="5"
                                     Checked="ShellNav_Checked"
                                     Style="{StaticResource ShellNavRadioButtonStyle}" />
                        <RadioButton Content="算法配置"
                                     Tag="{x:Static materialDesign:PackIconKind.FunctionVariant}"
                                     CommandParameter="6"
                                     Checked="ShellNav_Checked"
                                     Style="{StaticResource ShellNavRadioButtonStyle}" />

                        <TextBlock Text="系统"
                                   Style="{StaticResource ShellNavGroupTextStyle}" />
                        <RadioButton Content="系统设置"
                                     Tag="{x:Static materialDesign:PackIconKind.CogOutline}"
                                     CommandParameter="7"
                                     Checked="ShellNav_Checked"
                                     Style="{StaticResource ShellNavRadioButtonStyle}" />
                        <RadioButton Content="开发者选项"
                                     Tag="{x:Static materialDesign:PackIconKind.Console}"
                                     CommandParameter="8"
                                     Checked="ShellNav_Checked"
                                     Style="{StaticResource ShellNavRadioButtonStyle}" />
                        <RadioButton Content="日志"
                                     Tag="{x:Static materialDesign:PackIconKind.TextBoxOutline}"
                                     CommandParameter="9"
                                     Checked="ShellNav_Checked"
                                     Style="{StaticResource ShellNavRadioButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TabControl Grid.Column="1"
                        x:Name="MainTabs"
                        Style="{StaticResource ShellContentTabControlStyle}"
                        SelectedIndex="{Binding SelectedShellIndex, Mode=TwoWay}" Grid.ColumnSpan="2">
                <TabItem>
                    <views:FirmwareFlashView />
                </TabItem>

                <TabItem>
                    <views:FlashMonitorView />
                </TabItem>

                <TabItem>
                    <views:FlashHistoryView />
                </TabItem>

                <TabItem>
                    <views:FunctionCheckView />
                </TabItem>

                <TabItem>
                    <views:ProjectConfigView />
                </TabItem>

                <TabItem>
                    <views:FlowConfigView />
                </TabItem>

                <TabItem>
                    <views:AlgorithmConfigView />
                </TabItem>

                <TabItem>
                    <views:SystemSettingsView />
                </TabItem>

                <TabItem>
                    <views:DeveloperOptionsView />
                </TabItem>

                <TabItem>
                    <views:SystemLogView />
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource AppBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="当前位置"
                           Margin="14,0,44,0"
                           FontSize="13"
                           Foreground="{StaticResource LabelTextBrush}" />
                <TextBlock Text="{Binding StatusBarContextText}"
                           FontSize="13"
                           FontWeight="Normal"
                           Foreground="{StaticResource BodyTextBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
