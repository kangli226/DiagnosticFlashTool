<Window x:Class="DiagnosticFlashTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls"
        xmlns:views="clr-namespace:DiagnosticFlashTool.App.Views"
        Title="BOOT刷写工具"
        Width="1440"
        Height="860"
        MinWidth="1180"
        MinHeight="760"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="{StaticResource CornerRadius.Window}"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Border Width="28"
                            Height="28"
                            Background="{StaticResource BrandNavigationBrush}"
                            CornerRadius="{StaticResource CornerRadius.Brand}">
                        <TextBlock Text="B"
                                   Foreground="{StaticResource InverseTextBrush}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="BOOT刷写工具"
                               Margin="10,0,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button ToolTip="最小化"
                            Style="{StaticResource ChromeButtonStyle}"
                            Click="Minimize_Click">
                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.WindowMinimize}"
                                                 Style="{StaticResource Button.PackIcon}"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button ToolTip="最大化"
                            Style="{StaticResource ChromeButtonStyle}"
                            Click="Maximize_Click">
                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.WindowMaximize}"
                                                 Style="{StaticResource Button.PackIcon}"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button ToolTip="关闭"
                            Style="{StaticResource CloseChromeButtonStyle}"
                            Click="Close_Click">
                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.Close}"
                                                 Style="{StaticResource Button.PackIcon}"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="1079*" />
                <ColumnDefinition Width="105*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer Margin="0,22,0,8"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="刷写中心"
                                       Style="{StaticResource ShellNavGroupTextStyle}" />
                            <RadioButton Content="固件刷写"
                                         Tag="{x:Static materialDesign:PackIconKind.FlashOutline}"
                                         CommandParameter="0"
                                         IsChecked="True"
                                         Checked="ShellNav_Checked"
                                         Style="{StaticResource ShellNavRadioButtonStyle}" />
                            <RadioButton Content="开发者选项"
                                         Tag="{x:Static materialDesign:PackIconKind.Console}"
                                         CommandParameter="1"
                                         Checked="ShellNav_Checked"
                                         Style="{StaticResource ShellNavRadioButtonStyle}" />
                            <RadioButton Content="历史记录"
                                         Tag="{x:Static materialDesign:PackIconKind.History}"
                                         CommandParameter="2"
                                         Checked="ShellNav_Checked"
                                         Style="{StaticResource ShellNavRadioButtonStyle}" />

                            <TextBlock Text="配置管理"
                                       Style="{StaticResource ShellNavGroupTextStyle}" />
                            <RadioButton Content="项目配置"
                                         Tag="{x:Static materialDesign:PackIconKind.FolderCogOutline}"
                                         CommandParameter="3"
                                         Checked="ShellNav_Checked"
                                         Style="{StaticResource ShellNavRadioButtonStyle}" />
                            <RadioButton Content="流程配置"
                                         Tag="{x:Static materialDesign:PackIconKind.FileTreeOutline}"
                                         CommandParameter="4"
                                         Checked="ShellNav_Checked"
                                         Style="{StaticResource ShellNavRadioButtonStyle}" />
                            <RadioButton Content="算法配置"
                                         Tag="{x:Static materialDesign:PackIconKind.FunctionVariant}"
                                         CommandParameter="5"
                                         Checked="ShellNav_Checked"
                                         Style="{StaticResource ShellNavRadioButtonStyle}" />

                            <TextBlock Text="系统"
                                       Style="{StaticResource ShellNavGroupTextStyle}" />
                            <RadioButton Content="系统设置"
                                         Tag="{x:Static materialDesign:PackIconKind.CogOutline}"
                                         CommandParameter="6"
                                         Checked="ShellNav_Checked"
                                         Style="{StaticResource ShellNavRadioButtonStyle}" />
                            <RadioButton Content="日志"
                                         Tag="{x:Static materialDesign:PackIconKind.TextBoxOutline}"
                                         CommandParameter="7"
                                         Checked="ShellNav_Checked"
                                         Style="{StaticResource ShellNavRadioButtonStyle}" />
                        </StackPanel>
                </ScrollViewer>
            </Border>

            <TabControl Grid.Column="1"
                        x:Name="MainTabs"
                        Style="{StaticResource ShellContentTabControlStyle}"
                        SelectedIndex="{Binding SelectedShellIndex, Mode=TwoWay}" Grid.ColumnSpan="2">
                <TabItem>
                    <views:FirmwareFlashView />
                </TabItem>

                <TabItem>
                    <views:DeveloperOptionsView />
                </TabItem>

                <TabItem>
                    <views:FlashHistoryView />
                </TabItem>

                <TabItem>
                    <views:ProjectConfigView />
                </TabItem>

                <TabItem>
                    <views:FlowConfigView />
                </TabItem>

                <TabItem>
                    <views:AlgorithmConfigView />
                </TabItem>

                <TabItem>
                    <views:SystemSettingsView />
                </TabItem>

                <TabItem>
                    <views:SystemLogView />
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource AppBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1,1,0,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusBarDeviceText}"
                           Margin="14,0,0,0"
                           FontSize="13"
                           Foreground="{StaticResource BodyTextBrush}"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1"
                        Width="1"
                        Height="16"
                        Margin="14,0"
                        Background="{StaticResource DividerBrush}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding StatusBarProjectText}"
                           ToolTip="{Binding StatusBarProjectText}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="13"
                           Foreground="{StaticResource BodyTextBrush}"
                           VerticalAlignment="Center" />
                <Border Grid.Column="3"
                        Width="1"
                        Height="16"
                        Margin="14,0"
                        Background="{StaticResource DividerBrush}" />
                <TextBlock Grid.Column="4"
                           Text="{Binding StatusBarStateText}"
                           FontSize="13"
                           Foreground="{StaticResource BodyTextBrush}"
                           VerticalAlignment="Center" />
                <Border Grid.Column="5"
                        Width="1"
                        Height="16"
                        Margin="14,0"
                        Background="{StaticResource DividerBrush}" />

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.TextBoxOutline}"
                                             Width="16"
                                             Height="16"
                                             Foreground="{StaticResource IconPrimaryBrush}"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="最新日志"
                               Margin="6,0,0,0"
                               FontSize="13"
                               Foreground="{StaticResource LabelTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="7"
                           Text="{Binding LatestLogText}"
                           ToolTip="{Binding LatestLogText}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="13"
                           Foreground="{StaticResource BodyTextBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="8"
                           Text="{Binding LogEntryCountText}"
                           Margin="14,0,10,0"
                           FontSize="12"
                           Foreground="{StaticResource SubtleTextBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="9"
                        Command="{Binding OpenRuntimeLogPageCommand}"
                        Style="{StaticResource Button.ToolBar}"
                        Margin="0,0,10,0"
                        Padding="10,0">
                    <StackPanel Style="{StaticResource Button.InlineContent}">
                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.ArrowRight}"
                                                 Style="{StaticResource Button.PackIcon.Current}" />
                        <TextBlock Text="查看"
                                   Style="{StaticResource Button.IconLabel}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border x:Name="NewFlowProjectDialogOverlay"
                Grid.Row="0"
                Grid.RowSpan="3"
                Panel.ZIndex="1001"
                IsVisibleChanged="NewFlowProjectDialogOverlay_IsVisibleChanged">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource DialogOverlayStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNewFlowProjectDialogVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Width="640"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogPanelStyle}">
                <Grid KeyboardNavigation.TabNavigation="Cycle">
                    <Grid.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConfirmNewFlowProjectCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding CancelNewFlowProjectCommand}" />
                    </Grid.InputBindings>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="{x:Static materialDesign:PackIconKind.FolderPlusOutline}"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="{StaticResource PrimaryBrush}"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="新建配置"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CardTitleTextBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource SettingGroupPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="配置名称"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBox x:Name="NewFlowProjectNameTextBox"
                                     Grid.Row="2"
                                     Height="40"
                                     Margin="0"
                                     Text="{Binding NewFlowProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SoftTextBoxStyle}" />

                            <TextBlock Grid.Row="4"
                                       Text="创建方式"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <StackPanel Grid.Row="6" Orientation="Horizontal">
                                <RadioButton Content="基于已有配置创建"
                                             GroupName="FlowProjectCreationMode"
                                             Margin="0,0,24,0"
                                             VerticalAlignment="Center"
                                             IsEnabled="{Binding HasBootConfigTemplates}"
                                             IsChecked="{Binding CreateFlowProjectFromTemplate, Mode=TwoWay}" />
                                <RadioButton Content="空白创建"
                                             GroupName="FlowProjectCreationMode"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding CreateBlankFlowProject, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource SettingGroupPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="已有 BOOT 配置"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <ComboBox Grid.Row="2"
                                      Width="Auto"
                                      Height="40"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding BootConfigFiles}"
                                      SelectedItem="{Binding SelectedFlowProjectTemplate, Mode=TwoWay}"
                                      IsEnabled="{Binding CreateFlowProjectFromTemplate}"
                                      Style="{StaticResource StandardComboBoxStyle}" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="5"
                               Text="{Binding NewFlowProjectValidationText}"
                               Foreground="{StaticResource StatusErrorBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Command="{Binding CancelNewFlowProjectCommand}"
                                Width="88"
                                Margin="0,0,12,0"
                                Style="{StaticResource Button.DialogSecondary}">
                            <TextBlock Text="取消" Style="{StaticResource Button.IconLabel}" Margin="0" />
                        </Button>
                        <Button Command="{Binding ConfirmNewFlowProjectCommand}"
                                Width="104"
                                Style="{StaticResource Button.DialogPrimary}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.CheckCircleOutline}"
                                                         Style="{StaticResource Button.PackIcon.Current}" />
                                <TextBlock Text="创建" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="FlowStepTemplateDialogOverlay"
                Grid.Row="0"
                Grid.RowSpan="3"
                Panel.ZIndex="1000"
                IsVisibleChanged="FlowStepTemplateDialogOverlay_IsVisibleChanged">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource DialogOverlayStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAddFlowStepDialogVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Width="700"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogPanelStyle}">
                <Grid KeyboardNavigation.TabNavigation="Cycle">
                    <Grid.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConfirmAddFlowStepCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding CancelAddFlowStepCommand}" />
                    </Grid.InputBindings>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="{x:Static materialDesign:PackIconKind.Plus}"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="{StaticResource PrimaryBrush}"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding FlowStepTemplateDialogTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CardTitleTextBrush}" />
                            <TextBlock Text="{Binding FlowStepTemplateDialogDescription}"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource HintTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource SettingGroupPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="节点模板"
                                       Margin="0,0,0,12"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <Grid>
                                <ComboBox x:Name="FlowStepTemplateComboBox"
                                          Width="Auto"
                                          Height="44"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding FlowStepTemplates}"
                                          SelectedItem="{Binding SelectedFlowStepTemplate, Mode=TwoWay}"
                                          MaxDropDownHeight="360"
                                          Style="{StaticResource StandardComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}"
                                                       MaxWidth="590"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="请选择节点模板"
                                           Margin="14,0,40,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFlowStepTemplate}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Command="{Binding CancelAddFlowStepCommand}"
                                Width="88"
                                Margin="0,0,12,0"
                                Style="{StaticResource Button.DialogSecondary}">
                            <TextBlock Text="取消" Style="{StaticResource Button.IconLabel}" Margin="0" />
                        </Button>
                        <Button Command="{Binding ConfirmAddFlowStepCommand}"
                                Width="104"
                                Style="{StaticResource Button.DialogPrimary}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.CheckCircleOutline}"
                                                         Style="{StaticResource Button.PackIcon.Current}" />
                                <TextBlock Text="{Binding FlowStepTemplateDialogConfirmText}"
                                           Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
