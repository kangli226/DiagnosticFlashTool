<Window x:Class="DiagnosticFlashTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:DiagnosticFlashTool.App.Views.Controls"
        xmlns:views="clr-namespace:DiagnosticFlashTool.App.Views"
        Title="BOOT刷写工具"
        Width="1440"
        Height="860"
        MinWidth="1180"
        MinHeight="760"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource Font.UI}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <DataTemplate x:Key="ShellNavigationPageTemplate">
            <RadioButton Content="{Binding Title}"
                         Tag="{Binding Icon}"
                         IsEnabled="{Binding CanNavigate}"
                         Checked="ShellNavigationPage_Checked"
                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                         Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                         ToolTip="{Binding Title}"
                         Margin="18,0,0,0"
                         Style="{StaticResource ShellNavRadioButtonStyle}" />
        </DataTemplate>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                             CornerRadius="{StaticResource CornerRadius.Window}"
                             GlassFrameThickness="0"
                             ResizeBorderThickness="6"
                             UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="26" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- 标题栏：应用标识 + 当前项目与 BOOT 配置 + 窗口控制 -->
        <Border Grid.Row="0"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Border Width="22"
                            Height="22"
                            Background="{StaticResource BrandNavigationBrush}"
                            CornerRadius="{StaticResource CornerRadius.Brand}">
                        <TextBlock Text="B"
                                   Foreground="{StaticResource InverseTextBrush}"
                                   FontSize="{StaticResource FontSize.Caption}"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="BOOT刷写工具"
                               Margin="8,0,0,0"
                               FontSize="{StaticResource FontSize.Assist}"
                               FontWeight="Medium"
                               Foreground="{StaticResource ChromeTextBrush}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        Height="14"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource ChromeDividerBrush}" />

                <TextBlock Grid.Column="2"
                           Text="{Binding StatusBarProjectText}"
                           ToolTip="{Binding StatusBarProjectText}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSize.Assist}"
                           Foreground="{StaticResource ChromeMutedTextBrush}" />

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button ToolTip="最小化"
                            Width="40"
                            Height="32"
                            Padding="0"
                            Margin="0"
                            Style="{StaticResource Button.OnChrome}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Minimize_Click">
                        <controls:FluentIcon Kind="WindowMinimize"
                                             Style="{StaticResource Button.Glyph}"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button ToolTip="最大化"
                            Width="40"
                            Height="32"
                            Padding="0"
                            Margin="0"
                            Style="{StaticResource Button.OnChrome}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Maximize_Click">
                        <controls:FluentIcon Kind="WindowMaximize"
                                             Style="{StaticResource Button.Glyph}"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button ToolTip="关闭"
                            Width="40"
                            Height="32"
                            Padding="0"
                            Margin="0"
                            Style="{StaticResource Button.OnChrome}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Close_Click">
                        <controls:FluentIcon Kind="Close"
                                             Style="{StaticResource Button.Glyph}"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 菜单栏：自绘下拉。Fluent Menu 的模板与 26px 紧凑行高冲突（内容不绘制），
             这里用 Button + ContextMenu 保持真实命令与键盘可达性。 -->
        <Border Grid.Row="1"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        Margin="4,0"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource Button.OnChrome}"
                        Height="24"
                        Padding="10,0"
                        Margin="0"
                        FontSize="{StaticResource FontSize.Assist}"
                        Click="MenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource ShellContextMenuStyle}"
                                     Placement="Bottom"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="重新加载配置" Command="{Binding LoadFlowCommand}" InputGestureText="Ctrl+R"
                                      Visibility="{Binding IsSystemAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <MenuItem Header="保存配置" Command="{Binding SaveFlowCommand}" InputGestureText="Ctrl+S"
                                      Visibility="{Binding IsSystemAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Separator />
                            <MenuItem Header="刷新项目列表" Command="{Binding RefreshProjectsCommand}" />
                            <Separator />
                            <MenuItem Header="退出" Click="Close_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                
                    <Button.Content>
                        <TextBlock Text="文件" Foreground="{StaticResource ChromeTextBrush}" />
                    </Button.Content>
                </Button>

                <Button Style="{StaticResource Button.OnChrome}"
                        Height="24"
                        Padding="10,0"
                        Margin="0"
                        FontSize="{StaticResource FontSize.Assist}"
                        Click="MenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource ShellContextMenuStyle}"
                                     Placement="Bottom"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="当前项目" IsEnabled="{Binding HasSelectedProject}">
                                <MenuItem Header="固件刷写" Tag="0" Click="NavigateProject_Click"
                                          IsEnabled="{Binding CanChangeWorkspace}" />
                                <MenuItem Header="刷写流程" Tag="7" Click="NavigateProject_Click"
                                          IsEnabled="{Binding CanChangeWorkspace}" />
                            </MenuItem>
                            <MenuItem Header="工具与设置">
                                <MenuItem Header="开发者选项" Tag="1" Click="Navigate_Click"
                                          Visibility="{Binding IsSystemAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <MenuItem Header="操作日志" Command="{Binding NavigateToSystemLogCommand}" />
                                <MenuItem Header="项目配置" Tag="3" Click="Navigate_Click"
                                          Visibility="{Binding IsSystemAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <MenuItem Header="流程配置" Tag="4" Click="Navigate_Click"
                                          Visibility="{Binding IsSystemAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <MenuItem Header="算法配置" Tag="5" Click="Navigate_Click"
                                          Visibility="{Binding IsSystemAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </MenuItem>
                            <MenuItem Header="系统设置" Tag="6" Click="Navigate_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                
                    <Button.Content>
                        <TextBlock Text="视图" Foreground="{StaticResource ChromeTextBrush}" />
                    </Button.Content>
                </Button>

                <Button Style="{StaticResource Button.OnChrome}"
                        Height="24"
                        Padding="10,0"
                        Margin="0"
                        FontSize="{StaticResource FontSize.Assist}"
                        Click="MenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource ShellContextMenuStyle}"
                                     Placement="Bottom"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="连接设备" Command="{Binding ToggleConnectionCommand}" />
                            <MenuItem Header="校验当前流程" Command="{Binding ValidateFlowCommand}" InputGestureText="F5"
                                      Visibility="{Binding IsSystemAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Separator />
                            <MenuItem Header="开始刷写" Command="{Binding StartFlashCommand}" />
                            <MenuItem Header="停止刷写" Command="{Binding CancelFlashCommand}" />
                            <Separator />
                            <MenuItem Header="清空日志" Command="{Binding ClearLogCommand}" />
                            <MenuItem Header="导出日志" Command="{Binding ExportLogCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                
                    <Button.Content>
                        <TextBlock Text="刷写" Foreground="{StaticResource ChromeTextBrush}" />
                    </Button.Content>
                </Button>

                <Button Style="{StaticResource Button.OnChrome}"
                        Height="24"
                        Padding="10,0"
                        Margin="0"
                        FontSize="{StaticResource FontSize.Assist}"
                        Click="MenuButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource ShellContextMenuStyle}"
                                     Placement="Bottom"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="帮助文档"
                                      IsEnabled="False"
                                      ToolTip="暂未提供帮助文档"
                                      ToolTipService.ShowOnDisabled="True" />
                            <Separator />
                            <MenuItem Header="打开日志目录" Command="{Binding OpenLogDirectoryCommand}"
                                      Visibility="{Binding IsSystemAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <MenuItem Header="打开配置目录" Command="{Binding OpenProjectConfigDirectoryCommand}"
                                      Visibility="{Binding IsSystemAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Separator />
                            <MenuItem Header="系统设置" Tag="6" Click="Navigate_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                
                    <Button.Content>
                        <TextBlock Text="帮助" Foreground="{StaticResource ChromeTextBrush}" />
                    </Button.Content>
                </Button>
            </StackPanel>
        </Border>

        <!-- 主体：左侧项目资源管理器 + 右侧内容区与输出面板 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource ChromeBrush}"
                    BorderBrush="{StaticResource ChromeBorderBrush}"
                    BorderThickness="0,0,1,0">
                <!--
                    侧栏上半部「工具与设置」与「刷写项目」组头固定，
                    下半部项目列表独占剩余高度并在其内部滚动，项目再多也不会挤走顶部导航。
                -->
                <Grid Margin="0,8,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <!-- 工具与设置分组的页面直接作为一级条目。 -->
                        <TextBlock Text="工具与设置" Style="{StaticResource ShellNavGroupTextStyle}" Margin="0,0,0,2" />
                        <ItemsControl ItemsSource="{Binding UdsNavigationItems}"
                                      ItemTemplate="{StaticResource ShellNavigationPageTemplate}" />
                    </StackPanel>

                    <!-- 项目名打开该项目的固件刷写页，二级条目随当前项目显示。 -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="刷写项目" Style="{StaticResource ShellNavGroupTextStyle}" Margin="0,0,0,2" />
                        <Button Command="{Binding NewProjectCommand}"
                                Visibility="{Binding IsSystemAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="26" Height="22" Padding="0" Margin="0,4,6,0"
                                Style="{StaticResource Button.OnChrome}" ToolTip="新增项目">
                            <controls:FluentIcon Kind="Plus" Style="{StaticResource Button.Glyph.Current}" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  Style="{StaticResource ShellProjectScrollHostStyle}">
                        <Grid VerticalAlignment="Top">
                            <ItemsControl ItemsSource="{Binding ProjectNavigationItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Button Command="{Binding OpenCommand}"
                                                    AutomationProperties.Name="{Binding Project.ProjectName}"
                                                    ToolTip="{Binding Project.ProjectName}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="14,0,12,0" Margin="0"
                                                    Style="{StaticResource Button.OnChrome}">
                                                <DockPanel>
                                                    <controls:FluentIcon DockPanel.Dock="Left" Kind="FolderOpenOutline"
                                                                         Style="{StaticResource Button.Glyph.Current}" />
                                                    <TextBlock Text="{Binding Project.ProjectName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="{StaticResource FontSize.Caption}"
                                                               Style="{StaticResource Button.IconLabel}" />
                                                </DockPanel>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding Pages}"
                                                          ItemTemplate="{StaticResource ShellNavigationPageTemplate}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="暂无项目，请联系管理员新增"
                                       Margin="18,8,12,8" TextWrapping="Wrap"
                                       Style="{StaticResource SettingAssistTextStyle}"
                                       Visibility="{Binding HasNoProjects, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <TabControl x:Name="MainTabs"
                        Grid.Column="1"
                        Style="{StaticResource ShellContentTabControlStyle}"
                        SelectedIndex="{Binding SelectedShellIndex, Mode=TwoWay}">
                <TabItem>
                    <views:ProjectFirmwareFlashView />
                </TabItem>
                <TabItem>
                    <views:DeveloperOptionsView />
                </TabItem>
                <TabItem>
                    <views:SystemLogView />
                </TabItem>
                <TabItem>
                    <views:ProjectConfigView />
                </TabItem>
                <TabItem>
                    <views:FlowConfigView />
                </TabItem>
                <TabItem>
                    <views:AlgorithmConfigView />
                </TabItem>
                <TabItem>
                    <views:SystemSettingsView />
                </TabItem>
                <TabItem>
                    <views:ProjectFlashFlowView />
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource ChromeBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusBarDeviceText}"
                           Margin="12,0,0,0"
                           Style="{StaticResource ShellStatusTextStyle}" />
                <Border Grid.Column="1" Width="1" Height="14" Margin="12,0" Background="{StaticResource ChromeDividerBrush}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding StatusBarProjectText}"
                           ToolTip="{Binding StatusBarProjectText}"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource ShellStatusCodeTextStyle}" />
                <Border Grid.Column="3" Width="1" Height="14" Margin="12,0" Background="{StaticResource ChromeDividerBrush}" />
                <TextBlock Grid.Column="4"
                           Text="{Binding StatusBarStateText}"
                           Style="{StaticResource ShellStatusTextStyle}" />
                <Border Grid.Column="5" Width="1" Height="14" Margin="12,0" Background="{StaticResource ChromeDividerBrush}" />
                <TextBlock Grid.Column="6"
                           Text="{Binding LatestLogText}"
                           ToolTip="{Binding LatestLogText}"
                           Margin="0,0,10,0"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource ShellStatusCodeTextStyle}" />
                <TextBlock Grid.Column="7"
                           Text="{Binding LogEntryCountText}"
                           Margin="0,0,12,0"
                           Style="{StaticResource ShellStatusCountTextStyle}" />
                <Button Grid.Column="8"
                        Command="{Binding NavigateToSystemLogCommand}"
                        Style="{StaticResource Button.OnChrome}"
                        Height="20"
                        Margin="0,0,8,0"
                        Padding="8,0"
                        ToolTip="打开操作日志">
                    <StackPanel Style="{StaticResource Button.InlineContent}">
                        <controls:FluentIcon Kind="ArrowRight" Style="{StaticResource Button.Glyph.Current}" />
                        <TextBlock Text="查看" Style="{StaticResource Button.IconLabel}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border x:Name="NewFlowProjectDialogOverlay"
                Grid.Row="0"
                Grid.RowSpan="3"
                Panel.ZIndex="1001"
                IsVisibleChanged="NewFlowProjectDialogOverlay_IsVisibleChanged">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource DialogOverlayStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNewFlowProjectDialogVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border x:Name="NewFlowProjectDialogPanel"
                    Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogPanelStyle}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="NewFlowProjectDialogTransform" />
                </Border.RenderTransform>
                <Grid KeyboardNavigation.TabNavigation="Cycle">
                    <Grid.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConfirmNewFlowProjectCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding CancelNewFlowProjectCommand}" />
                    </Grid.InputBindings>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" MinHeight="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="NewFlowProjectDialogHeader"
                          Grid.Row="0"
                          Background="Transparent"
                          Cursor="SizeAll"
                          MouseLeftButtonDown="NewFlowProjectDialogHeader_MouseLeftButtonDown"
                          MouseMove="NewFlowProjectDialogHeader_MouseMove"
                          MouseLeftButtonUp="NewFlowProjectDialogHeader_MouseLeftButtonUp">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:FluentIcon Grid.Column="0"
                                             Kind="FolderPlusOutline"
                                             Width="24"
                                             Height="24"
                                             FontSize="22"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="新建配置"
                                   Style="{StaticResource DialogTitleTextStyle}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="配置名称"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="NewFlowProjectNameTextBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Width="Auto"
                                 Margin="0"
                                 HorizontalAlignment="Stretch"
                                 Text="{Binding NewFlowProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SoftTextBoxStyle}" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="创建方式"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Orientation="Horizontal">
                            <RadioButton Content="基于已有配置创建"
                                         GroupName="FlowProjectCreationMode"
                                         Margin="0,0,24,0"
                                         VerticalAlignment="Center"
                                         IsEnabled="{Binding HasBootConfigTemplates}"
                                         IsChecked="{Binding CreateFlowProjectFromTemplate, Mode=TwoWay}" />
                            <RadioButton Content="空白创建"
                                         GroupName="FlowProjectCreationMode"
                                         VerticalAlignment="Center"
                                         IsChecked="{Binding CreateBlankFlowProject, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Style="{StaticResource FormLabelColumnStyle}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="已有 BOOT 配置"
                                   Style="{StaticResource FieldLabelStyle}" />
                        <Grid Grid.Row="0"
                              Grid.Column="1"
                              HorizontalAlignment="Stretch">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CreateFlowProjectFromTemplate}" Value="False">
                                            <Setter Property="Opacity" Value="0.56" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1"
                                                                         To="0.56"
                                                                         Duration="0:0:0.16"
                                                                         FillBehavior="Stop">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.56"
                                                                         To="1"
                                                                         Duration="0:0:0.16"
                                                                         FillBehavior="Stop">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ComboBox Width="Auto"
                                       HorizontalAlignment="Stretch"
                                       ItemsSource="{Binding BootConfigFiles}"
                                       SelectedItem="{Binding SelectedFlowProjectTemplate, Mode=TwoWay}"
                                       IsEnabled="{Binding CreateFlowProjectFromTemplate}"
                                       Style="{StaticResource StandardComboBoxStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}"
                                                   ToolTip="{Binding}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="5"
                               Text="{Binding NewFlowProjectValidationText}"
                               Margin="0,0,0,16"
                               Foreground="{StaticResource StatusErrorBrush}"
                               FontSize="{StaticResource FontSize.Body}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Command="{Binding CancelNewFlowProjectCommand}"
                                Width="88"
                                Margin="0,0,12,0"
                                Style="{StaticResource Button.Normal}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="Close"
                                                     Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="取消" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ConfirmNewFlowProjectCommand}"
                                Width="104"
                                Margin="0"
                                Style="{StaticResource Button.Normal}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="CheckCircleOutline"
                                                     Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="创建" Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="FlowStepTemplateDialogOverlay"
                Grid.Row="0"
                Grid.RowSpan="3"
                Panel.ZIndex="1000"
                IsVisibleChanged="FlowStepTemplateDialogOverlay_IsVisibleChanged">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource DialogOverlayStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAddFlowStepDialogVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Width="700"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogPanelStyle}">
                <Grid KeyboardNavigation.TabNavigation="Cycle">
                    <Grid.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConfirmAddFlowStepCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding CancelAddFlowStepCommand}" />
                    </Grid.InputBindings>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:FluentIcon Grid.Column="0"
                                             Kind="Plus"
                                             Width="24"
                                             Height="24"
                                             FontSize="22"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding FlowStepTemplateDialogTitle}"
                                       Style="{StaticResource DialogTitleTextStyle}" />
                            <TextBlock Text="{Binding FlowStepTemplateDialogDescription}"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource HintTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource SettingGroupPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="节点模板"
                                       Margin="0,0,0,12"
                                       Style="{StaticResource SectionHeaderTextStyle}" />
                            <Grid>
                                <ComboBox x:Name="FlowStepTemplateComboBox"
                                          Width="Auto"
                                          Height="44"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding FlowStepTemplates}"
                                          SelectedItem="{Binding SelectedFlowStepTemplate, Mode=TwoWay}"
                                          MaxDropDownHeight="360"
                                          Style="{StaticResource StandardComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}"
                                                       MaxWidth="590"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="请选择节点模板"
                                           Margin="14,0,40,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFlowStepTemplate}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Command="{Binding CancelAddFlowStepCommand}"
                                Width="88"
                                Margin="0,0,12,0"
                                Style="{StaticResource Button.Normal}">
                            <TextBlock Text="取消" Style="{StaticResource Button.IconLabel}" Margin="0" />
                        </Button>
                        <Button Command="{Binding ConfirmAddFlowStepCommand}"
                                Width="104"
                                Margin="0"
                                Style="{StaticResource Button.Normal}">
                            <StackPanel Style="{StaticResource Button.InlineContent}">
                                <controls:FluentIcon Kind="CheckCircleOutline"
                                                     Style="{StaticResource Button.Glyph.Current}" />
                                <TextBlock Text="{Binding FlowStepTemplateDialogConfirmText}"
                                           Style="{StaticResource Button.IconLabel}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
